<http://data.ashrae.org/standard223/1.0/data/test_system-004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_system-004> ;
  rdfs:label "test_system-004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex33:00001 a s223:Equipment,
        ex30:A ;
    rdfs:label "a" ;
    s223:connectedThrough ex33:00009 ;
    s223:connectedTo ex33:00005 ;
    s223:hasConnectionPoint ex33:00002 ;
    ex30:cOut ex33:00002 .

ex33:00002 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "a.cOut" ;
    s223:connectsThrough ex33:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex33:00001 .

ex33:00003 a s223:System,
        ex30:X ;
    rdfs:label "x" ;
    bob:hasSystemConnectionPoint ex33:00004 ;
    ex30:cOut ex33:00004 .

ex33:00004 a bob:OutletSystemConnectionPoint ;
    rdfs:label "x.cOut" ;
    bob:isSystemConnectionPointOf ex33:00003 ;
    bob:mapsTo ex33:00002 .

ex33:00005 a s223:Equipment,
        ex30:B ;
    rdfs:label "b" ;
    s223:connectedFrom ex33:00001 ;
    s223:connectedThrough ex33:00009 ;
    s223:hasConnectionPoint ex33:00006 ;
    ex30:cIn ex33:00006 .

ex33:00006 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "b.cIn" ;
    s223:connectsThrough ex33:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex33:00005 .

ex33:00007 a s223:System,
        ex30:Y ;
    rdfs:label "y" ;
    bob:hasSystemConnectionPoint ex33:00008 ;
    ex30:cIn ex33:00008 .

ex33:00008 a bob:InletSystemConnectionPoint ;
    rdfs:label "y.cIn" ;
    bob:isSystemConnectionPointOf ex33:00007 ;
    bob:mapsTo ex33:00006 .

ex33:00009 a s223:Connection ;
    s223:connectsAt ex33:00002,
        ex33:00006 ;
    s223:connectsFrom ex33:00001 ;
    s223:connectsTo ex33:00005 ;
    s223:hasMedium s223:Medium-Air .

