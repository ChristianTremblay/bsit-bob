[] a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 15.0 ;
    s223:unit unit:A .

[] a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 20.0 ;
    s223:unit unit:A .

ex:00001 a p223:ElectricalDistributionPanel,
        s223:Device ;
    rdfs:label "P-1" ;
    s223:hasConnectionPoint ex:00002,
        ex:00003,
        ex:00004 ;
    rdfs:comment "Electrical panel full of breakers. 120V-240VAC 60Hz" .

