bacnet:AnalogInputObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.AnalogInputObject" ;
    rdfs:subClassOf bacnet:Object ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:object-type ] .

bacnet:Device a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.Device" ;
    rdfs:subClassOf s223:Connectable,
        s223:Controller,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:deviceInstance ] .

bacnet:DeviceObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.DeviceObject" ;
    rdfs:subClassOf bacnet:Object ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:vendor-name ],
        [ a sh:PropertyShape ;
            sh:path bacnet:system-status ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-type ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:path bacnet:vendor-identifier ] .

bacnet:Object a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.Object" ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:description ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-name ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-identifier ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-type ] .

bacnet:description a rdf:Property .

bacnet:device-identifier a rdf:Property .

bacnet:deviceInstance a rdf:Property .

bacnet:object-identifier a rdf:Property .

bacnet:object-name a rdf:Property .

bacnet:object-type a rdf:Property .

bacnet:property-array-index a rdf:Property .

bacnet:property-identifier a rdf:Property .

bacnet:system-status a rdf:Property .

bacnet:vendor-identifier a rdf:Property .

bacnet:vendor-name a rdf:Property .

bob:VLAN a rdf:Property .

bob:airChangePerHour a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint,
        bob:hasZoneConnectionPoint .

bob:airInletSupply a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint,
        bob:hasZoneConnectionPoint .

bob:airOutletExhaust a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airTransfer a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

