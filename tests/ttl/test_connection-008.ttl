# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-008
# imports: http://data.ashrae.org/standard223/1.0/model/all
@prefix ex29: <urn:ex/test_system-007/> .
@prefix ex7: <urn:ex/test_connection-008/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal_to_standard223#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://data.ashrae.org/standard223/1.0/data/test_connection-008>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-008> ;
  rdfs:label "test_connection-008" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .
ex29:00001 a s223:Connection ;
    rdfs:label "Sun" ;
    s223:connectsAt ex29:00003 ;
    s223:connectsFrom ex29:00002 ;
    s223:hasMedium s223:Light-Visible .
ex29:00002 a p223:Light,
        s223:Connectable,
        s223:Container,
        s223:Device ;
    rdfs:label "WL" ;
    s223:connectedThrough ex29:00001 ;
    s223:hasConnectionPoint ex29:00003,
        ex29:00004 ;
    ex7:electricalInlet ex29:00004 ;
    ex7:lightOutlet ex29:00003 .
ex29:00003 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "WL.lightOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Light-Visible ;
    s223:isConnectionPointOf ex29:00002 .
ex29:00004 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "WL.electricalInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Electricity ;
    s223:isConnectionPointOf ex29:00002 .
