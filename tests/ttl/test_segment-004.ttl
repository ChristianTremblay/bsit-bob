@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_segment-004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_segment-004> ;
  rdfs:label "test_segment-004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Equipment ;
    rdfs:label "d1" ;
    s223:hasConnectionPoint ex32:00002 .

ex32:00002 a s223:InletConnectionPoint ;
    s223:isConnectionPointOf ex32:00001 ;
    s223:lnx ex32:00004 .

ex32:00003 a s223:Junction ;
    s223:lnx ex32:00004 .

ex32:00004 a s223:Segment ;
    s223:lnx ex32:00002,
        ex32:00003 .

