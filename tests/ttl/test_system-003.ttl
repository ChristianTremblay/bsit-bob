<http://data.ashrae.org/standard223/1.0/data/test_system-003>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_system-003> ;
  rdfs:label "test_system-003" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex27:00001 a s223:Connectable,
        s223:Equipment,
        ex23:A ;
    rdfs:label "a" ;
    s223:connectedThrough ex27:00009 ;
    s223:connectedTo ex27:00005 ;
    s223:hasConnectionPoint ex27:00002 ;
    ex23:cOut ex27:00002 .

ex27:00002 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "a.cOut" ;
    s223:connectsThrough ex27:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00003 a s223:System,
        ex23:X ;
    rdfs:label "x" ;
    bob:hasSystemConnectionPoint ex27:00004 ;
    ex23:cOut ex27:00004 .

ex27:00004 a bob:OutletSystemConnectionPoint,
        bob:SystemConnectionPoint ;
    rdfs:label "x.cOut" ;
    bob:isSystemConnectionPointOf ex27:00003 ;
    bob:mapsTo ex27:00002 .

ex27:00005 a s223:Connectable,
        s223:Equipment,
        ex23:B ;
    rdfs:label "b" ;
    s223:connectedFrom ex27:00001 ;
    s223:connectedThrough ex27:00009 ;
    s223:hasConnectionPoint ex27:00006 ;
    ex23:cIn ex27:00006 .

ex27:00006 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "b.cIn" ;
    s223:connectsThrough ex27:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex27:00005 .

ex27:00007 a s223:System,
        ex23:Y ;
    rdfs:label "y" ;
    bob:hasSystemConnectionPoint ex27:00008 ;
    ex23:cIn ex27:00008 .

ex27:00008 a bob:InletSystemConnectionPoint,
        bob:SystemConnectionPoint ;
    rdfs:label "y.cIn" ;
    bob:isSystemConnectionPointOf ex27:00007 ;
    bob:mapsTo ex27:00006 .

ex27:00009 a s223:Connection ;
    s223:connectsAt ex27:00002,
        ex27:00006 ;
    s223:connectsFrom ex27:00001 ;
    s223:connectsTo ex27:00005 ;
    s223:hasMedium s223:Medium-Air .

