<http://data.ashrae.org/standard223/1.0/data/test_connection-004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-004> ;
  rdfs:label "test_connection-004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex35:00001 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "d1" ;
    s223:cnx ex35:00002 ;
    s223:connectedThrough ex35:00005 ;
    s223:hasConnectionPoint ex35:00002 .

ex35:00002 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "d1.out" ;
    s223:cnx ex35:00001,
        ex35:00005 ;
    s223:connectsThrough ex35:00005 ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf ex35:00001 .

ex35:00003 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "d2" ;
    s223:cnx ex35:00004 ;
    s223:connectedThrough ex35:00005 ;
    s223:hasConnectionPoint ex35:00004 .

ex35:00004 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "d2.in" ;
    s223:cnx ex35:00003,
        ex35:00005 ;
    s223:connectsThrough ex35:00005 ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf ex35:00003 .

ex35:00005 a s223:Connection ;
    s223:cnx ex35:00002,
        ex35:00004 ;
    s223:connectsAt ex35:00002,
        ex35:00004 ;
    s223:connectsFrom ex35:00001 ;
    s223:connectsTo ex35:00003 ;
    s223:hasMedium s223:Fluid-Air .

