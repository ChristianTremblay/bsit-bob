@prefix ex: <urn:ex/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .


ex:00001 a s223:Device ;
    rdfs:label "d1" ;
    s223:hasConnectionPoint ex:00002 .

ex:00002 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "d1.out" ;
    s223:hasDirection s223:Direction-Outlet .

ex:00003 a s223:Device ;
    rdfs:label "d2" ;
    s223:hasConnectionPoint ex:00004 .

ex:00004 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "d2.in" ;
    s223:hasDirection s223:Direction-Inlet .

ex:00005 a s223:Connection .

