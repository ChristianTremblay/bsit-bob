ex27:00001 a s223:Connectable,
        s223:Equipment,
        s223:Fan ;
    rdfs:label "VA-1" ;
    s223:contains ex27:00014 ;
    s223:hasConnectionPoint ex27:00002,
        ex27:00003,
        ex27:00004 ;
    s223:hasProperty ex27:00005,
        ex27:00006,
        ex27:00007,
        ex27:00008,
        ex27:00009,
        ex27:00010,
        ex27:00011,
        ex27:00012,
        ex27:00013 ;
    bob:airInlet ex27:00002 ;
    bob:airOutlet ex27:00003 ;
    rdfs:comment "Supply Fan" .

ex27:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-1.airInlet" ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00003 a s223:ConnectionPoint,
