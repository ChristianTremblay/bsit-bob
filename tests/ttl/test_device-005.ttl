<http://data.ashrae.org/standard223/1.0/data/test_device-005>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_device-005> ;
  rdfs:label "test_device-005" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex31:00001 a s223:Connectable,
        s223:Equipment,
        s223:Fan ;
    rdfs:label "VA-1" ;
    s223:cnx ex31:00002,
        ex31:00003,
        ex31:00004 ;
    s223:contains ex31:00005 ;
    s223:hasConnectionPoint ex31:00002,
        ex31:00003,
        ex31:00004 ;
    bob:airInlet ex31:00002 ;
    bob:airOutlet ex31:00003 ;
    rdfs:comment "Supply Fan" .

ex31:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-1.airInlet" ;
    s223:cnx ex31:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex31:00001 .

ex31:00003 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-1.airOutlet" ;
    s223:cnx ex31:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex31:00001 .

ex31:00004 a s223:ConnectionPoint,
        s223:ElectricalConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "VA-1.electricalInlet" ;
    s223:cnx ex31:00001 ;
    s223:hasMedium s223:Medium-Electricity ;
    s223:isConnectionPointOf ex31:00001 .

ex31:00005 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "VA1-VFD" ;
    s223:isContainedIn ex31:00001 ;
    rdfs:comment "VFD for VA-1" .

ex31:00006 a s223:Connectable,
        s223:Equipment,
        s223:Fan ;
    rdfs:label "VA-2" ;
    s223:cnx ex31:00007,
        ex31:00008,
        ex31:00009 ;
    s223:hasConnectionPoint ex31:00007,
        ex31:00008,
        ex31:00009 ;
    bob:airInlet ex31:00007 ;
    bob:airOutlet ex31:00008 .

ex31:00007 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-2.airInlet" ;
    s223:cnx ex31:00006 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex31:00006 .

ex31:00008 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-2.airOutlet" ;
    s223:cnx ex31:00006 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex31:00006 .

ex31:00009 a s223:ConnectionPoint,
        s223:ElectricalConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "VA-2.electricalInlet" ;
    s223:cnx ex31:00006 ;
    s223:hasMedium s223:Medium-Electricity ;
    s223:isConnectionPointOf ex31:00006 .

