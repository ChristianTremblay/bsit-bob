ex31:00001 a s223:Device,
        s223:Fan ;
    rdfs:label "VA-1" ;
    s223:contains ex31:00014 ;
    s223:hasConnectionPoint ex31:00002,
        ex31:00003,
        ex31:00004 ;
    s223:hasProperty ex31:00005,
        ex31:00006,
        ex31:00007,
        ex31:00008,
        ex31:00009,
        ex31:00010,
        ex31:00011,
        ex31:00012,
        ex31:00013 ;
    bob:airInlet ex31:00002 ;
    bob:airOutlet ex31:00003 ;
    rdfs:comment "Supply Fan" .

ex31:00002 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-1.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex31:00001 .

ex31:00003 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VA-1.airOutlet" ;
