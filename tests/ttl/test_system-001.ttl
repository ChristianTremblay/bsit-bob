<http://data.ashrae.org/standard223/1.0/data/test_system-001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_system-001> ;
  rdfs:label "test_system-001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Equipment,
        ex26:A ;
    rdfs:label "a" ;
    s223:connectedThrough ex32:00009 ;
    s223:connectedTo ex32:00005 ;
    s223:hasConnectionPoint ex32:00002 ;
    ex26:cOut ex32:00002 .

ex32:00002 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "a.cOut" ;
    s223:connectsThrough ex32:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00003 a s223:System,
        ex26:X ;
    rdfs:label "x" ;
    bob:hasSystemConnectionPoint ex32:00004 ;
    ex26:cOut ex32:00004 .

ex32:00004 a bob:OutletSystemConnectionPoint ;
    rdfs:label "x.cOut" ;
    bob:isSystemConnectionPointOf ex32:00003 ;
    bob:mapsTo ex32:00002 .

ex32:00005 a s223:Equipment,
        ex26:B ;
    rdfs:label "b" ;
    s223:connectedFrom ex32:00001 ;
    s223:connectedThrough ex32:00009 ;
    s223:hasConnectionPoint ex32:00006 ;
    ex26:cIn ex32:00006 .

ex32:00006 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "b.cIn" ;
    s223:connectsThrough ex32:00009 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex32:00005 .

ex32:00007 a s223:System,
        ex26:Y ;
    rdfs:label "y" ;
    bob:hasSystemConnectionPoint ex32:00008 ;
    ex26:cIn ex32:00008 .

ex32:00008 a bob:InletSystemConnectionPoint ;
    rdfs:label "y.cIn" ;
    bob:isSystemConnectionPointOf ex32:00007 ;
    bob:mapsTo ex32:00006 .

ex32:00009 a s223:Connection ;
    s223:connectsAt ex32:00002,
        ex32:00006 ;
    s223:connectsFrom ex32:00001 ;
    s223:connectsTo ex32:00005 ;
    s223:hasMedium s223:Medium-Air .

