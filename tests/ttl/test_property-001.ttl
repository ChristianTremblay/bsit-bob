ARGS :  (4.5,)
@prefix ex: <urn:ex/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


ex:00001 s223:hasValue 1 .

ex:00002 a s223:ActuatableProperty ;
    s223:hasValue 2 .

ex:00003 a s223:ObservableProperty ;
    s223:hasValue "green" .

ex:00004 a s223:QuantifiableProperty ;
    s223:hasValue 4.5 .

ex:00005 a s223:ObservableProperty ;
    rdfs:label "color" ;
    s223:hasValue "green" .

ex:00006 a ex:TestProperty1 ;
    s223:hasValue 7 .

ex:00007 a ex:TestProperty2 ;
    rdfs:label "test 2" ;
    s223:hasValue 8 .

