# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-001
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex27: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_connection-001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-001> ;
  rdfs:label "test_connection-001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex27:00001 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "d1" ;
    s223:connectedThrough ex27:00003 ;
    s223:hasConnectionPoint ex27:00002 .

ex27:00002 a s223:InletConnectionPoint ;
    s223:connectsThrough ex27:00003 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00003 a s223:Connection ;
    s223:connectsAt ex27:00002 ;
    s223:connectsTo ex27:00001 ;
    s223:hasMedium s223:Medium-Air .

