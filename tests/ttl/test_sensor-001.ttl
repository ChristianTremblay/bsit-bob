# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_sensor-001
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex31: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_sensor-001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_sensor-001> ;
  rdfs:label "test_sensor-001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex31:00001 a s223:Connectable,
        s223:Equipment,
        s223:Sensor,
        s223:TemperatureSensor ;
    rdfs:label "ats1" ;
    s223:observes ex31:00002 ;
    rdfs:comment "Supply Air Temperature Sensor" .

ex31:00002 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Temperature ;
    rdfs:label "ats1.Temperature" ;
    s223:ofMedium s223:Medium-Air ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

ex31:00003 a s223:Connectable,
        s223:Equipment,
        s223:Sensor,
        s223:TemperatureSensor,
        bob:AirTemperatureSensor ;
    rdfs:label "ats2" ;
    s223:observes ex31:00004 ;
    rdfs:comment "Supply Air Temperature Sensor" .

ex31:00004 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Temperature ;
    rdfs:label "ats2.Temperature" ;
    s223:ofMedium s223:Medium-Air ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

ex31:00005 a s223:Connectable,
        s223:Equipment,
        s223:HumiditySensor,
        s223:Sensor ;
    rdfs:label "ahs1" ;
    s223:observes ex31:00006 ;
    rdfs:comment "Zone Humidity Sensor with a value of 20" .

ex31:00006 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:RelativeHumidity ;
    rdfs:label "ahs1.Humidity" ;
    s223:hasValue 20.0 ;
    s223:ofMedium s223:Medium-Air ;
    qudt:hasQuantityKind quantitykind:RelativeHumidity ;
    qudt:hasUnit unit:PERCENT_RH .

