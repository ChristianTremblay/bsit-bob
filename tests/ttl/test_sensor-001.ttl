        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 20.0 ;
    s223:unit unit:A .
ex20:00003 a s223:Device,
        s223:Sensor,
        s223:TemperatureSensor ;
    rdfs:label "ats1" ;
    s223:hasProperty ex20:00004 ;
    s223:measuresSubstance s223:Medium-Air ;
