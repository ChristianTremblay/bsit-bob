# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_system-005
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex32: <urn:ex/test_system-005/> .
@prefix ex34: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_system-005>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_system-005> ;
  rdfs:label "test_system-005" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex34:00001 a s223:Connectable,
        s223:Equipment,
        ex32:A ;
    rdfs:label "a" ;
    s223:cnx ex34:00002 ;
    s223:hasConnectionPoint ex34:00002 ;
    ex32:cOut ex34:00002 .

ex34:00002 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "a.cOut" ;
    s223:cnx ex34:00001 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex34:00001 .

ex34:00003 a s223:System,
        ex32:X ;
    rdfs:label "x" ;
    bob:hasSystemConnectionPoint ex34:00004 ;
    ex32:cOut ex34:00004 .

ex34:00004 a bob:OutletSystemConnectionPoint,
        bob:SystemConnectionPoint ;
    rdfs:label "x.cOut" ;
    bob:isSystemConnectionPointOf ex34:00003 ;
    bob:mapsTo ex34:00002 .

ex34:00005 a s223:Connectable,
        s223:Equipment,
        ex32:B ;
    rdfs:label "b" ;
    s223:cnx ex34:00006 ;
    s223:connectedThrough ex34:00009 ;
    s223:hasConnectionPoint ex34:00006 ;
    ex32:cIn ex34:00006 .

ex34:00006 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "b.cIn" ;
    s223:cnx ex34:00005,
        ex34:00009 ;
    s223:connectsThrough ex34:00009 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex34:00005 .

ex34:00007 a s223:System,
        ex32:Y ;
    rdfs:label "y" ;
    bob:hasSystemConnectionPoint ex34:00008 ;
    ex32:cIn ex34:00008 .

ex34:00008 a bob:InletSystemConnectionPoint,
        bob:SystemConnectionPoint ;
    rdfs:label "y.cIn" ;
    bob:isSystemConnectionPointOf ex34:00007 ;
    bob:mapsTo ex34:00006 .

ex34:00009 a s223:Connection ;
    s223:cnx ex34:00006 ;
    s223:connectsAt ex34:00006 ;
    s223:connectsTo ex34:00005 ;
    s223:hasMedium p223:Fluid-Air .

