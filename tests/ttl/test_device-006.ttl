# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_device-006
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex32: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_device-006>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_device-006> ;
  rdfs:label "test_device-006" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Equipment,
        s223:VFD ;
    rdfs:label "MyVFD" ;
    s223:hasConnectionPoint ex32:00002,
        ex32:00003,
        ex32:00004 ;
    s223:hasProperty ex32:00005,
        ex32:00006,
        ex32:00007,
        ex32:00008,
        ex32:00009,
        ex32:00010,
        ex32:00011,
        ex32:00012,
        ex32:00013 ;
    rdfs:comment "A VFD for a Big Fan" .

ex32:00002 a s223:InletConnectionPoint,
        bob:Electricity_575V_60HzConnectionPoint ;
    rdfs:label "MyVFD.electricalInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Electricity-575V-60Hz ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00003 a s223:OutletConnectionPoint,
        bob:Electricity_575V_60HzConnectionPoint ;
    rdfs:label "MyVFD.electricalOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-575V-60Hz ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00004 a s223:BidirectionalConnectionPoint,
        bob:EthernetConnectionPoint ;
    rdfs:label "MyVFD.ethernet_port" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium p223:Electricity-Ethernet ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00005 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Amps ;
    rdfs:label "amps" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent ;
    qudt:unit unit:A .

ex32:00006 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:HP ;
    rdfs:label "hp" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:unit unit:HP .

ex32:00007 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower,
        bob:ElectricPowerkW ;
    rdfs:label "kW" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricPower ;
    qudt:unit unit:KiloW .

ex32:00008 a s223:ActuatableProperty,
        s223:Property,
        s223:QuantifiableActuatableProperty,
        s223:QuantifiableProperty,
        bob:PercentCommand ;
    rdfs:label "speed_reference" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:unit unit:PERCENT .

ex32:00009 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:RPM ;
    rdfs:label "rpm" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:AngularVelocity ;
    qudt:unit unit:REV-PER-MIN .

ex32:00010 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Temperature ;
    rdfs:label "motor_temp" ;
    s223:isPropertyOf ex32:00001 ;
    qudt:hasQuantityKind quantitykind:Temperature .

ex32:00011 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "drive_running" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:isPropertyOf ex32:00001 .

ex32:00012 a s223:ActuatableProperty,
        s223:EnumerableProperty,
        s223:EnumeratedActuatableProperty,
        s223:Property ;
    rdfs:label "run_command" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:isPropertyOf ex32:00001 .

ex32:00013 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "alarm_status" ;
    s223:hasEnumerationKind p223:EnumerationKind-NormalAlarm ;
    s223:isPropertyOf ex32:00001 .

