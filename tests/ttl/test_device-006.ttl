ex33:00001 a s223:Controller,
        s223:Equipment,
        s223:VFD ;
    rdfs:label "MyVFD" ;
    s223:contains ex33:00018,
        ex33:00021,
        ex33:00023,
        ex33:00025,
        ex33:00027 ;
    s223:hasConnectionPoint ex33:00002,
        ex33:00003,
        ex33:00004,
        ex33:00005,
        ex33:00006,
        ex33:00007,
        ex33:00008 ;
    s223:hasProperty ex33:00009,
        ex33:00010,
        ex33:00011,
        ex33:00012,
        ex33:00013,
        ex33:00014,
        ex33:00015,
        ex33:00016,
        ex33:00017 ;
    bob:amps ex33:00022 ;
    bob:volts ex33:00024 ;
