ex27:00001 a s223:Connectable,
        s223:Controller,
        s223:Equipment,
        s223:VFD ;
    rdfs:label "MyVFD" ;
    s223:contains ex27:00021,
        ex27:00023,
        ex27:00025 ;
    s223:hasConnectionPoint ex27:00002,
        ex27:00003,
        ex27:00004,
        ex27:00005,
        ex27:00006,
        ex27:00007,
        ex27:00008 ;
    s223:hasProperty ex27:00009,
        ex27:00010,
        ex27:00011,
        ex27:00012,
        ex27:00013,
        ex27:00014,
        ex27:00015,
        ex27:00016,
        ex27:00017 ;
    bob:amps ex27:00022 ;
    bob:contains ex27:00018 ;
    bob:volts ex27:00024 ;
    rdfs:comment "A VFD for a Big Fan" .

ex27:00002 a s223:Electricity_600VLL_3Ph_60HzConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "MyVFD.electricalInlet" ;
    s223:hasMedium s223:AC-600VLL-3Ph-60Hz ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00003 a s223:Electricity_600VLL_3Ph_60HzConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "MyVFD.electricalOutlet" ;
    s223:hasMedium s223:AC-600VLL-3Ph-60Hz ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00004 a s223:BidirectionalConnectionPoint,
        bob:EthernetConnectionPoint ;
    rdfs:label "MyVFD.ethernet_port" ;
    s223:hasMedium s223:Communication-Ethernet ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00005 a s223:BidirectionalConnectionPoint,
        bob:RS485ConnectionPoint ;
    rdfs:label "MyVFD.mstp_port" ;
    s223:hasMedium s223:Communication-EIA-485 ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00006 a p223:AnalogInput,
        s223:InletConnectionPoint,
        bob:ModulationSignalConnectionPoint ;
    rdfs:label "MyVFD.speedrefInlet" ;
    s223:hasMedium s223:Signal-Modulated ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00007 a p223:BinaryOutput,
        s223:OutletConnectionPoint,
        bob:OnOffSignalConnectionPoint ;
    rdfs:label "MyVFD.drive_running_dry_contact" ;
    s223:hasMedium p223:Signal-OnOffSignal ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00008 a p223:BinaryOutput,
        s223:OutletConnectionPoint,
        bob:OnOffSignalConnectionPoint ;
    rdfs:label "MyVFD.alarm_dry_contact" ;
    s223:hasMedium p223:Signal-OnOffSignal ;
    s223:isConnectionPointOf ex27:00001 .

ex27:00009 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:HP ;
    rdfs:label "hp" ;
    s223:isPropertyOf ex27:00001 ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:hasUnit unit:HP .

ex27:00010 a s223:ObservableProperty,
