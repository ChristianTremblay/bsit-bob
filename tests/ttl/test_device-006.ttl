ex33:00002 a s223:Electricity_600V_3Ph_60HzConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "MyVFD.electricalInlet" ;
    s223:hasMedium s223:AC-600V-3Ph-60Hz ;
    s223:isConnectionPointOf ex33:00001 .

ex33:00003 a s223:Electricity_600V_3Ph_60HzConnectionPoint,
        s223:OutletConnectionPoint ;
