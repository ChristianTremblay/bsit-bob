ex27:00019 a p223:ProducerInput ;
    rdfs:label "motor_temp_effect.cause_input" ;
    s223:uses ex27:00013 .

ex27:00020 a p223:ProducerOutput ;
    rdfs:label "motor_temp_effect.effect_output" ;
