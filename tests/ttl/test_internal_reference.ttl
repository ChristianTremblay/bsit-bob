# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_internal_reference
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/test_internal_reference/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_internal_reference>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_internal_reference> ;
  rdfs:label "test_internal_reference" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Temperature ;
    rdfs:label "fake temp" ;
    s223:hasExternalReference ex1:00003 ;
    s223:hasInternalReference ex1:00002 ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

ex1:00002 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Temperature ;
    rdfs:label "another fake temp" ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

ex1:00003 a s223:BACnetExternalReference,
        s223:ExternalReference ;
    rdfs:label "ref1" ;
    bacnet:device-identifier "device,12345" ;
    bacnet:object-identifier "analog-value,1" ;
    bacnet:property-identifier bacnet:PropertyIdentifier.present-value .

