@prefix ex: <urn:ex/test_device-003/> .
@prefix p223: <http://data.ashrae.org/proposal_to_standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .


ex:00001 a p223:CoarseParticulateSensor,
        p223:ParticulateSensor,
        s223:Device,
        s223:Sensor ;
    rdfs:label "coarse_sensor" ;
    p223:measuresMedium s223:Medium-Air ;
    p223:measuresSubstance p223:Particulate-PM10.0 ;
    p223:observesProperty ex:00002 ;
    rdfs:comment "Coarse Particulate Sensor" .

ex:00002 a p223:MeasuredProperty,
        p223:ParticulateCount,
        p223:QuantifiableMeasuredProperty,
        s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "coarse_sensor.ParticulateCount" ;
    p223:hasQuantityKind quantitykind:NumberDensity ;
    p223:measuresSubstance p223:Particulate-PM10.0 ;
    p223:unit unit:NUM-PER-M3 ;
    s223:hasExternalReference ex:00003 .

ex:00003 a s223:ExternalReference ;
    rdfs:label "coarse_sensor.ParticulateCount.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-value,1/present-value" .

ex:00004 a p223:FineParticulateSensor,
        p223:ParticulateSensor,
        s223:Device,
        s223:Sensor ;
    rdfs:label "fine_sensor" ;
    p223:measuresMedium s223:Medium-Air ;
    p223:measuresSubstance p223:Particulate-PM2.5 ;
    p223:observesProperty ex:00005 ;
    rdfs:comment "Fine Particulate Sensor" .

ex:00005 a p223:MeasuredProperty,
        p223:ParticulateCount,
        p223:QuantifiableMeasuredProperty,
        s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "fine_sensor.ParticulateCount" ;
    p223:hasQuantityKind quantitykind:NumberDensity ;
    p223:measuresSubstance p223:Particulate-PM2.5 ;
    p223:unit unit:NUM-PER-M3 ;
    s223:hasExternalReference ex:00006 .

ex:00006 a s223:ExternalReference ;
    rdfs:label "fine_sensor.ParticulateCount.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-input,2/present-value" .

ex:00007 a p223:ParticulateSensor,
        p223:UltraFineParticulateSensor,
        s223:Device,
        s223:Sensor ;
    rdfs:label "ultrafine_sensor" ;
    p223:measuresMedium s223:Medium-Air ;
    p223:measuresSubstance p223:Particulate-PM1.0 ;
    p223:observesProperty ex:00008 ;
    rdfs:comment "Ultra Fine Particulate Sensor" .

ex:00008 a p223:MeasuredProperty,
        p223:ParticulateCount,
        p223:QuantifiableMeasuredProperty,
        s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "ultrafine_sensor.ParticulateCount" ;
    p223:hasQuantityKind quantitykind:NumberDensity ;
    p223:measuresSubstance p223:Particulate-PM1.0 ;
    p223:unit unit:NUM-PER-M3 ;
    s223:hasExternalReference ex:00009 .

ex:00009 a s223:ExternalReference ;
    rdfs:label "ultrafine_sensor.ParticulateCount.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-input,3/present-value" .

ex:00010 a p223:ParticleCounter,
        s223:Device ;
    rdfs:label "PM-1" ;
    p223:airInlet ex:00011 ;
    p223:airOutlet ex:00012 ;
    s223:contains ex:00001,
        ex:00004,
        ex:00007 ;
    s223:hasConnectionPoint ex:00011,
        ex:00012 ;
    rdfs:comment "Particulate Measurement Station AKA particle counter" .

ex:00011 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "PM-1.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air .

ex:00012 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "PM-1.airOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air .

