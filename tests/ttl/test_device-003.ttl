    s223:hasRef "bacnet://1/analog-input,3/present-value" .
ex29:00010 a p223:ParticleCounter,
        s223:Device ;
    rdfs:label "PM-1" ;
    p223:airInlet ex29:00011 ;
    p223:airOutlet ex29:00012 ;
    s223:hasConnectionPoint ex29:00011,
