# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_device-003
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex33: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_device-003>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_device-003> ;
  rdfs:label "test_device-003" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex33:00001 a p223:ParticleCounter,
        s223:Equipment ;
    rdfs:label "PM-1" ;
    p223:airInlet ex33:00002 ;
    p223:airOutlet ex33:00003 ;
    s223:contains ex33:00004,
        ex33:00007,
        ex33:00010 ;
    s223:hasConnectionPoint ex33:00002,
        ex33:00003 ;
    rdfs:comment "Particulate Measurement Station AKA particle counter" .

ex33:00002 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "PM-1.airInlet" ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex33:00001 .

ex33:00003 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "PM-1.airOutlet" ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex33:00001 .

ex33:00004 a s223:Equipment,
        s223:Sensor ;
    rdfs:label "coarse_sensor" ;
    s223:isContainedIn ex33:00001 ;
    s223:observes ex33:00005 ;
    rdfs:comment "Coarse Particulate Sensor" .

ex33:00005 a p223:ParticulateCount,
        s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "coarse_sensor.ParticulateCount" ;
    s223:ofMedium s223:Medium-Air ;
    s223:ofSubstance s223:Particulate-PM10.0 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:hasUnit unit:NUM-PER-M3 ;
    ref:hasExternalReference ex33:00006 .

ex33:00006 a s223:ExternalReference ;
    rdfs:label "coarse_sensor.ParticulateCount.ExternalReference" ;
    rdfs:comment "bacnet://1/analog-value,1/present-value" .

ex33:00007 a s223:Equipment,
        s223:Sensor ;
    rdfs:label "fine_sensor" ;
    s223:isContainedIn ex33:00001 ;
    s223:observes ex33:00008 ;
    rdfs:comment "Fine Particulate Sensor" .

ex33:00008 a p223:ParticulateCount,
        s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "fine_sensor.ParticulateCount" ;
    s223:ofMedium s223:Medium-Air ;
    s223:ofSubstance s223:Particulate-PM2.5 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:hasUnit unit:NUM-PER-M3 ;
    ref:hasExternalReference ex33:00009 .

ex33:00009 a s223:ExternalReference ;
    rdfs:label "fine_sensor.ParticulateCount.ExternalReference" ;
    rdfs:comment "bacnet://1/analog-input,2/present-value" .

ex33:00010 a s223:Equipment,
        s223:Sensor ;
    rdfs:label "ultrafine_sensor" ;
    s223:isContainedIn ex33:00001 ;
    s223:observes ex33:00011 ;
    rdfs:comment "Ultra Fine Particulate Sensor" .

ex33:00011 a p223:ParticulateCount,
        s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "ultrafine_sensor.ParticulateCount" ;
    s223:ofMedium s223:Medium-Air ;
    s223:ofSubstance s223:Particulate-PM1.0 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:hasUnit unit:NUM-PER-M3 ;
    ref:hasExternalReference ex33:00012 .

ex33:00012 a s223:ExternalReference ;
    rdfs:label "ultrafine_sensor.ParticulateCount.ExternalReference" ;
    rdfs:comment "bacnet://1/analog-input,3/present-value" .

