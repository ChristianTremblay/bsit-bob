    qudt:hasQuantityKind quantitykind:ForcePerArea ;
    qudt:hasUnit unit:PA .

ex27:00025 a s223:Connectable,
        s223:Equipment,
        s223:Sensor ;
    rdfs:label "lowPort" ;
    s223:hasObservationLocation ex27:00009 ;
    s223:isContainedIn ex27:00021 ;
