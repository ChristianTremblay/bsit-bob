ex27:00017 a s223:PhysicalSpace,
        rec:Building ;
    rdfs:label "Clients's place" ;
    s223:contains ex27:00018,
        ex27:00019,
        ex27:00020 .

ex27:00018 a s223:PhysicalSpace,
        rec:Room ;
    rdfs:label "Clean Room #1" ;
    s223:encloses ex27:00001 ;
    s223:isContainedIn ex27:00017 .

ex27:00019 a s223:PhysicalSpace,
        rec:Room ;
    rdfs:label "SAS leading to Clean Room #1" ;
    s223:encloses ex27:00009 ;
    s223:isContainedIn ex27:00017 .

ex27:00020 a s223:PhysicalSpace,
        rec:MechanicalRoom,
        rec:Room ;
    rdfs:label "Mechanical room for Clean Room #1" ;
    s223:isContainedIn ex27:00017 .

ex27:00021 a s223:Connectable,
        s223:DifferentialSensor,
        s223:Equipment,
        s223:Sensor ;
    rdfs:label "TPD-01" ;
    s223:contains ex27:00023,
        ex27:00025 ;
    s223:hasPhysicalLocation ex27:00020 ;
    s223:hasProperty ex27:00022 ;
    s223:observes ex27:00022 ;
    bob:contains ex27:00027 ;
    bob:differential_static_pressure ex27:00022 ;
    rdfs:comment "Static Pressure between Clean Room (+) and SAS (-)" .

ex27:00022 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:DifferentialStaticPressure ;
    rdfs:label "TPD-01.DifferentialStaticPressure" ;
    s223:isPropertyOf ex27:00021 ;
    s223:ofMedium s223:Medium-Air ;
    qudt:hasQuantityKind quantitykind:ForcePerArea ;
    qudt:hasUnit unit:PA .

ex27:00023 a s223:Connectable,
        s223:Equipment,
        s223:Sensor ;
    rdfs:label "highPort" ;
    s223:hasObservationLocation ex27:00001 ;
    s223:isContainedIn ex27:00021 ;
    s223:observes ex27:00024 .

ex27:00024 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
