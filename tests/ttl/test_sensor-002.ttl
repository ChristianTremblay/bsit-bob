    s223:ofMedium s223:Medium-Air ;
    qudt:hasQuantityKind quantitykind:ForcePerArea ;
    qudt:hasUnit unit:PA .

ex27:00027 a p223:Producer,
        bob:Differential ;
    rdfs:label "diff_causality" ;
    s223:hasInput ex27:00028,
        ex27:00029 ;
    s223:hasOutput ex27:00030 ;
    bob:differential_output ex27:00030 ;
    bob:high_input ex27:00028 ;
    bob:isContainedIn ex27:00021 ;
    bob:low_input ex27:00029 ;
    rdfs:comment "Will output High minus Low" .

ex27:00028 a p223:ProducerInput ;
    rdfs:label "diff_causality.high_input" ;
    s223:uses ex27:00024 .

ex27:00029 a p223:ProducerInput ;
    rdfs:label "diff_causality.low_input" ;
    s223:uses ex27:00026 .

ex27:00030 a p223:ProducerOutput ;
    rdfs:label "diff_causality.differential_output" ;
    s223:produces ex27:00022 .

