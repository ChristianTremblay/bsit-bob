    s223:hasConnectionPoint ex27:00002,
        ex27:00003,
        ex27:00004,
        ex27:00005,
        ex27:00006,
        ex27:00007,
        ex27:00008 ;
    s223:hasDomain s223:Domain-HVAC ;
    s223:isEnclosedIn ex27:00018 ;
    bob:airTransfer ex27:00004 ;
    bob:doors ex27:00005 ;
    bob:ductAirInlet ex27:00002 ;
    bob:ductAirOutlet ex27:00003 ;
    bob:radiantCooling ex27:00008 ;
    bob:radiantHeating ex27:00007 ;
    bob:windows ex27:00006 .

ex27:00002 a s223:InletConnectionPoint,
