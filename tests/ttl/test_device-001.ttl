@prefix ex32: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_device-001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_device-001> ;
  rdfs:label "test_device-001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Device ;
    rdfs:label "d1" .

ex32:00002 a s223:Device,
        ex10:TestDevice2 ;
    rdfs:label "d2" .

ex32:00003 a s223:Device,
        ex10:TestDevice3 ;
    rdfs:label "d3" ;
    s223:hasProperty ex32:00004 ;
    ex10:prop ex32:00004 .

ex32:00004 a s223:Property,
        ex10:TestProperty ;
    s223:hasValue 1 ;
    s223:isPropertyOf ex32:00003 .

