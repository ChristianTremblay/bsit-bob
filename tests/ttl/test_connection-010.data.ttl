# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-010
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex36: <urn:ex/test_system-008/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_connection-010>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-010> ;
  rdfs:label "test_connection-010" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex36:00001 a s223:Connectable,
        s223:Equipment,
        s223:Pump ;
    rdfs:label "WaterPump" ;
    s223:cnx ex36:00002,
        ex36:00003,
        ex36:00004 ;
    s223:connected ex36:00011 ;
    s223:connectedThrough ex36:00014 ;
    s223:connectedTo ex36:00011 ;
    s223:hasConnectionPoint ex36:00002,
        ex36:00003,
        ex36:00004 ;
    s223:hasProperty ex36:00005,
        ex36:00006,
        ex36:00007,
        ex36:00008,
        ex36:00009,
        ex36:00010 ;
    bob:waterInlet ex36:00002 ;
    bob:waterOutlet ex36:00003 .

ex36:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:WaterConnectionPoint ;
    rdfs:label "WaterPump.waterInlet" ;
    s223:cnx ex36:00001 ;
    s223:hasMedium p223:Fluid-Water ;
    s223:isConnectionPointOf ex36:00001 .

ex36:00003 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:WaterConnectionPoint ;
    rdfs:label "WaterPump.waterOutlet" ;
    s223:cnx ex36:00001,
        ex36:00014 ;
    s223:connectsThrough ex36:00014 ;
    s223:hasMedium p223:Fluid-Water ;
    s223:isConnectionPointOf ex36:00001 .

ex36:00004 a s223:ConnectionPoint,
        s223:Electricity_600VLL_3Ph_60HzConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "WaterPump.electricalInlet" ;
    s223:cnx ex36:00001 ;
    s223:hasMedium s223:AC-600VLL-3Ph-60Hz ;
    s223:isConnectionPointOf ex36:00001 .

ex36:00005 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Pressure ;
    rdfs:label "head_pressure" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PSI .

ex36:00006 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Amps ;
    rdfs:label "amps" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent ;
    qudt:hasUnit unit:A .

ex36:00007 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:RPM ;
    rdfs:label "rpm" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:AngularVelocity ;
    qudt:hasUnit unit:REV-PER-MIN .

ex36:00008 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:HP ;
    rdfs:label "hp" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:hasUnit unit:HP .

ex36:00009 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower,
        bob:ElectricPowerkW ;
    rdfs:label "kW" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricPower ;
    qudt:hasUnit unit:KiloW .

ex36:00010 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:PowerFactor ;
    rdfs:label "powerFactor" ;
    s223:isPropertyOf ex36:00001 ;
    qudt:hasQuantityKind quantitykind:PowerFactor ;
    qudt:hasUnit unit:UNITLESS .

ex36:00011 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "Glycol Valve" ;
    s223:cnx ex36:00012,
        ex36:00013 ;
    s223:connected ex36:00001 ;
    s223:connectedFrom ex36:00001 ;
    s223:connectedThrough ex36:00014 ;
    s223:hasConnectionPoint ex36:00012,
        ex36:00013 .

ex36:00012 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:Glycol15PercentConnectionPoint ;
    rdfs:label "Glycol Valve.waterInlet" ;
    s223:cnx ex36:00011,
        ex36:00014 ;
    s223:connectsThrough ex36:00014 ;
    s223:hasMedium p223:GlycolSolution-GlycolSolution-15Percent ;
    s223:isConnectionPointOf ex36:00011 .

ex36:00013 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:Glycol15PercentConnectionPoint ;
    rdfs:label "Glycol Valve.waterOutlet" ;
    s223:cnx ex36:00011 ;
    s223:hasMedium p223:GlycolSolution-GlycolSolution-15Percent ;
    s223:isConnectionPointOf ex36:00011 .

ex36:00014 a s223:Connection ;
    s223:cnx ex36:00003,
        ex36:00012 ;
    s223:connectsAt ex36:00003,
        ex36:00012 ;
    s223:connectsFrom ex36:00001 ;
    s223:connectsTo ex36:00011 ;
    s223:hasMedium p223:Fluid-Water .

