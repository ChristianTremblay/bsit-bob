# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-010
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex34: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_connection-010>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-010> ;
  rdfs:label "test_connection-010" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex34:00001 a s223:Connectable,
        s223:Equipment,
        s223:Pump ;
    rdfs:label "WaterPump" ;
    s223:cnx ex34:00002,
        ex34:00003,
        ex34:00004 ;
    s223:connected ex34:00011 ;
    s223:connectedThrough ex34:00014 ;
    s223:connectedTo ex34:00011 ;
    s223:hasConnectionPoint ex34:00002,
        ex34:00003,
        ex34:00004 ;
    s223:hasProperty ex34:00005,
        ex34:00006,
        ex34:00007,
        ex34:00008,
        ex34:00009,
        ex34:00010 ;
    bob:waterInlet ex34:00002 ;
    bob:waterOutlet ex34:00003 .

ex34:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:WaterConnectionPoint ;
    rdfs:label "WaterPump.waterInlet" ;
    s223:cnx ex34:00001 ;
    s223:hasMedium p223:Fluid-Water ;
    s223:isConnectionPointOf ex34:00001 .

ex34:00003 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:WaterConnectionPoint ;
    rdfs:label "WaterPump.waterOutlet" ;
    s223:cnx ex34:00001,
        ex34:00014 ;
    s223:connectsThrough ex34:00014 ;
    s223:hasMedium p223:Fluid-Water ;
    s223:isConnectionPointOf ex34:00001 .

ex34:00004 a s223:ConnectionPoint,
        s223:Electricity_600VLL_3Ph_60HzConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "WaterPump.electricalInlet" ;
    s223:cnx ex34:00001 ;
    s223:hasMedium s223:AC-600VLL-3Ph-60Hz ;
    s223:isConnectionPointOf ex34:00001 .

ex34:00005 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Pressure ;
    rdfs:label "head_pressure" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PSI .

ex34:00006 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Amps ;
    rdfs:label "amps" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent ;
    qudt:hasUnit unit:A .

ex34:00007 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:RPM ;
    rdfs:label "rpm" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:AngularVelocity ;
    qudt:hasUnit unit:REV-PER-MIN .

ex34:00008 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:HP ;
    rdfs:label "hp" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:hasUnit unit:HP .

ex34:00009 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower,
        bob:ElectricPowerkW ;
    rdfs:label "kW" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:ElectricPower ;
    qudt:hasUnit unit:KiloW .

ex34:00010 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:PowerFactor ;
    rdfs:label "powerFactor" ;
    s223:isPropertyOf ex34:00001 ;
    qudt:hasQuantityKind quantitykind:PowerFactor ;
    qudt:hasUnit unit:UNITLESS .

ex34:00011 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "Glycol Valve" ;
    s223:cnx ex34:00012,
        ex34:00013 ;
    s223:connected ex34:00001 ;
    s223:connectedFrom ex34:00001 ;
    s223:connectedThrough ex34:00014 ;
    s223:hasConnectionPoint ex34:00012,
        ex34:00013 .

ex34:00012 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:Glycol15PercentConnectionPoint ;
    rdfs:label "Glycol Valve.waterInlet" ;
    s223:cnx ex34:00011,
        ex34:00014 ;
    s223:connectsThrough ex34:00014 ;
    s223:hasMedium p223:GlycolSolution-GlycolSolution-15Percent ;
    s223:isConnectionPointOf ex34:00011 .

ex34:00013 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:Glycol15PercentConnectionPoint ;
    rdfs:label "Glycol Valve.waterOutlet" ;
    s223:cnx ex34:00011 ;
    s223:hasMedium p223:GlycolSolution-GlycolSolution-15Percent ;
    s223:isConnectionPointOf ex34:00011 .

ex34:00014 a s223:Connection ;
    s223:cnx ex34:00003,
        ex34:00012 ;
    s223:connectsAt ex34:00003,
        ex34:00012 ;
    s223:connectsFrom ex34:00001 ;
    s223:connectsTo ex34:00011 ;
    s223:hasMedium p223:Fluid-Water .

