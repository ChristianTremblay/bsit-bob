# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-003
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex32: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_connection-003>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-003> ;
  rdfs:label "test_connection-003" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Equipment ;
    rdfs:label "d1" ;
    s223:connectedThrough ex32:00005 ;
    s223:hasConnectionPoint ex32:00002 .

ex32:00002 a s223:OutletConnectionPoint ;
    rdfs:label "d1.out" ;
    s223:connectsThrough ex32:00005 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00003 a s223:Equipment ;
    rdfs:label "d2" ;
    s223:connectedThrough ex32:00005 ;
    s223:hasConnectionPoint ex32:00004 .

ex32:00004 a s223:InletConnectionPoint ;
    rdfs:label "d2.in" ;
    s223:connectsThrough ex32:00005 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex32:00003 .

ex32:00005 a s223:Connection ;
    s223:connectsAt ex32:00002,
        ex32:00004 ;
    s223:connectsFrom ex32:00001 ;
    s223:connectsTo ex32:00003 ;
    s223:hasMedium s223:Medium-Air .

