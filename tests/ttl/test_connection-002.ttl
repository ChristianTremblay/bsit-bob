# baseURI: http://data.ashrae.org/standard223/1.0/sample/test_connection-002
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex32: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/test_connection-002>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-002> ;
  rdfs:label "test_connection-002" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex32:00001 a s223:Device ;
    rdfs:label "d1" ;
    s223:connectedThrough ex32:00003 ;
    s223:hasConnectionPoint ex32:00002 .

ex32:00002 a s223:OutletConnectionPoint ;
    s223:connectsThrough ex32:00003 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex32:00001 .

ex32:00003 a s223:Connection ;
    s223:connectsAt ex32:00002 ;
    s223:connectsFrom ex32:00001 ;
    s223:hasMedium s223:Medium-Air .

