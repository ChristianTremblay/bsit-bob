@prefix ex35: <urn:ex/test_system-007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .

<http://data.ashrae.org/standard223/1.0/data/test_connection-001> a owl:Ontology ;
    rdfs:label "test_connection-001" ;
    rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/test_connection-001> .

ex35:00001 a s223:Connectable,
        s223:Equipment ;
    rdfs:label "d1" ;
    s223:connectedThrough ex35:00003 ;
    s223:hasConnectionPoint ex35:00002 .

ex35:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    s223:connectsThrough ex35:00003 ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf ex35:00001 .

ex35:00003 a s223:Connection ;
    s223:connectsAt ex35:00002 ;
    s223:connectsTo ex35:00001 ;
    s223:hasMedium s223:Fluid-Air .

