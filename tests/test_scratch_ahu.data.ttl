test_scratch_ahu:00001 a s223:Connection ;
    rdfs:label "Outdoor" ;
    s223:hasMedium s223:Fluid-Air ;
    rdfs:comment "This is where we exhaust air of bathroom, and windows of OpenOffice are connected here to" .

