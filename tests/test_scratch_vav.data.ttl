test_scratch_ahu:00001 a s223:Connection ;
    rdfs:label "Outdoor" ;
    s223:hasMedium s223:Fluid-Air ;
    rdfs:comment "This is where we exhaust air of bathroom, and windows of OpenOffice are connected here to" .

test_scratch_ahu:00002 a s223:Connection ;
    rdfs:label "Plenum" ;
    s223:hasMedium s223:Fluid-Air ;
    rdfs:comment "Plenum. It's where Duct Static Pressure Low port is connected" .

test_scratch_ahu:00003 a s223:Connection ;
    rdfs:label "MixedAirDuct" ;
    s223:connectsAt test_scratch_ahu:00152,
        test_scratch_ahu:00157,
        test_scratch_ahu:00196 ;
    s223:connectsFrom test_scratch_ahu:00154,
        test_scratch_ahu:00193 ;
    s223:connectsTo test_scratch_ahu:00151 ;
    s223:hasMedium s223:Fluid-Air ;
    rdfs:comment "Mix between return air and outdoor air" .

test_scratch_ahu:00004 a s223:Connection ;
