PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bacnet: <http://data.ashrae.org/bacnet/2020#>
PREFIX bacnet_references: <urn:src:bacnet_references/>
PREFIX bob: <http://data.ashrae.org/standard223/si-builder#>

SELECT DISTINCT ?contLabel ?objName ?objType ?objId ?prop
WHERE {
    ?controller a s223:Controller .
    ?controller bacnet:hasObject ?obj .
    ?obj ?p ?o .
    ?controller rdfs:label ?contLabel .
    ?obj bacnet:object-name ?objName .
    ?obj bacnet:object-type ?objType .
    ?obj bacnet:object-identifier ?objId .
    OPTIONAL { ?prop s223:hasExternalReference ?obj } .
}
