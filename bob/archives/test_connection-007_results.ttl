ex:00001 a s223:PhysicalSpace ;
    rdfs:label "My Building" ;
    s223:contains ex:00002,
        ex:00003 .

ex:00017 a s223:HVACZone,
        s223:Zone ;
    rdfs:label "Zone1" ;
    s223:airInlet ex:00018 ;
    s223:airOutlet ex:00019 ;
    s223:contains ex:00008,
        ex:00011 ;
    s223:hasDomain s223:HVAC ;
    s223:hasZoneConnectionPoint ex:00018,
        ex:00019 .

ex:00020 a s223:Device,
