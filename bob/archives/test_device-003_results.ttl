@prefix enum: <http://data.ashrae.org/standard223/1.0/vocab/enumeration#> .
@prefix ex: <urn:ex/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

ex:00010 a s223:Device,
        s223:ParticleCounter ;
    rdfs:label "PM-1" ;
    s223:airInletSupply ex:00011 ;
    s223:contains ex:00001,
        ex:00004,
        ex:00007 ;
    s223:hasConnectionPoint ex:00011 ;
    s223:hasSubstance enum:Medium-Air ;
    rdfs:comment "Particulate Measurement Station AKA particle counter" .

ex:00001 a s223:CoarseParticulateSensor,
        s223:Device,
        s223:ParticulateSensor,
        s223:Sensor ;
    rdfs:label "coarse_sensor" ;
    s223:hasProperty ex:00002 ;
    s223:hasSubstance enum:Medium_Air ;
    s223:measuresSubstance enum:Particulate-PM10.0 ;
    s223:observesProperty ex:00002 .

ex:00003 a s223:ExternalReference ;
    rdfs:label "coarse_sensor.Measure.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-value,1/present-value" .

ex:00004 a s223:Device,
        s223:FineParticulateSensor,
        s223:ParticulateSensor,
        s223:Sensor ;
    rdfs:label "fine_sensor" ;
    s223:hasProperty ex:00005 ;
    s223:hasSubstance enum:Medium_Air ;
    s223:measuresSubstance enum:Particulate-PM2.5 ;
    s223:observesProperty ex:00005 .

ex:00006 a s223:ExternalReference ;
    rdfs:label "fine_sensor.Measure.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-input,2/present-value" .

ex:00007 a s223:Device,
        s223:ParticulateSensor,
        s223:Sensor,
        s223:UltraFineParticulateSensor ;
    rdfs:label "ultrafine_sensor" ;
    s223:hasProperty ex:00008 ;
    s223:hasSubstance enum:Medium_Air ;
    s223:measuresSubstance enum:Particulate-PM1.0 ;
    s223:observesProperty ex:00008 .

ex:00009 a s223:ExternalReference ;
    rdfs:label "ultrafine_sensor.Measure.ExternalReference" ;
    s223:hasRef "bacnet://1/analog-input,3/present-value" .

ex:00002 a s223:ObservableProperty,
        s223:ParticulateMeasure,
        s223:QuantifiableMeasurement,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "coarse_sensor.Measure" ;
    s223:hasExternalReference ex:00003 ;
    s223:ofSubstance enum:Particulate-PM10.0 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:unit unit:NUM-PER-M3 .

ex:00005 a s223:ObservableProperty,
        s223:ParticulateMeasure,
        s223:QuantifiableMeasurement,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "fine_sensor.Measure" ;
    s223:hasExternalReference ex:00006 ;
    s223:ofSubstance enum:Particulate-PM2.5 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:unit unit:NUM-PER-M3 .

ex:00008 a s223:ObservableProperty,
        s223:ParticulateMeasure,
        s223:QuantifiableMeasurement,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "ultrafine_sensor.Measure" ;
    s223:hasExternalReference ex:00009 ;
    s223:ofSubstance enum:Particulate-PM1.0 ;
    qudt:hasQuantityKind quantitykind:NumberDensity ;
    qudt:unit unit:NUM-PER-M3 .

ex:00011 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "PM-1.airInletSupply" ;
    s223:hasDirection s223:Inlet ;
    enum:hasSubstance enum:Medium-Air .

