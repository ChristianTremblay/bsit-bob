PREFIX s223: <http://data.ashrae.org/standard223#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?room ?ds ?light ?onOffStatus
WHERE {
    ?oprop a/rdfs:subClassOf* s223:Property .
    ?oprop s223:hasValue s223:OccupancyStatus-Unoccupied .
    ?ds s223:hasProperty ?oprop .
    ?room s223:encloses ?ds .
    ?light s223:hasPhysicalLocation ?room .
    ?light a s223:Luminaire .
    ?light s223:hasProperty ?prop .
    ?prop s223:hasEnumerationKind s223:EnumerationKind-OnOff .
    ?prop s223:hasValue ?onOffStatus .
}
