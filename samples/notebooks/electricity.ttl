@prefix ex: <urn:ex/electricity_notebook/> .
@prefix p223: <http://data.ashrae.org/proposal_to_standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:00001 a p223:ElectricalCircuitBreaker,
        p223:TwoPolesMainCircuitBreaker,
        s223:Device ;
    rdfs:label "MainBreaker" ;
    p223:hasMaxRange ex:00002 ;
    s223:hasConnectionPoint ex:00003,
        ex:00004,
        ex:00005,
        ex:00006 ;
    s223:hasProperty ex:00002 ;
    rdfs:comment "Main breaker of panel" .
ex:00002 a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "Current rating of breaker" ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 200.0 ;
    s223:unit unit:A .
ex:00003 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "MainBreaker.electricalInlet" ;
    s223:connectsThrough ex:00019 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Electricity-120V_240V_60Hz .
ex:00004 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "MainBreaker.electricalOutlet" ;
    s223:connectsThrough ex:00016 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00005 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "MainBreaker.electricalOutlet" ;
    s223:connectsThrough ex:00017 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00006 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "MainBreaker.electricalOutlet" ;
    s223:connectsThrough ex:00018 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-240V_60Hz .
ex:00007 a p223:ElectricalCircuitBreaker,
        p223:SinglePoleCircuitBreaker,
        s223:Device ;
    rdfs:label "CB#1" ;
    p223:hasMaxRange ex:00008 ;
    s223:hasConnectionPoint ex:00009,
        ex:00010 ;
    s223:hasProperty ex:00008 ;
    rdfs:comment "Lights" .
ex:00008 a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "Current rating of breaker" ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 15.0 ;
    s223:unit unit:A .
ex:00009 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "CB#1.electricalInlet" ;
    s223:connectsThrough ex:00016 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00010 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "CB#1.electricalOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00011 a p223:ElectricalCircuitBreaker,
        p223:TwoPolesCircuitBreaker,
        s223:Device ;
    rdfs:label "CB#2" ;
    p223:hasMaxRange ex:00012 ;
    s223:hasConnectionPoint ex:00013,
        ex:00014 ;
    s223:hasProperty ex:00012 ;
    rdfs:comment "Heater" .
ex:00012 a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    rdfs:label "Current rating of breaker" ;
    s223:hasQuantityKind quantitykind:ElectricCurrent ;
    s223:hasValue 20.0 ;
    s223:unit unit:A .
ex:00013 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "CB#2.electricalInlet" ;
    s223:connectsThrough ex:00018 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Electricity-240V_60Hz .
ex:00014 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "CB#2.electricalOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Electricity-240V_60Hz .
ex:00015 a p223:ElectricalDistributionPanel,
        p223:SinglePhaseDistributionPanel,
        s223:Device ;
    rdfs:label "My Panel" ;
    s223:contains ex:00001,
        ex:00007,
        ex:00011 ;
    rdfs:comment "Description of my panel" .
ex:00016 a s223:Connection ;
    rdfs:label "My Panel.electricalBusA" ;
    s223:connectsAt ex:00004,
        ex:00009 ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00017 a s223:Connection ;
    rdfs:label "My Panel.electricalBusB" ;
    s223:connectsAt ex:00005 ;
    s223:hasMedium s223:Electricity-120V_60Hz .
ex:00018 a s223:Connection ;
    rdfs:label "My Panel.electricalBusAB" ;
    s223:connectsAt ex:00006,
        ex:00013 ;
    s223:hasMedium s223:Electricity-240V_60Hz .
ex:00019 a s223:Connection ;
    rdfs:label "Hydro-Québec" ;
    s223:connectsAt ex:00003 ;
    s223:hasMedium s223:Electricity-120V_240V_60Hz .
