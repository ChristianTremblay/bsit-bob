# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample004
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex: <urn:ex/sample004/> .
@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal_to_standard223#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/sample004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample004> ;
  rdfs:label "sample004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex:00001 a s223:HVACZone,
        s223:Zone ;
    rdfs:label "Zone" ;
    s223:hasZoneConnectionPoint ex:00002,
        ex:00003 ;
    s223:returnAir ex:00003 ;
    s223:supplyAir ex:00002 .

ex:00002 a s223:InletZoneConnectionPoint,
        s223:ZoneConnectionPoint ;
    rdfs:label "Zone.supplyAir" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00005 .

ex:00003 a s223:OutletZoneConnectionPoint,
        s223:ZoneConnectionPoint ;
    rdfs:label "Zone.returnAir" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00006 .

ex:00004 a s223:DomainSpace ;
    rdfs:label "Zone.space" ;
    s223:hasConnectionPoint ex:00005,
        ex:00006 .

ex:00005 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "Zone.space.supplyAir" ;
    s223:connectsThrough ex:00020 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air .

ex:00006 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "Zone.space.returnAir" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air .

ex:00007 a s223:System,
        s223:VAV1 ;
    rdfs:label "Zone.VAV" ;
    s223:airFlow ex:00011 ;
    s223:airInlet ex:00008 ;
    s223:airOutlet ex:00009 ;
    s223:contains ex:00010,
        ex:00014 ;
    s223:damperPosition ex:00015 ;
    s223:hasProperty ex:00011,
        ex:00015 ;
    s223:hasSystemConnectionPoint ex:00008,
        ex:00009 .

ex:00008 a s223:InletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "Zone.VAV.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00012 .

ex:00009 a s223:OutletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "Zone.VAV.airOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00018 .

ex:00010 a p223:AirFlowMonitor,
        s223:Device ;
    rdfs:label "Zone.VAV.air_flow_station" ;
    p223:airInlet ex:00012 ;
    p223:airOutlet ex:00013 ;
    p223:flow ex:00011 ;
    s223:hasConnectionPoint ex:00012,
        ex:00013 ;
    s223:hasProperty ex:00011 .

ex:00011 a g36:AnalogIn ;
    rdfs:label "Zone.VAV.air_flow_station.flow" .

ex:00012 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "Zone.VAV.air_flow_station.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air .

ex:00013 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "Zone.VAV.air_flow_station.airOutlet" ;
    s223:connectsThrough ex:00019 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air .

ex:00014 a s223:Damper,
        s223:Device ;
    rdfs:label "Zone.VAV.damper" ;
    s223:airInlet ex:00017 ;
    s223:airOutlet ex:00018 ;
    s223:feedback ex:00016 ;
    s223:hasConnectionPoint ex:00017,
        ex:00018 ;
    s223:hasProperty ex:00015,
        ex:00016 ;
    s223:position ex:00015 .

ex:00015 a g36:AnalogOut ;
    rdfs:label "Zone.VAV.damper.position" .

ex:00016 a g36:AnalogIn ;
    rdfs:label "Zone.VAV.damper.feedback" .

ex:00017 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "Zone.VAV.damper.airInlet" ;
    s223:connectsThrough ex:00019 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air .

ex:00018 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "Zone.VAV.damper.airOutlet" ;
    s223:connectsThrough ex:00020 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air .

ex:00019 a s223:Connection ;
    s223:connectsAt ex:00013,
        ex:00017 ;
    s223:hasMedium s223:Medium-Air .

ex:00020 a s223:Connection ;
    s223:connectsAt ex:00005,
        ex:00018 ;
    s223:hasMedium s223:Medium-Air .

