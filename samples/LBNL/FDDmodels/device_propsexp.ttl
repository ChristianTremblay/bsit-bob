ns1:EnumerationKind-HVACOperatingMode a ns1:Class,
        ns1:EnumerationKind-HVACOperatingMode,
        sh:NodeShape ;
    rdfs:label "HVAC system/equipment operating mode. The policy under which the system is operating." ;
    rdfs:subClassOf ns1:EnumerationKind .

ns1:EnumerationKind-HVACOperatingStatus a ns1:Class,
        ns1:EnumerationKind-HVACOperatingStatus,
        sh:NodeShape ;
    rdfs:label "HVAC system/equipment operating status. What the system is currently doing." ;
    rdfs:subClassOf ns1:EnumerationKind .

ns1:EnumerationKind-Medium a ns1:Class,
        ns1:EnumerationKind-Medium,
        sh:NodeShape ;
    rdfs:label "Medium" ;
    rdfs:subClassOf ns1:EnumerationKind .

ns1:EnumerationKind-Domain a ns1:Class,
        ns1:EnumerationKind-Domain,
        sh:NodeShape ;
    rdfs:label "EnumerationKind Domain" ;
    rdfs:subClassOf ns1:EnumerationKind ;
    sh:property [ sh:class ns1:EnumerationKind-Role ;
            sh:path ns1:hasRole ] .

ns1:EnumerationKind a ns1:Class,
        sh:NodeShape ;
    rdfs:label "Enumeration kind" ;
    rdfs:subClassOf ns1:Concept .

ns1:EnumerationKind-Role a ns1:Class,
        ns1:EnumerationKind-Role,
        sh:NodeShape ;
    rdfs:label "Role" ;
    rdfs:subClassOf ns1:EnumerationKind .

