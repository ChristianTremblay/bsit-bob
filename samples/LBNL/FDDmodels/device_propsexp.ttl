<http://data.ashrae.org/standard223/1.0/vocab/enumeration> a owl:Ontology ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all>,
        sh: ;
    owl:versionInfo "Created with TopBraid Composer" .

<http://data.ashrae.org/standard223/data/device_props#00002> ns1:hasDomain ns1:Domain-HVAC .

ns1:Domain-HVAC a ns1:EnumerationKind-Domain ;
    rdfs:label "Domain-HVAC" .

ns1:Medium-Electricity a ns1:Class,
        ns1:Medium-Electricity,
        sh:NodeShape ;
    rdfs:label "Electricity" ;
    rdfs:subClassOf ns1:EnumerationKind-Medium .

ns1:EnumerationKind-Effectiveness a ns1:Class,
        ns1:EnumerationKind-Effectiveness,
        sh:NodeShape ;
    rdfs:label "Effectiveness" ;
    rdfs:subClassOf ns1:EnumerationKind .

ns1:DayOfWeek-Weekend a ns1:Class,
