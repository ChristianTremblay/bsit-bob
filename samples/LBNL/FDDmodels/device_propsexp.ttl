ns1:EnumerationKind-Direction a ns1:Class,
        ns1:EnumerationKind-Direction,
        sh:NodeShape ;
    rdfs:label "Direction" ;
    rdfs:comment "This class has enumerated instances of Bidirectional, Inlet and Outlet used to qualify ConnectionPoints." ;
    rdfs:subClassOf ns1:EnumerationKind .

ns1:EnumerationKind-OccupancyStatus a ns1:Class,
        ns1:EnumerationKind-OccupancyStatus,
        sh:NodeShape ;
    rdfs:label "Occupancy status" ;
    rdfs:subClassOf ns1:EnumerationKind,
        ns1:SetpointAspect .

