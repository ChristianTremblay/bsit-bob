        sh: ;
    owl:versionInfo "Created with TopBraid Composer" .

<http://data.ashrae.org/standard223#Medium-Electricity> a <http://data.ashrae.org/standard223#Class>,
        <http://data.ashrae.org/standard223#Medium-Electricity>,
        sh:NodeShape ;
    rdfs:label "Electricity" ;
    rdfs:subClassOf <http://data.ashrae.org/standard223#EnumerationKind-Medium> .

