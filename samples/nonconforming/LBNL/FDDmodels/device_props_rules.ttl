s223:DomainSpace
  sh:property [
      sh:path [sh:inversePath s223:encloses ] ;
      sh:message "This DomainSpace must eventually be enclosed by a PhysicalSpace." ;
      sh:minCount 1 ;
      sh:severity sh:Info ;
    ] ;
.

s223:DomainSpace
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
CONSTRUCT {$this s223:hasDomain ?domain .}
WHERE {
?z s223:contains $this .
?z s223:hasDomain ?domain  .
?z a s223:Zone .
}
""" ] .

s223:HasDomainLookingUpRule
  a sh:NodeShape ;
  sh:rule [
      a sh:TripleRule ;
      rdfs:comment "Traverse up the contains hierarchy to determine the domain" ;
      sh:object [
          sh:path (
              [
                sh:zeroOrMorePath s223:isContainedIn ;
              ]
              s223:hasDomain
            ) ;
        ] ;
      sh:predicate s223:hasDomain ;
      sh:subject sh:this ;
    ] ;
  sh:targetClass s223:DomainSpace ;
  sh:targetClass s223:Zone ;
.
