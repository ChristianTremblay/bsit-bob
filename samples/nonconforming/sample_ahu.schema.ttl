bob:AirHandlingUnit a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.hvac.airhandlingunit.AirHandlingUnit" ;
    rdfs:comment """
        This is treated as a system.
        We will add multiple devices inside using a template

        example from pritoni (2024-01-06)
        ahu_template = {
        "params": {"label": "AHU", "comment": "AHU delivering air to 2 VAV boxes"},
        "sensors": {
            ("OA-T", AirTemperatureSensor): {
                "hasUnit": UNIT.DEG_C,
                "comment": "Oudoor air temperature (S3)",
            },
            ("TPD1", AirDifferentialStaticPressureSensor): {
                "hasUnit": UNIT.PA,
                "comment": "Filter Differential Pressure Sensor (S5)",
            },
            ("HC-T", AirTemperatureSensor): {
                "hasUnit": UNIT.DEG_C,
                "comment": "Air temperature after heating coil (S6)",
            },
            ("MA-T", AirTemperatureSensor): {
                "hasUnit": UNIT.DEG_F,
                "comment": "Return Air temperature (S4)",
            },
            ("DA-T", AirTemperatureSensor): {
                "hasUnit": UNIT.DEG_F,
                "comment": "Discharge Air temperature after cooling coil (S7)",
            },
            ("RA-T", AirTemperatureSensor): {
                "hasUnit": UNIT.DEG_F,
                "comment": "Return Air temperature (S2)",
            },
            ("TPD2", AirDifferentialStaticPressureSensor): {
                "hasUnit": UNIT.PA,
                "comment": "Supply Duct Static Pressure (S8)",
            },
            ("TPD3", AirDifferentialStaticPressureSensor): {
                "hasUnit": UNIT.PA,
                "comment": "Return Duct Static Pressure (S1)",
            },
        },
        "equipment": {
            ("RF", Fan): {
                "comment": "Return Air Fan",
                "electricalInlet": Electricity_600VLL_3Ph_60HzInletConnectionPoint,
                "hasRole": Role.Return,
            },
            ("RF_VFD", VFD): {
                "comment": "Return Air Fan VFD",
            },
            ("SF", Fan): {
                "comment": "Supply Air Fan",
                "electricalInlet": Electricity_600VLL_3Ph_60HzInletConnectionPoint,
                "hasRole": Role.Supply,
            },
            ("SF_Starter", MotorStarter): {
                "comment": "Supply Air Fan Starter",
            },
            ("CLGCOIL", ChilledWaterCoil): {"comment": "Cooling Coil"},
            ("HTGCOIL", HotWaterCoil): {"comment": "Heating coil"},
            ("FILTER", Filter): {"comment": "Filter"},
            ("OADPR", ElectricalActuatedProportionalDamper): {
                "comment": "Outdoor air damper (A3)"
            },
            ("MADPR", ElectricalActuatedProportionalDamper): {
                "comment": "Mixed Air Damper (A2)"
            },
            ("EADPR", ElectricalActuatedProportionalDamper): {
                "comment": "Exhaust Air Damper (A1)"
            },
        },
    }

    """ ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:returnAirInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:exhaustAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:supplyAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:electricalInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:outsideAirInlet ] .

bob:AirTemperatureSensor a rdfs:Class ;
    rdfs:label "bob.sensor.temperature.AirTemperatureSensor" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Sensor,
        s223:TemperatureSensor .

bob:Amps a rdfs:Class ;
    rdfs:label "bob.properties.electricity.Amps" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:Causality a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.producer.causality.Causality" ;
    rdfs:comment """
    Simple causality black box. Its goal is to express a
    simple relation between the output and the input.
    It tells : this input, causes an effect on that output.
    """ ;
    rdfs:subClassOf p223:Producer ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:cause_input ],
        [ a sh:PropertyShape ;
            sh:path bob:effect_output ] .

bob:ChilledWaterConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.liquid.ChilledWaterConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
