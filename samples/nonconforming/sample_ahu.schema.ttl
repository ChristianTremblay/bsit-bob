<http://data.ashrae.org/standard223/1.0/data/sample_ahu>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample_ahu-schema> ;
  rdfs:label "sample_ahu-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

[] a s223:Property,
        s223:QuantifiableProperty ;
    rdfs:label "R-22.Constituent-R-22" ;
    s223:ofConstituent p223:Constituent-R-22 ;
    qudt:hasQuantityKind qudtqk:VolumeFraction ;
    qudt:hasUnit unit:PERCENT .

[] a s223:Property,
        s223:QuantifiableProperty ;
    rdfs:label "R-410A.Constituent-R-410A" ;
    s223:ofConstituent p223:Constituent-R-410A ;
    qudt:hasQuantityKind qudtqk:VolumeFraction ;
    qudt:hasUnit unit:PERCENT .

bob:actuates a rdf:Property .

bob:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:alarmStatus a rdf:Property .

bob:cause_input a rdf:Property .

bob:chilledWaterInlet a rdf:Property ;
