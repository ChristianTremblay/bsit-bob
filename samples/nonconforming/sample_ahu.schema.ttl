bob:returnAirInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint .

bob:supplyAirOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint .

