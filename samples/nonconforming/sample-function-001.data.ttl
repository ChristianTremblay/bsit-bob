# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample-function-001-data
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex1: <urn:ex/sample-function-001/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample-function-001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample-function-001-data> ;
  rdfs:label "sample-function-001-data" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a s223:Property ;
    rdfs:label "x" ;
    s223:hasValue 1.2e+00 .

ex1:00002 a s223:Property ;
    rdfs:label "y" ;
    s223:hasValue 3.4e+00 .

ex1:00003 a s223:Function,
        ex1:Sample ;
    rdfs:label "f" ;
    s223:hasInput ex1:00001 ;
    s223:hasOutput ex1:00002 ;
    ex1:x ex1:00001 ;
    ex1:y ex1:00002 .

