# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample002-schema
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex1: <urn:ex/sample002/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample002>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample002-schema> ;
  rdfs:label "sample002-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:Snork a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.Snork" ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:temp ],
        [ a sh:PropertyShape ;
            sh:path ex1:test ] .

ex1:Test a rdfs:Class ;
    rdfs:label "__main__.Test" .

ex1:temp a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

ex1:test a rdf:Property .

