# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample011-schema
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex1: <urn:ex/sample011/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample011>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample011-schema> ;
  rdfs:label "sample011-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:TestEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpOut ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpIn ] .

ex1:TestSystem a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestSystem" ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpOut ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpIn ] .

ex1:cpIn a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

ex1:cpOut a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

