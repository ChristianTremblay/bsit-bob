# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample007-schema
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex1: <urn:ex/sample007/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample007>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample007-schema> ;
  rdfs:label "sample007-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:Part1 a rdfs:Class ;
    rdfs:label "__main__.Part1" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex1:Part2 a rdfs:Class ;
    rdfs:label "__main__.Part2" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex1:TestEquipment a rdfs:Class ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

