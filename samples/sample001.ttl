# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample001
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex: <urn:ex/sample001/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/sample001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample001> ;
  rdfs:label "sample001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex:00001 a s223:Device,
        ex:TestDevice ;
    rdfs:label "Test Device 1" ;
    s223:hasProperty ex:00002 .

ex:00002 a s223:QuantifiableProperty,
        ex:TemperatureProperty ;
    rdfs:label "temp" ;
    s223:hasQuantityKind quantitykind:Temperature ;
    s223:hasValue 75.5 ;
    s223:unit qudt:DEG_F .

ex:00003 a s223:Device,
        ex:TestDevice ;
    rdfs:label "Test Device 2" ;
    s223:hasProperty ex:00004 .

ex:00004 a s223:QuantifiableProperty,
        ex:TemperatureProperty ;
    rdfs:label "temp" ;
    s223:hasQuantityKind quantitykind:Temperature ;
    s223:hasValue 90.5 ;
    s223:unit qudt:DEG_F .

ex:00005 a s223:Device,
        ex:TestDevice2 ;
    rdfs:label "Test Device 3" ;
    s223:hasProperty ex:00006 ;
    ex:hasTemp ex:00006 .

ex:00006 a s223:ObservableProperty,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    s223:hasValue 100.5 .

