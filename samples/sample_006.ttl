@prefix brick: <https://brickschema.org/schema/1.1.0/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4syst: <https://saref.etsi.org/> .

<urn:ex:00005> a s4syst:ConnectionPoint,
        <urn:ex:HotWaterOut> ;
    rdfs:label "hot_water_coil.hwr" ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00007> a s4syst:ConnectionPoint,
        <urn:ex:AnalogIn> ;
    rdfs:label "hot_water_coil.hw_valve.pos" ;
    s4syst:connectionPointOf <urn:ex:00006> .

<urn:ex:00008> a s4syst:ConnectionPoint,
        <urn:ex:HotWaterIn> ;
    rdfs:label "hot_water_coil.hw_valve.hwin" ;
    s4syst:connectionPointOf <urn:ex:00006> .

<urn:ex:00011> a s4syst:Connection,
        <urn:ex:AirConnection> ;
    rdfs:label "Cold Air" ;
    s4syst:connectsSystemAt <urn:ex:00002> .

<urn:ex:00012> a s4syst:Connection,
        <urn:ex:AirConnection> ;
    rdfs:label "Hot Air" ;
    s4syst:connectsSystemAt <urn:ex:00003> .

<urn:ex:00002> a s4syst:ConnectionPoint,
        <urn:ex:AirIn> ;
    rdfs:label "hot_water_coil.ain" ;
    s4syst:connectedThrough <urn:ex:00011> ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00003> a s4syst:ConnectionPoint,
        <urn:ex:AirOut> ;
    rdfs:label "hot_water_coil.aout" ;
    s4syst:connectedThrough <urn:ex:00012> ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00004> a s4syst:ConnectionPoint,
        <urn:ex:HotWaterIn> ;
    rdfs:label "hot_water_coil.hws" ;
    s4syst:connectedThrough <urn:ex:00010> ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00009> a s4syst:ConnectionPoint,
        <urn:ex:HotWaterOut> ;
    rdfs:label "hot_water_coil.hw_valve.hwout" ;
    s4syst:connectedThrough <urn:ex:00010> ;
    s4syst:connectionPointOf <urn:ex:00006> .

<urn:ex:00010> a s4syst:Connection,
        <urn:ex:HotWaterConnection> ;
    s4syst:connectsSystemAt <urn:ex:00004>,
        <urn:ex:00009> .

<urn:ex:00006> a brick:Hot_Water_Valve,
        s4syst:System,
        <urn:ex:HotWaterValve> ;
    rdfs:label "hot_water_coil.hw_valve" ;
    brick:feeds <urn:ex:00001> ;
    brick:isPartOf <urn:ex:00001> ;
    s4syst:connectsAt <urn:ex:00007>,
        <urn:ex:00008>,
        <urn:ex:00009> ;
    s4syst:subSystemOf <urn:ex:00001> .

<urn:ex:00001> a brick:Hot_Water_Coil,
        s4syst:System,
        <urn:ex:HotWaterCoil2> ;
    rdfs:label "hot_water_coil" ;
    brick:hasPart <urn:ex:00006> ;
    s4syst:connectsAt <urn:ex:00002>,
        <urn:ex:00003>,
        <urn:ex:00004>,
        <urn:ex:00005> ;
    s4syst:hasSubSystem <urn:ex:00006> .

