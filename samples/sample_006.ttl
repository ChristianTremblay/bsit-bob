@prefix ex: <urn:ex/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4syst: <https://saref.etsi.org/> .

ex:00005 a ex:HotWaterOutlet ;
    rdfs:label "hot_water_coil.hwr" ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectionPointOf ex:00001 .

ex:00007 a ex:AnalogIn ;
    rdfs:label "hot_water_coil.hw_valve.pos" ;
    s4syst:connectionPointOf ex:00006 ;
    ex:connectionPointOf ex:00006 .

ex:00008 a ex:HotWaterInlet ;
    rdfs:label "hot_water_coil.hw_valve.hwin" ;
    s4syst:connectionPointOf ex:00006 ;
    ex:connectionPointOf ex:00006 .

ex:00011 a ex:AirConnection ;
    rdfs:label "Cold Air" ;
    s4syst:connectsSystemAt ex:00002 .

ex:00012 a ex:AirConnection ;
    rdfs:label "Hot Air" ;
    s4syst:connectsSystemAt ex:00003 .

ex:00002 a ex:AirInlet ;
    rdfs:label "hot_water_coil.ain" ;
    s4syst:connectedThrough ex:00011 ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectedThrough ex:00011 ;
    ex:connectionPointOf ex:00001 .

ex:00003 a ex:AirOutlet ;
    rdfs:label "hot_water_coil.aout" ;
    s4syst:connectedThrough ex:00012 ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectedThrough ex:00012 ;
    ex:connectionPointOf ex:00001 .

ex:00004 a ex:HotWaterInlet ;
    rdfs:label "hot_water_coil.hws" ;
    s4syst:connectedThrough ex:00010 ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectedThrough ex:00010 ;
    ex:connectionPointOf ex:00001 .

ex:00009 a ex:HotWaterOutlet ;
    rdfs:label "hot_water_coil.hw_valve.hwout" ;
    s4syst:connectedThrough ex:00010 ;
    s4syst:connectionPointOf ex:00006 ;
    ex:connectedThrough ex:00010 ;
    ex:connectionPointOf ex:00006 .

ex:00010 a ex:HotWaterConnection ;
    s4syst:connectsSystemAt ex:00004,
        ex:00009 .

ex:00006 a s4syst:System,
        ex:HotWaterValve ;
    rdfs:label "hot_water_coil.hw_valve" ;
    s4syst:connectsAt ex:00007,
        ex:00008,
        ex:00009 ;
    s4syst:subSystemOf ex:00001 ;
    ex:hwin ex:00008 ;
    ex:hwout ex:00009 ;
    ex:pos ex:00007 .

ex:00001 a s4syst:System,
        ex:HotWaterCoil2 ;
    rdfs:label "hot_water_coil" ;
    s4syst:connectsAt ex:00002,
        ex:00003,
        ex:00004,
        ex:00005 ;
    s4syst:hasSubSystem ex:00006 ;
    ex:ain ex:00002 ;
    ex:aout ex:00003 ;
    ex:hwr ex:00005 ;
    ex:hws ex:00004 .

