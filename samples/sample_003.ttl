<urn:ex:00009> a s4syst:ConnectionPoint,
        <urn:ex:AirOut> ;
    rdfs:label "F.aout" ;
    s4syst:connectedThrough <urn:ex:00010> ;
    s4syst:connectionPointOf <urn:ex:00007> .

<urn:ex:00010> a s4syst:Connection,
        <urn:ex:AirConnection> ;
