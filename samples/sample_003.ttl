@prefix ex: <urn:ex/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4syst: <https://saref.etsi.org/> .

ex:00001 a ex:ChilledWaterConnection ;
    s4syst:connectsSystemAt ex:00005 .

ex:00006 a ex:ChilledWaterOutlet ;
    rdfs:label "CW-Coil-1.cwr" ;
    s4syst:connectionPointOf ex:00002 ;
    ex:connectionPointOf ex:00002 .

ex:00008 a ex:AirInlet ;
    rdfs:label "F.ain" ;
    s4syst:connectionPointOf ex:00007 ;
    ex:connectionPointOf ex:00007 .

ex:00013 a ex:AirOutlet ;
    rdfs:label "Zone-1.ra" ;
    s4syst:connectionPointOf ex:00011 ;
    ex:connectionPointOf ex:00011 .

ex:00003 a ex:AirInlet ;
    rdfs:label "CW-Coil-1.ain" ;
    s4syst:connectedThrough ex:00010 ;
    s4syst:connectionPointOf ex:00002 ;
    ex:connectedThrough ex:00010 ;
    ex:connectionPointOf ex:00002 .

ex:00004 a ex:AirOutlet ;
    rdfs:label "CW-Coil-1.aout" ;
    s4syst:connectedThrough ex:00014 ;
    s4syst:connectionPointOf ex:00002 ;
    ex:connectedThrough ex:00014 ;
    ex:connectionPointOf ex:00002 .

ex:00005 a ex:ChilledWaterInlet ;
    rdfs:label "CW-Coil-1.cws" ;
    s4syst:connectedThrough ex:00001 ;
    s4syst:connectionPointOf ex:00002 ;
    ex:connectedThrough ex:00001 ;
    ex:connectionPointOf ex:00002 .

ex:00009 a ex:AirOutlet ;
    rdfs:label "F.aout" ;
    s4syst:connectedThrough ex:00010 ;
    s4syst:connectionPointOf ex:00007 ;
    ex:connectedThrough ex:00010 ;
    ex:connectionPointOf ex:00007 .

ex:00012 a ex:AirInlet ;
    rdfs:label "Zone-1.sa" ;
    s4syst:connectedThrough ex:00014 ;
    s4syst:connectionPointOf ex:00011 ;
    ex:connectedThrough ex:00014 ;
    ex:connectionPointOf ex:00011 .

ex:00007 a s4syst:System,
        ex:Fan ;
    rdfs:label "F" ;
    s4syst:connectsAt ex:00008,
        ex:00009 ;
    ex:ain ex:00008 ;
    ex:aout ex:00009 .

ex:00010 a ex:AirConnection ;
    s4syst:connectsSystemAt ex:00003,
        ex:00009 .

ex:00011 a s4syst:System,
        ex:Zone ;
    rdfs:label "Zone-1" ;
    s4syst:connectsAt ex:00012,
        ex:00013 ;
    ex:ra ex:00013 ;
    ex:sa ex:00012 .

ex:00014 a ex:AirConnection ;
    s4syst:connectsSystemAt ex:00004,
        ex:00012 .

ex:00002 a s4syst:System,
        ex:ChilledWaterCoil ;
    rdfs:label "CW-Coil-1" ;
    s4syst:connectsAt ex:00003,
        ex:00004,
        ex:00005,
        ex:00006 ;
    ex:ain ex:00003 ;
    ex:aout ex:00004 ;
    ex:cwr ex:00006 ;
    ex:cws ex:00005 .

