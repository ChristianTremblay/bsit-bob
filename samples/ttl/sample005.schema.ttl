        [ a sh:PropertyShape ;
            sh:path bob:humidity ],
        [ a sh:PropertyShape ;
            sh:path bob:occupancy ],
        [ a sh:PropertyShape ;
            sh:path bob:windows ],
        [ a sh:PropertyShape ;
            sh:path bob:co2 ],
        [ a sh:PropertyShape ;
            sh:path bob:ductAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:co ],
        [ a sh:PropertyShape ;
            sh:path bob:airTransfer ],
        [ a sh:PropertyShape ;
