@prefix ex1: <urn:ex/sample007/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


[] a sh:PropertyShape ;
    sh:path s223:hasPhysicalLocation .

ex1:Part1 a rdfs:Class ;
    rdfs:label "__main__.Part1" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex1:Part2 a rdfs:Class ;
    rdfs:label "__main__.Part2" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex1:TestEquipment a rdfs:Class ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

