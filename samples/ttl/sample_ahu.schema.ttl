<http://data.ashrae.org/standard223/1.0/data/sample_ahu>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample_ahu-schema> ;
  rdfs:label "sample_ahu-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

bob:actuates a rdf:Property .

bob:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:alarmStatus a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:cause_input a rdf:Property .

bob:chilledWaterInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:chilledWaterOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:commandedByProperty a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:differentialPressure a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:differential_output a rdf:Property .

bob:differential_static_pressure a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:effect_output a rdf:Property .

bob:electricalInlet a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

bob:exhaustAirOutlet a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

bob:hasCauseLocation a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:hasEffectLocation a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:hasSystemConnectionPoint a rdf:Property .

bob:high_input a rdf:Property .

bob:hotWaterInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:hotWaterOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:isObservedBy a rdf:Property .

bob:isSystemConnectionPointOf a rdf:Property .

bob:low_input a rdf:Property .

bob:mapsTo a rdf:Property .

bob:measuresMedium a rdf:Property .

bob:modulation a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:onOffCommand a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:outsideAirInlet a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

bob:returnAirInlet a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

bob:supplyAirOutlet a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

