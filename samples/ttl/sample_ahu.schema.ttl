            sh:path scratch:command ],
        [ a sh:PropertyShape ;
            sh:path scratch:position ] .

scratch:DamperAndActuator a rdfs:Class ;
    rdfs:label "bob.scratch.hvac.damper.DamperAndActuator" ;
    rdfs:comment """
    This is made as a equipment and not a system because it is a common group of equipment
    You will see the use of mapsTo in the damper and actuator to link the connection points

    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Damper,
        s223:Equipment,
        scratch:Damper .

scratch:ElectricalActuatedProportionalDamper a rdfs:Class ;
    rdfs:label "bob.scratch.hvac.damper.ElectricalActuatedProportionalDamper" ;
    rdfs:subClassOf s223:Connectable,
        s223:Damper,
        s223:Equipment,
        scratch:Damper,
        scratch:DamperAndActuator .

scratch:ElectricalProportionalActuator a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.hvac.actuator.ElectricalProportionalActuator" ;
    rdfs:subClassOf s223:Actuator,
        s223:Connectable,
        s223:Equipment,
        scratch:Actuator ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:command ] .

scratch:Fan a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.hvac.fan.Fan" ;
    rdfs:comment """
    Prototype of a Fan based on the Bob Fan class
    Fan speed is an important property
    The intrinsic property I want to make `actuatedby` a starter or a VFD, I'd like it to be
    a PercentCommand.
    Because RPM, cfm, amps, etc... will all depend of this and I would not want having to make multiple
    `actuatesProperty` relationships between the starter/vfd and the fan.
    I only want 1 property.
    Then if required, it'll be possible to calculate RPM, amps, cfm, etc, based on the `PercentCommand` actuated property

    RPM of the fan, can be different from RPM of motor (ex. belt and pulley)
    So here, speed_ratio != RPM because if a fan can deliver x RPM, the ratio of pulley can be changed and
    giving 100% speed_ratio to a fan, may mean a different speed than RPM of fan.

    A motor starter will give 0% or 100% of speed_ratio depending on being On or Off
    A VFD will modulate this speed ratio from 0% to 100%.
    Depending on the configuration of the drive, this ratio can represent 0-60Hz... or 20-50Hz
    (if freq are configured different than 0-60Hz), etc...

    Using speed_ratio will isolate the model from the real time data by providing an agnostic way
    of actuating the fan.
    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Fan ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:onOffCommand ],
        [ a sh:PropertyShape ;
            sh:path bob:airInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:airOutlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:onOffStatus ] .

scratch:MotorStarter_600VLL_3Ph_60Hz a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.electricity.starter.MotorStarter_600VLL_3Ph_60Hz" ;
    rdfs:comment """
    Motor starter
    This Equipment provides command and status for an electrical
    Equipment like a fan or a pump
    This prototype is a 600V 3phases motor starter that implements
    onOffCommand and onOffStatus properties
    status is given by a current relay that is connected to the electrical outlet, that read
    current using its current sensor.

    """ ;
    rdfs:subClassOf p223:MotorStarter,
        s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:onOffStatus ],
        [ a sh:PropertyShape ;
            sh:path scratch:outputSignal ],
        [ a sh:PropertyShape ;
            sh:path scratch:inputSignal ] .

