@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://data.ashrae.org/standard223/1.0/data/sample-function-block-002>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample-function-block-002> ;
  rdfs:label "sample-function-block-002" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .
ex1:00001 a s223:Property ;
    rdfs:label "x" ;
    s223:hasValue 1.2e+00 .
ex1:00002 a s223:Property ;
    rdfs:label "y" ;
    s223:hasValue 3.4e+00 .
ex1:00003 a s223:FunctionBlock,
        ex1:Sample ;
    rdfs:label "f" ;
    s223:hasInput ex1:00004 ;
    s223:hasOutput ex1:00005 ;
    ex1:x ex1:00004 ;
    ex1:y ex1:00005 .
ex1:00004 a s223:AnalogInput,
        s223:FunctionInput ;
    rdfs:label "f.x" ;
    s223:uses ex1:00001 .
ex1:00005 a s223:AnalogOutput,
        s223:FunctionOutput ;
    rdfs:label "f.y" ;
    s223:produces ex1:00002 .
