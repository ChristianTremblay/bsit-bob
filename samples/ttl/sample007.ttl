<http://data.ashrae.org/standard223/1.0/data/sample007>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample007> ;
  rdfs:label "sample007" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex:00001 a s223:Device,
        ex:TestDevice ;
    rdfs:label "Test Device 1" ;
    s223:contains ex:00002,
        ex:00003 .

ex:00002 a s223:Device,
        ex:Part1 ;
    rdfs:label "p11" .

ex:00003 a s223:Device,
        ex:Part2 ;
    rdfs:label "p12" .

ex:00004 a s223:Device,
        ex:TestDevice ;
    rdfs:label "Test Device 2" ;
    s223:contains ex:00005 .

ex:00005 a s223:Device,
        ex:Part1 ;
    rdfs:label "p21" ;
    s223:contains ex:00006 .

ex:00006 a s223:Device,
        ex:Part2 ;
    rdfs:label "p22" .

ex:00007 a s223:Device,
        ex:TestDevice ;
    rdfs:label "Test Device 3" ;
    s223:contains ex:00009 .

ex:00008 a s223:Device,
        ex:Part1 ;
    rdfs:label "p31" .

ex:00009 a s223:Device,
        ex:Part2 ;
    rdfs:label "p32" ;
    s223:contains ex:00008 .

