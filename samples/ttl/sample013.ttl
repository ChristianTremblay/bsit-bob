# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample013
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex: <urn:ex/sample013/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/sample013>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample013> ;
  rdfs:label "sample013" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex:00001 a s223:PhysicalSpace ;
    rdfs:label "building" ;
    s223:contains ex:00002,
        ex:00005 .

ex:00002 a s223:PhysicalSpace ;
    rdfs:label "building.1fl" ;
    s223:contains ex:00003,
        ex:00004 ;
    s223:isContainedIn ex:00001 .

ex:00003 a s223:PhysicalSpace ;
    rdfs:label "building.rm101" ;
    s223:encloses ex:00008,
        ex:00009 ;
    s223:isContainedIn ex:00002 .

ex:00004 a s223:PhysicalSpace ;
    rdfs:label "building.rm102" ;
    s223:isContainedIn ex:00002 .

ex:00005 a s223:PhysicalSpace ;
    rdfs:label "building.2fl" ;
    s223:contains ex:00006,
        ex:00007 ;
    s223:isContainedIn ex:00001 .

ex:00006 a s223:PhysicalSpace ;
    rdfs:label "building.rm201" ;
    s223:isContainedIn ex:00005 .

ex:00007 a s223:PhysicalSpace ;
    rdfs:label "building.rm202" ;
    s223:isContainedIn ex:00005 .

ex:00008 a s223:DomainSpace ;
    rdfs:label "building.1fl.hvac" .

ex:00009 a s223:DomainSpace ;
    rdfs:label "building.1fl.lighting" .

