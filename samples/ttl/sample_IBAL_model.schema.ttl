p223:MechanicalConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.mechanical.MechanicalConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

