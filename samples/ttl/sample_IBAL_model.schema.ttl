# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample_IBAL_model-schema
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix scratch: <http://data.ashrae.org/standard223/si-builder/prototype#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample_IBAL_model>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample_IBAL_model-schema> ;
  rdfs:label "sample_IBAL_model-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

bacnet:AnalogInputObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.AnalogInputObject" ;
    rdfs:subClassOf bacnet:Object ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:object-type ] .

bacnet:AnalogOutputObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.AnalogOutputObject" ;
    rdfs:subClassOf bacnet:Object ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:object-type ] .

bacnet:Device a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.Device" ;
    rdfs:subClassOf s223:Connectable,
        s223:Controller,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:deviceInstance ] .

bacnet:DeviceObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.DeviceObject" ;
    rdfs:subClassOf bacnet:Object ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:system-status ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-type ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:path bacnet:vendor-identifier ],
        [ a sh:PropertyShape ;
            sh:path bacnet:vendor-name ] .

bacnet:Object a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.bacnet.Object" ;
    sh:property [ a sh:PropertyShape ;
            sh:path bacnet:description ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-identifier ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-name ],
        [ a sh:PropertyShape ;
            sh:path bacnet:object-type ] .

bacnet:description a rdf:Property .

bacnet:device-identifier a rdf:Property .

bacnet:deviceInstance a rdf:Property .

bacnet:object-identifier a rdf:Property .

bacnet:object-name a rdf:Property .

bacnet:object-type a rdf:Property .

bacnet:property-array-index a rdf:Property .

bacnet:property-identifier a rdf:Property .

bacnet:system-status a rdf:Property .

bacnet:vendor-identifier a rdf:Property .

bacnet:vendor-name a rdf:Property .

