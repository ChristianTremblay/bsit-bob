        s223:EnumerationKind-Medium .

p223:MotorStarter a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.electricity.starter.MotorStarter" ;
    rdfs:comment """
    Motor starter
    This Equipment provides command and status for an electrical
    Equipment like a fan or a pump

    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:inputSignal ],
        [ a sh:PropertyShape ;
            sh:path bob:outputSignal ],
        [ a sh:PropertyShape ;
            sh:path bob:onOffStatus ] .

