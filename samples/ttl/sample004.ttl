ex1:00014 a bob:AirSystemConnectionPoint,
        bob:OutletSystemConnectionPoint ;
    rdfs:label "VAV1.airOutlet" ;
    s223:hasMedium s223:Medium-Air ;
    bob:mapsTo ex1:00039 .

ex1:00015 a s223:System,
        bob:ElectricalActuatedProportionalDamper ;
    rdfs:label "VAV1.damper" ;
