ex1:00023 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Percent ;
    rdfs:label "position" ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:unit unit:PERCENT .

ex1:00024 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Percent ;
    rdfs:label "position_feedback" ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:unit unit:PERCENT .

ex1:00025 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "is_open" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff .

ex1:00026 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "is_closed" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff .

ex1:00027 a s223:ActuatableProperty,
        s223:Property,
        s223:QuantifiableActuatableProperty,
        s223:QuantifiableProperty,
        bob:PercentCommand ;
    rdfs:label "command" ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:unit unit:PERCENT .

ex1:00028 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Nm ;
    rdfs:label "torque" ;
    qudt:hasQuantityKind quantitykind:Torque ;
    qudt:unit unit:N-M .

ex1:00029 a p223:Actuator,
