    p223:actuatesProperty ex1:00023 ;
    p223:hasActuationLocation ex1:00017 ;
    p223:isCommandedBy ex1:00027 .

ex1:00030 a p223:Actuator,
        s223:Equipment ;
    rdfs:label "feedbackActuator" ;
