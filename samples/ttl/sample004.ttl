        ex1:00022 ;
    s223:hasProperty ex1:00023,
        ex1:00024,
        ex1:00025,
        ex1:00026,
        ex1:00027,
        ex1:00028 .

ex1:00017 a p223:MechanicalConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "actuator.linkageOutlet" ;
    s223:connectsThrough ex1:00040 ;
    s223:hasMedium p223:Medium-MechanicalCoupling ;
    s223:isConnectionPointOf ex1:00016 .

ex1:00018 a p223:AnalogOutput,
        s223:OutletConnectionPoint,
        bob:ModulationSignalConnectionPoint ;
    rdfs:label "actuator.feedback_signal" ;
    s223:hasMedium p223:Electricity-ModulationSignal ;
    s223:isConnectionPointOf ex1:00016 .

ex1:00019 a p223:BinaryOutput,
        s223:OutletConnectionPoint,
        bob:OnOffSignalConnectionPoint ;
    rdfs:label "actuator.open_auxswitch_signal" ;
