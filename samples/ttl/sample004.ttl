        ex1:00034 ;
    bob:airInlet ex1:00038 ;
    bob:airOutlet ex1:00039 ;
    bob:command ex1:00027 ;
    bob:hasSystemConnectionPoint ex1:00038,
        ex1:00039 .

ex1:00016 a s223:Equipment ;
    rdfs:label "actuator" ;
    s223:connectedThrough ex1:00040 ;
    s223:connectedTo ex1:00034 ;
    s223:contains ex1:00029,
