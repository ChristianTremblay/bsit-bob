# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample004
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/sample004/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample004> ;
  rdfs:label "sample004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a p223:HVACZone,
        s223:Zone ;
    rdfs:label "Zone" ;
    s223:contains ex1:00004 ;
    s223:hasDomain s223:Domain-HVAC ;
    s223:hasZoneConnectionPoint ex1:00002,
        ex1:00003 ;
    bob:airInlet ex1:00002 ;
    bob:airOutlet ex1:00003 .

ex1:00002 a s223:InletZoneConnectionPoint,
        s223:ZoneConnectionPoint ;
    rdfs:label "Zone.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex1:00005 .

ex1:00003 a s223:OutletZoneConnectionPoint,
        s223:ZoneConnectionPoint ;
    rdfs:label "Zone.airOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex1:00006 .

ex1:00004 a p223:HVACSpace,
        s223:DomainSpace ;
    rdfs:label "Domain_Space" ;
    s223:connectedFrom ex1:00015 ;
    s223:connectedThrough ex1:00019 ;
    s223:hasConnectionPoint ex1:00005,
        ex1:00006,
        ex1:00007,
        ex1:00008,
        ex1:00009,
        ex1:00010,
        ex1:00011 ;
    s223:hasDomain s223:Domain-HVAC ;
    s223:hasMedium s223:Medium-Air ;
    bob:airTransfer ex1:00007 ;
    bob:doors ex1:00008 ;
    bob:ductAirInlet ex1:00005 ;
    bob:ductAirOutlet ex1:00006 ;
    bob:radiantCooling ex1:00011 ;
    bob:radiantHeating ex1:00010 ;
    bob:windows ex1:00009 .

ex1:00005 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.ductAirInlet" ;
    s223:connectsThrough ex1:00019 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00006 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.ductAirOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00007 a s223:BidirectionalConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.airTransfer" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00008 a s223:BidirectionalConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.doors" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00009 a s223:BidirectionalConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.windows" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00010 a s223:BidirectionalConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.radiantHeating" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00011 a s223:BidirectionalConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.radiantCooling" ;
    s223:hasDirection s223:Direction-Bidirectional ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00004 .

ex1:00012 a s223:System,
        s223:VAV ;
    rdfs:label "VAV1" ;
    s223:contains ex1:00015 ;
    s223:hasSystemConnectionPoint ex1:00013,
        ex1:00014 ;
    bob:airInlet ex1:00013 ;
    bob:airOutlet ex1:00014 ;
    rdfs:comment "A VAV Box as a system" .

ex1:00013 a s223:InletSystemConnectionPoint,
        bob:AirSystemConnectionPoint ;
    rdfs:label "VAV1.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex1:00017 .

ex1:00014 a s223:OutletSystemConnectionPoint,
        bob:AirSystemConnectionPoint ;
    rdfs:label "VAV1.airOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex1:00018 .

ex1:00015 a s223:Damper,
        s223:Device ;
    rdfs:label "VAV1.damper" ;
    s223:connectedThrough ex1:00019 ;
    s223:connectedTo ex1:00004 ;
    s223:hasConnectionPoint ex1:00016,
        ex1:00017,
        ex1:00018 ;
    bob:airInlet ex1:00017 ;
    bob:airOutlet ex1:00018 ;
    bob:linkageInlet ex1:00016 .

ex1:00016 a p223:MechanicalConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "VAV1.damper.linkageInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium p223:Medium-MechanicalCoupling ;
    s223:isConnectionPointOf ex1:00015 .

ex1:00017 a s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VAV1.damper.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00015 .

ex1:00018 a s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VAV1.damper.airOutlet" ;
    s223:connectsThrough ex1:00019 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00015 .

ex1:00019 a s223:Connection ;
    rdfs:label "cnx" ;
    s223:connectsAt ex1:00005,
        ex1:00018 ;
    s223:connectsFrom ex1:00015 ;
    s223:connectsTo ex1:00004 ;
    s223:hasMedium s223:Medium-Air .

