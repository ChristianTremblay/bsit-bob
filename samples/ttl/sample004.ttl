ex1:00020 a p223:BinaryOutput,
        s223:OutletConnectionPoint,
        bob:OnOffSignalConnectionPoint ;
    rdfs:label "actuator.close_auxswitch_signal" ;
    s223:hasMedium p223:Electricity-OnOffSignal ;
    s223:isConnectionPointOf ex1:00016 .

ex1:00021 a s223:InletConnectionPoint,
        bob:Electricity_24V_60HzConnectionPoint ;
    rdfs:label "actuator.electricalInlet" ;
    s223:hasMedium p223:Electricity-24V-60Hz ;
    s223:isConnectionPointOf ex1:00016 .

ex1:00022 a p223:AnalogInput,
        s223:InletConnectionPoint,
