# imports: http://data.ashrae.org/standard223/1.0/model/all
@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/sample014_Motion/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://data.ashrae.org/standard223/1.0/data/sample014_Motion>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample014_Motion> ;
  rdfs:label "sample014_Motion" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .
ex1:00001 a s223:Device,
        s223:Sensor ;
    rdfs:label "Motion Sensor" ;
    s223:observesProperty ex1:00002 .
ex1:00002 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "Motion Sensor.Motion" ;
    s223:hasEnumerationKind p223:EnumerationKind-MotionNoMotion ;
    s223:ofMedium s223:Medium-Occupant .
ex1:00003 a s223:Device,
        s223:Sensor ;
    rdfs:label "People Counter" ;
    s223:observesProperty ex1:00004 .
ex1:00004 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Count ;
    rdfs:label "People Counter.Count" ;
    s223:ofMedium s223:Medium-Occupant ;
    qudt:hasQuantityKind quantitykind:Dimensionless ;
    qudt:unit unit:NUM .
