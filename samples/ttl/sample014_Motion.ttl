ex1:00008 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.radiantCooling" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00009 a s223:Connectable,
        s223:Equipment,
        s223:OccupantMotionSensor,
        s223:Sensor ;
    rdfs:label "Motion Sensor" ;
    s223:hasObservationLocation ex1:00001 ;
    s223:observes ex1:00010 .

ex1:00010 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "Motion Sensor.OccupantMotion" ;
    s223:hasEnumerationKind s223:Occupancy-Motion ;
    s223:ofMedium s223:Medium-Occupant .

ex1:00011 a s223:Connectable,
        s223:Equipment,
        s223:OccupantMotionSensor,
        s223:Sensor ;
    rdfs:label "People Counter" ;
    s223:hasObservationLocation ex1:00001 ;
    s223:hasProperty ex1:00012 ;
    s223:observes ex1:00013 ;
    s223:occupantCount ex1:00012 ;
    bob:contains ex1:00015 .

ex1:00012 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Count ;
    qudt:hasQuantityKind quantitykind:Dimensionless ;
    qudt:hasUnit unit:NUM .

ex1:00013 a s223:EnumerableProperty,
        s223:EnumeratedObservableProperty,
        s223:ObservableProperty,
        s223:Property ;
    rdfs:label "People Counter.OccupantMotion" ;
    s223:hasEnumerationKind s223:Occupancy-Motion ;
    s223:ofMedium s223:Medium-Occupant .

ex1:00014 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:Count ;
    rdfs:label "People Counter.OccupantCount" ;
    s223:ofMedium s223:Medium-Occupant ;
    qudt:hasQuantityKind quantitykind:Dimensionless ;
    qudt:hasUnit unit:NUM .

ex1:00015 a p223:Producer,
        bob:Causality ;
    rdfs:label "countProducer" ;
    s223:hasInput ex1:00016 ;
    s223:hasOutput ex1:00017 ;
    bob:cause_input ex1:00016 ;
    bob:effect_output ex1:00017 .

ex1:00016 a p223:ProducerInput ;
    rdfs:label "countProducer.cause_input" ;
    s223:uses ex1:00013 .

ex1:00017 a p223:ProducerOutput ;
    rdfs:label "countProducer.effect_output" ;
    s223:produces ex1:00012 .

