<http://data.ashrae.org/standard223/1.0/data/sample014_Motion>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample014_Motion> ;
  rdfs:label "sample014_Motion" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a p223:HVACSpace,
        s223:Connectable,
        s223:DomainSpace ;
    rdfs:label "Room 101" ;
    s223:cnx ex1:00002,
        ex1:00003,
        ex1:00004,
        ex1:00005,
        ex1:00006,
        ex1:00007,
        ex1:00008 ;
    s223:hasConnectionPoint ex1:00002,
        ex1:00003,
        ex1:00004,
        ex1:00005,
        ex1:00006,
        ex1:00007,
        ex1:00008 ;
    s223:hasDomain s223:Domain-HVAC ;
    bob:airTransfer ex1:00004 ;
    bob:doors ex1:00005 ;
    bob:ductAirInlet ex1:00002 ;
    bob:ductAirOutlet ex1:00003 ;
    bob:radiantCooling ex1:00008 ;
    bob:radiantHeating ex1:00007 ;
    bob:windows ex1:00006 .

ex1:00002 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.ductAirInlet" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00003 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.ductAirOutlet" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00004 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.airTransfer" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00005 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.doors" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00006 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.windows" ;
    s223:cnx ex1:00001 ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf ex1:00001 .

ex1:00007 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Room 101.radiantHeating" ;
    s223:cnx ex1:00001 ;
