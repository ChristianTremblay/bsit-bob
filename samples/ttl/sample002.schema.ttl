@prefix ex1: <urn:ex/sample002/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


ex1:Snork a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.Snork" ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:test ],
        [ a sh:PropertyShape ;
            sh:path ex1:temp ] .

ex1:Test a rdfs:Class ;
    rdfs:label "__main__.Test" .

ex1:temp a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

ex1:test a rdf:Property .

s223:Property sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofSubstance ],
        [ a sh:PropertyShape ;
            sh:path s223:hasValue ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ],
        [ a sh:PropertyShape ;
            sh:path s223:ofConstituent ] .

