    rdfs:label "bob.space.physical.Bathroom" ;
    rdfs:subClassOf s223:PhysicalSpace,
        rec:Room .

rec:Building a rdfs:Class ;
    rdfs:label "bob.space.physical.Building" ;
    rdfs:subClassOf s223:PhysicalSpace .

rec:Corridor a rdfs:Class ;
    rdfs:label "bob.space.physical.Corridor" ;
    rdfs:subClassOf s223:PhysicalSpace,
        rec:Room .

rec:Floor a rdfs:Class ;
    rdfs:label "bob.space.physical.Floor" ;
    rdfs:subClassOf s223:PhysicalSpace .

rec:Office a rdfs:Class ;
    rdfs:label "bob.space.physical.Office" ;
    rdfs:subClassOf s223:PhysicalSpace,
        rec:Room .

rec:Roof a rdfs:Class ;
    rdfs:label "bob.space.physical.Roof" ;
    rdfs:subClassOf s223:PhysicalSpace .

rec:Room a rdfs:Class ;
