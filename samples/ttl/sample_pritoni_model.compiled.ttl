    qudt:informativeReference "http://en.wikipedia.org/wiki/Potential_energy"^^xsd:anyURI ;
    qudt:latexDefinition "\\(V = -\\int F \\cdot dr\\), where \\(F\\) is a conservative force and \\(R\\) is a position vector."^^qudt:LatexString ;
