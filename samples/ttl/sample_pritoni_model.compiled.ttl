<http://qudt.org/vocab/dimensionvector/A0E0L4I0M1H0T-3D0> a qudt:QuantityKindDimensionVector_ISO,
        qudt:QuantityKindDimensionVector_Imperial,
        qudt:QuantityKindDimensionVector_SI ;
