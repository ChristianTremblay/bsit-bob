    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

qudt:rationale a rdf:Property ;
    rdfs:label "rationale" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

qudt:upperBound a rdf:Property ;
    rdfs:label "upper bound" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

qudt:url a rdf:Property ;
    rdfs:label "url" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> .

qudt:value a rdf:Property ;
    rdfs:label "value" ;
    dcterms:description "A property to relate an observable thing with a value that can be of any simple XSD type"^^rdf:HTML ;
