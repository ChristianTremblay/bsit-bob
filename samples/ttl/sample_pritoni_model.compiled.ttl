unit:RT a qudt:Unit ;
    rdfs:label "Register Ton"@en ;
    dcterms:description "The register ton is a unit of volume used for the cargo capacity of a ship, defined as 100 cubic feet (roughly 2.83 cubic metres)."^^rdf:HTML ;
