    qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31898"^^xsd:anyURI ;
    qudt:symbol "E" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

