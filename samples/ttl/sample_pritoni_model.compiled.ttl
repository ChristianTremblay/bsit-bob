qudt:dimensionExponentForThermodynamicTemperature a rdf:Property ;
    rdfs:label "dimension exponent for thermodynamic temperature" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/shacl/qudt> ;
