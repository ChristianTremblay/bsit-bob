    qudt:informativeReference "http://en.wikipedia.org/wiki/Deca?oldid=480093935"^^xsd:anyURI ;
    qudt:prefixMultiplier 1e+01 ;
    qudt:symbol "da" ;
    qudt:ucumCode "da" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/prefix> .

