        unit:TONNE-PER-M3,
        unit:TON_Metric-PER-M3,
        unit:TON_UK-PER-YD3,
        unit:TON_US-PER-YD3 ;
    qudt:baseUnitDimensions "\\(kg m^{-3}\\)"^^qudt:LatexString ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0> ;
