    qudt:uneceCommonCode "J42" ;
    qudt:unitOfSystem <http://qudt.org/vocab/sou/IMPERIAL> ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    owl:sameAs unit:BTU_IT-IN-PER-SEC-FT2-DEG_F .

