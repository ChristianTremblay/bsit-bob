    qudt:ucumCode "A.m-2.K-1"^^qudt:UCUMcs,
        "A/(m2.K)"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "A6" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:A-PER-MilliM2 a qudt:Unit ;
    rdfs:label "Ampere Per Square Millimetre"@en,
