        qudt:Unit ;
    rdfs:label "BTU per Square Foot"@en ;
    dcterms:description "\\(\\textbf{BTU per Square Foot}\\) is an Imperial unit for  'Energy Per Area' expressed as \\(Btu/ft^2\\)."^^qudt:LatexString ;
