unit:NanoM a qudt:Unit ;
    rdfs:label "Nanometre"@en,
        "Nanometer"@en-us ;
    qudt:conversionMultiplier 0.000000001 ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0> ;
