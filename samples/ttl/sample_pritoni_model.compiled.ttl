    qudt:hasQuantityKind quantitykind:LiquidVolume ;
    qudt:symbol "gal" ;
    qudt:ucumCode "[gal_us]"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "GLL" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:altLabel "Queen Anne's wine gallon" .

