quantitykind:SpecificEnergyImparted a qudt:QuantityKind ;
    rdfs:label "Specific Energy Imparted"@en ;
    qudt:applicableUnit unit:BTU_IT-PER-LB,
        unit:BTU_TH-PER-LB,
        unit:CAL_IT-PER-GM,
        unit:CAL_TH-PER-G,
        unit:CAL_TH-PER-GM,
