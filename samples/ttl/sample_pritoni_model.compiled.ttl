unit:GigaHZ-M a qudt:Unit,
        unit:Unit ;
    rdfs:label "Gigahertz Metre"@en,
        "Gigahertz Meter"@en-us ;
    qudt:conversionMultiplier 1000000000.0 ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0> ;
