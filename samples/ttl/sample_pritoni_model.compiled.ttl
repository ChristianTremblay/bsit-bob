quantitykind:OsmoticPressure a qudt:QuantityKind ;
    rdfs:label "Osmotic Pressure"@en ;
    qudt:applicableUnit unit:ATM,
        unit:ATM_T,
        unit:BAR,
        unit:BARAD,
        unit:BARYE,
        unit:CM_H2O,
        unit:CentiBAR,
