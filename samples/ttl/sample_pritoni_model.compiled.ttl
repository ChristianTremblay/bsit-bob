            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:filePrefix ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:description ],
        owl:Thing .

