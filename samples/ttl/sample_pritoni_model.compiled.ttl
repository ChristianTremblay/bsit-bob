    qudt:latexDefinition "\\(M Θ\\)"^^qudt:LatexString ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/dimensionvector> .

<http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0> a qudt:QuantityKindDimensionVector_CGS,
