    qudt:informativeReference "http://en.wikipedia.org/wiki/Sound_power"^^xsd:anyURI ;
    qudt:latexDefinition "\\(P_a = IA\\), where \\(I\\) is the sound intensity in \\(\\frac{W}{m^2}\\) and \\(A\\) is the area in \\(m^2\\)."^^qudt:LatexString ;
