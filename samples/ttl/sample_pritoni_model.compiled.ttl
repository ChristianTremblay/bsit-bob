ns1:and a ns2:Function ;
    rdfs:label "and" ;
    ns2:constraint [ a ns3:Argument ;
            ns3:predicate ns1:arg1 ;
            ns3:valueType xsd:boolean ;
            rdfs:comment "the first operand of the intersection" ],
        [ a ns3:Argument ;
            ns3:predicate ns1:arg2 ;
            ns3:valueType xsd:boolean ;
            rdfs:comment "the second operand of the intersection" ] ;
    ns2:returnType xsd:boolean ;
    ns2:symbol "&&" ;
    rdfs:comment "Return the logical AND between two (boolean) operands." ;
    rdfs:subClassOf ns3:BooleanFunctions .

