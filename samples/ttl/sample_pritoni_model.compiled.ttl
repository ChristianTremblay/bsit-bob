        "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI ;
    qudt:latexDefinition "\\(\\rho = \\frac{dm}{dV}\\), where \\(m\\) is mass and \\(V\\) is volume."^^qudt:LatexString ;
