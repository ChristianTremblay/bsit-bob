    qudt:ucumCode "C.kg-1"^^qudt:UCUMcs,
        "C/kg"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "CKG" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

