    ns2:constraint [ a ns3:Argument ;
            ns3:predicate ns1:arg1 ;
            ns3:valueType xsd:string ;
            rdfs:comment "The input string." ] ;
    ns2:returnType xsd:string ;
    ns2:symbol "UCASE" ;
    rdfs:comment "Converts a string to upper case characters." ;
    rdfs:seeAlso <http://www.w3.org/TR/sparql11-query/#func-ucase> ;
    rdfs:subClassOf ns3:StringFunctions .

ns1:unaryMinus a ns2:Function ;
