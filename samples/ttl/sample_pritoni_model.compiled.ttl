    rdfs:subClassOf qudt:Aspect ;
    sh:property qudt:Verifiable-dbpediaMatch,
        qudt:Verifiable-informativeReference,
        qudt:Verifiable-isoNormativeReference,
        qudt:Verifiable-normativeReference .

