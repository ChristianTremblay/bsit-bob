        "inHg"^^xsd:string ;
    qudt:ucumCode "[in_i'Hg]"^^qudt:UCUMcs ;
    qudt:udunitsCode "inHg",
        "in_Hg" ;
    qudt:uneceCommonCode "F79" ;
    qudt:unitOfSystem <http://qudt.org/vocab/sou/USCS> ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

