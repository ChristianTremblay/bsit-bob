    rdfs:label "as" ;
    rdfs:comment "Points to a Variable used in an AS statement such as COUNT aggregates." ;
    rdfs:range ns1:Variable ;
    rdfs:subPropertyOf ns1:systemProperty .

ns1:bindings a rdf:Property ;
    rdfs:label "bindings" ;
    rdfs:comment "The actual bindings of a sp:Values element." ;
    rdfs:domain ns1:Values ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf ns1:systemProperty .

