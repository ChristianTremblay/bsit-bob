unit:PlanckVolt a qudt:Unit,
        unit:Unit ;
    rdfs:label "Planck Volt"@en ;
    qudt:conversionMultiplier 1042950000000000000000000000.0 ;
    qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/PLANCK> ;
