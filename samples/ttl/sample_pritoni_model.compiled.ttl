    qudt:hasQuantityKind quantitykind:Area ;
    qudt:iec61360Code "0112/2///62720#UAB049" ;
    qudt:plainTextDescription "unit of the area which is mainly common in the agriculture and forestry: 1 da = 10 a" ;
