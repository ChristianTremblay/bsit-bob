    qudt:hasQuantityKind quantitykind:MassFlowRate,
        quantitykind:MassPerTime ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Pound_per_hour?oldid=328571072"^^xsd:anyURI ;
