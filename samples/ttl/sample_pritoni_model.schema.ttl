p223:AirHandlingUnit a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.hvac.airhandlingunit.AirHandlingUnit" ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:supplyAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:electricalInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:exhaustAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:returnAirInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:outsideAirInlet ] .

