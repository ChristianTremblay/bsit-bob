    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasValue ],
        [ a sh:PropertyShape ;
            sh:class s223:Constituent ;
            sh:path s223:ofMedium ] .

bob:Differential a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.producer.causality.Differential" ;
    rdfs:comment """
    This causality block goals explain that the output is the result
    of substracting high input and low input.
    """ ;
    rdfs:subClassOf p223:Producer ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:high_input ],
        [ a sh:PropertyShape ;
            sh:path bob:differential_output ],
        [ a sh:PropertyShape ;
            sh:path bob:low_input ] .

