p223:ActiveInactive-Active a p223:ActiveInactive-Active,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Active" ;
    rdfs:subClassOf p223:EnumerationKind-ActiveInactive,
        s223:EnumerationKind .

