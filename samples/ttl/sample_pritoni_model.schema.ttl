bob:ZoneConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirZoneConnectionPoint",
        "bob.core.ZoneConnectionPoint" ;
    rdfs:comment """
    Zone Connection Point
    """ ;
    rdfs:subClassOf bob:ZoneConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:mapsTo ],
        [ a sh:PropertyShape ;
            sh:path bob:isZoneConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

functions:Average a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "functions.Average" ;
    rdfs:comment """
    y = (u1 + u2) / 2.0
    """ ;
    rdfs:subClassOf s223:FunctionBlock ;
    sh:property [ a sh:PropertyShape ;
            sh:path functions:u1 ],
        [ a sh:PropertyShape ;
            sh:path functions:u2 ],
        [ a sh:PropertyShape ;
            sh:path functions:y ] .

