    rdfs:label "bob.space.physical.Floor" ;
    rdfs:subClassOf s223:PhysicalSpace .

rec:Office a rdfs:Class ;
    rdfs:label "bob.space.physical.Office" ;
    rdfs:subClassOf s223:PhysicalSpace,
        rec:Room .

rec:Roof a rdfs:Class ;
    rdfs:label "bob.space.physical.Roof" ;
    rdfs:subClassOf s223:PhysicalSpace .

rec:Room a rdfs:Class ;
    rdfs:label "bob.space.physical.Room" ;
    rdfs:subClassOf s223:PhysicalSpace .

ref:ExternalReference a rdfs:Class ;
    rdfs:label "bob.core.ExternalReference" ;
    rdfs:comment """
    This will be subclassed by different specific datasources, this simplest
    form uses hasRef as a literal, most likely a string.  Note that this is
    currently from the Brick "ref" schema.
    """ .

ref:hasExternalReference a rdf:Property .

