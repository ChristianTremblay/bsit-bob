bob:SinglePoleCircuitBreaker a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.distribution.SinglePoleCircuitBreaker" ;
    rdfs:comment """
    One inlet and one outlet
    hasMaxRange = current max of breaker
    A rule could check inlet and outlet are same class

    208V single pole available in the High Leg Configuration
    """ ;
    rdfs:subClassOf p223:ElectricalCircuitBreaker,
        s223:Connectable,
        s223:Equipment .

bob:SinglePoleSwitch a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.switch.SinglePoleSwitch" ;
    rdfs:comment """
    One inlet and one outlet
    hasMaxRange = current max of switch
    A rule could check inlet and outlet are same class
    """ ;
    rdfs:subClassOf p223:ElectricalSwitch,
        s223:Connectable,
        s223:Equipment .

bob:SystemConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.SystemConnectionPoint" ;
    rdfs:comment """
    System Connection Point
    """ ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:isSystemConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ],
        [ a sh:PropertyShape ;
            sh:path bob:mapsTo ] .

bob:Temperature a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.temperature.Temperature" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ],
        [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

bob:ThreePolesCircuitBreaker a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.distribution.ThreePolesCircuitBreaker" ;
    rdfs:comment """
    One electrical Inlet because when plugin the breaker
    in the panel, you get no choice. Three poles are connected
    at the same time. Electricity is fed from 3 bus bars
    """ ;
    rdfs:subClassOf p223:ElectricalCircuitBreaker,
        s223:Connectable,
        s223:Equipment .

bob:ThreePolesMainCircuitBreaker a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.distribution.ThreePolesMainCircuitBreaker" ;
    rdfs:comment """
    One electrical Inlet because when plugin the breaker
    in the panel, you get no choice. Three poles are connected
    at the same time. Electricity is fed from 3 bus bar (3 x 347V to neutral for example)

    Code do not allow to use only one pole of a 3phase breaker. So
    this model is just a trick so we can feed 3 bus bar (connect) inside the panel.
    If not, we would have 3 connections coming from vaccuum of space.

    """ ;
    rdfs:subClassOf p223:ElectricalCircuitBreaker,
        s223:Connectable,
        s223:Equipment .

bob:TimerSwitch a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.electricity.switch.TimerSwitch" ;
    rdfs:comment """
    Manuel switch with integrated timer
    Typically used for exhaust fan in bathrooms for example
    """ ;
    rdfs:subClassOf p223:ElectricalSwitch,
        s223:Connectable,
        s223:Equipment,
        bob:SinglePoleSwitch ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:onOffCommand ],
        [ a sh:PropertyShape ;
            sh:path bob:onOffStatus ],
        [ a sh:PropertyShape ;
            sh:path bob:delay ] .

bob:TwoPolesCircuitBreaker a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.distribution.TwoPolesCircuitBreaker" ;
    rdfs:comment """
    One electrical Inlet because when plugin the breaker
    in the panel, you get no choice. Both poles are connected
    at the same time. Electricity is fed from 2 bus bar (2 x 120V)
    Could also use 208V instead of 240V...
    """ ;
    rdfs:subClassOf p223:ElectricalCircuitBreaker,
        s223:Connectable,
        s223:Equipment .

bob:TwoPolesMainCircuitBreaker a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.distribution.TwoPolesMainCircuitBreaker" ;
    rdfs:comment """
    A 2 poles Main circuit breaker is modeled differently as I
    wanted to illustrate the fact that it will be connected to
    the 2 bus bars in the panel (A & B) and will also be connected
    to AB. It is really a modeling trick.
    """ ;
    rdfs:subClassOf p223:ElectricalCircuitBreaker,
        s223:Connectable,
        s223:Equipment .

bob:TwoWayActuatedProportionalValve a rdfs:Class ;
    rdfs:label "bob.equipment.hvac.valve.TwoWayActuatedProportionalValve" ;
    rdfs:subClassOf s223:System .

bob:VFDFunctionBlock a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.electricity.vfd.VFD_FB" ;
