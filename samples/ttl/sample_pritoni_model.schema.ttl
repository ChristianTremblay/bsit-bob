            sh:path bob:rpm ],
        [ a sh:PropertyShape ;
            sh:path bob:speed_ref ],
        [ a sh:PropertyShape ;
            sh:path bob:speed_ref_percent ],
        [ a sh:PropertyShape ;
            sh:path bob:kW_load ],
        [ a sh:PropertyShape ;
            sh:path bob:amps_load ],
        [ a sh:PropertyShape ;
            sh:path bob:frequency_load ],
        [ a sh:PropertyShape ;
            sh:path bob:drive_running ],
        [ a sh:PropertyShape ;
            sh:path bob:alarm ] .

