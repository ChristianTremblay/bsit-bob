s223:Equipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.Equipment",
        "bob.equipment.electricity._MotorStarter",
        "bob.equipment.hvac.actuator.BaseActuator",
        "bob.equipment.hvac.actuator.ElectricalProportionalActuator" ;
    rdfs:comment """
    A Equipment is normally a physical entity that one might buy from a vendor - a tangible object designed to accomplish a specific task.
    """,
        """
    This is required here so actuatesProperty gets its namespace from S223
    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:command ],
        [ a sh:PropertyShape ;
            sh:path bob:is_open ],
        [ a sh:PropertyShape ;
            sh:path bob:position ],
        [ a sh:PropertyShape ;
            sh:path bob:command ],
        [ a sh:PropertyShape ;
            sh:path s223:actuatesProperty ],
        [ a sh:PropertyShape ;
            sh:path bob:position_feedback ],
        [ a sh:PropertyShape ;
            sh:path bob:is_closed ],
        [ a sh:PropertyShape ;
            sh:path s223:hasPhysicalLocation ] .

s223:ExternalReference a rdfs:Class ;
    rdfs:label "bob.core.ExternalReference" ;
