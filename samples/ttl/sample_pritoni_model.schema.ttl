p223:Boiler a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.hvac.boiler.ElectricalHotWaterBoiler",
        "bob.equipment.hvac.boiler.HotWaterBoiler" ;
    rdfs:subClassOf p223:Boiler,
        s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:hotWaterEntering ],
        [ a sh:PropertyShape ;
            sh:path bob:electricalInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:hotWaterLeaving ] .

p223:CurrentRelay a rdfs:Class ;
    rdfs:label "bob.equipment.electricity.switch.CurrentRelay" ;
    rdfs:comment """
    Current detection Equipment that gives a OnOff status by the action
    of a dry contact when electricity is detected.

    This serves as motor status sensor

    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

