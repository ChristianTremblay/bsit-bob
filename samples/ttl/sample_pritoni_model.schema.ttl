p223:ElectricalDistributionPanel a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.equipment.electricity.distribution.SinglePhaseDistributionPanel",
        "bob.equipment.electricity.distribution.ThreePhaseDistributionPanel" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:number_of_circuits ],
        [ a sh:PropertyShape ;
            sh:path bob:modelNumber ],
        [ a sh:PropertyShape ;
            sh:path bob:manufacturer ],
        [ a sh:PropertyShape ;
