p223:OccupancyFunction a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.producer.occupancy.OccupancyFunction" ;
    rdfs:comment """
    This function takes the the occupancy as detected by a sensor (inStatus,
    perhaps from a motion sensor), the occupancy schedule (inSchedule with
    an external reference to a BACnet Schedule Object) and outputs
    "occupied" if the space/room/zone should be considered occupied.
    """ ;
    rdfs:subClassOf s223:Function ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:outStatus ],
        [ a sh:PropertyShape ;
            sh:path bob:inOccSensor ],
        [ a sh:PropertyShape ;
            sh:path bob:inStatus ],
        [ a sh:PropertyShape ;
            sh:path bob:inLocalOverride ],
        [ a sh:PropertyShape ;
            sh:path bob:inSchedule ] .

