    sh:property [ a sh:PropertyShape ;
            sh:path scratch:airInlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:damper ],
        [ a sh:PropertyShape ;
            sh:path scratch:airOutlet ] .

scratch:TwoWayActuatedProportionalValve a rdfs:Class ;
