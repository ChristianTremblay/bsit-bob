functions:Average a rdfs:Class ;
    rdfs:label "functions.Average" ;
    rdfs:comment """
    y = (u1 + u2) / 2.0
    """ ;
    rdfs:subClassOf s223:FunctionBlock .

functions:u1 a rdf:Property .

functions:u2 a rdf:Property .

functions:y a rdf:Property .

