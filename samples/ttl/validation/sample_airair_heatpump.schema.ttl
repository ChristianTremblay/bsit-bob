<http://data.ashrae.org/standard223/1.0/data/sample_airair_heatpump>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample_airair_heatpump-schema> ;
  rdfs:label "sample_airair_heatpump-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

bob:AirConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:AirTemperatureSensor a rdfs:Class ;
    rdfs:label "bob.sensor.temperature.AirTemperatureSensor" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Sensor,
        s223:TemperatureSensor .

bob:Amps a rdfs:Class ;
    rdfs:label "bob.properties.electricity.Amps" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:ElectricPower a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.electricity.ElectricPower" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

bob:ElectricPowerkW a rdfs:Class ;
    rdfs:label "bob.properties.electricity.ElectricPowerkW" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower .

bob:Flow a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.flow.Flow" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path bob:measuresMedium ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ] .

bob:HP a rdfs:Class ;
    rdfs:label "bob.properties.force.HP" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:Percent a rdfs:Class ;
    rdfs:label "bob.properties.ratio.Percent" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:PercentCommand a rdfs:Class ;
    rdfs:label "bob.properties.ratio.PercentCommand" ;
    rdfs:subClassOf s223:ActuatableProperty,
        s223:Property,
        s223:QuantifiableActuatableProperty,
        s223:QuantifiableProperty .

bob:PowerFactor a rdfs:Class ;
    rdfs:label "bob.properties.electricity.PowerFactor" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:Pressure a rdfs:Class ;
    rdfs:label "bob.properties.force.Pressure" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:RPM a rdfs:Class ;
    rdfs:label "bob.properties.ratio.RPM" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:RefrigerantConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.refrigerant.RefrigerantConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:Temperature a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.temperature.Temperature" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ] .

bob:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:alarmStatus a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:command a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:differentialPressure a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:dischargePort a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:dischargePressure a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:flowCoefficient a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:gasPortA a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:gasPortB a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:isObservedBy a rdf:Property .

bob:linkageInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:measuresMedium a rdf:Property .

bob:modulation a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:onOffCommand a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:onOffStatus a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:portA a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:portB a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:position a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:position_feedback a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:refrigerantHighPressureInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:refrigerantIndoorCoilPort a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:refrigerantLowPressureOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:refrigerantOutdoorCoilPort a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:returnPort a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:succionPressure a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

