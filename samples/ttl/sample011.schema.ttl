@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/sample011/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


bob:hasSystemConnectionPoint a rdf:Property .

bob:isSystemConnectionPointOf a rdf:Property .

bob:mapsTo a rdf:Property .

ex1:TestEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpOut ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpIn ] .

ex1:TestSystem a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestSystem" ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpIn ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpOut ] .

ex1:cpIn a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint,
        bob:hasSystemConnectionPoint .

ex1:cpOut a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint,
        bob:hasSystemConnectionPoint .

s223:Connectable a rdfs:Class ;
    rdfs:label "bob.core.Connectable" ;
    rdfs:comment """
    A type of thing that can have connection points.
    """ .

s223:ConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.ConnectionPoint" ;
    rdfs:comment """
    Connection Point
    """ ;
    sh:property [ a sh:PropertyShape ;
            sh:path s223:mapsTo ],
        [ a sh:PropertyShape ;
            sh:path s223:connectsThrough ],
        [ a sh:PropertyShape ;
            sh:path s223:isConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

s223:Direction-Bidirectional a s223:Direction-Bidirectional,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Bidirectional" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Direction .

s223:Direction-Inlet a s223:Direction-Inlet,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Inlet" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Direction .

s223:Direction-Outlet a s223:Direction-Outlet,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Outlet" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Direction .

s223:EM-Light a s223:EM-Light,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Light" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium,
        s223:Medium-EM .

s223:EM-Microwave a s223:EM-Microwave,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "Microwave" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium,
        s223:Medium-EM .

s223:EM-RF a s223:EM-RF,
        s223:EnumerationKind,
        rdfs:Class ;
    rdfs:label "RF" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium,
        s223:Medium-EM .

s223:EnumerationKind a rdfs:Class ;
    rdfs:label "bob.core.EnumerationKind" .

s223:EnumerationKind-Direction a s223:EnumerationKind,
        s223:EnumerationKind-Direction,
        rdfs:Class ;
    rdfs:label "Direction" ;
    rdfs:subClassOf s223:EnumerationKind .

s223:EnumerationKind-Domain a s223:EnumerationKind,
        s223:EnumerationKind-Domain,
        rdfs:Class ;
    rdfs:label "Domain" ;
    rdfs:subClassOf s223:EnumerationKind .

s223:EnumerationKind-Medium a s223:EnumerationKind,
        s223:EnumerationKind-Medium,
        rdfs:Class ;
    rdfs:label "Medium" ;
    rdfs:subClassOf s223:EnumerationKind .

s223:EnumerationKind-Role a s223:EnumerationKind,
        s223:EnumerationKind-Role,
        rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf s223:EnumerationKind .

s223:EnumerationKind-Substance a s223:EnumerationKind,
        s223:EnumerationKind-Substance,
        rdfs:Class ;
    rdfs:label "Substance" ;
    rdfs:subClassOf s223:EnumerationKind .

s223:Equipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.Equipment" ;
    rdfs:comment """
    A Equipment is normally a physical entity that one might buy from a vendor - a tangible object designed to accomplish a specific task.
    """ ;
    rdfs:subClassOf s223:Connectable ;
    sh:property [ a sh:PropertyShape ;
            sh:path s223:hasPhysicalLocation ] .

s223:InletConnectionPoint a rdfs:Class ;
    rdfs:label "bob.core.InletConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint .

s223:Medium-Air a s223:EnumerationKind,
        s223:Medium-Air,
        rdfs:Class ;
    rdfs:label "Air" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-EM a s223:EnumerationKind,
        s223:Medium-EM,
        rdfs:Class ;
    rdfs:label "EM" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-Electricity a s223:EnumerationKind,
        s223:Medium-Electricity,
        rdfs:Class ;
    rdfs:label "Electricity" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-Glycol a s223:EnumerationKind,
        s223:Medium-Glycol,
        rdfs:Class ;
    rdfs:label "Glycol" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-NaturalGas a s223:EnumerationKind,
        s223:Medium-NaturalGas,
        rdfs:Class ;
    rdfs:label "NaturalGas" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-Occupant a s223:EnumerationKind,
        s223:Medium-Occupant,
        rdfs:Class ;
    rdfs:label "Occupant" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:Medium-Water a s223:EnumerationKind,
        s223:Medium-Water,
        rdfs:Class ;
    rdfs:label "Water" ;
    rdfs:subClassOf s223:EnumerationKind,
        s223:EnumerationKind-Medium .

s223:OutletConnectionPoint a rdfs:Class ;
    rdfs:label "bob.core.OutletConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint .

s223:System a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.System" ;
    rdfs:comment """
    System
    """ ;
    sh:property [ a sh:PropertyShape ;
            sh:path s223:hasPhysicalLocation ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasDomain ],
        [ a sh:PropertyShape ;
            sh:path bob:hasSystemConnectionPoint ] .

bob:InletSystemConnectionPoint a rdfs:Class ;
    rdfs:label "bob.core.InletSystemConnectionPoint" ;
    rdfs:subClassOf bob:SystemConnectionPoint .

bob:OutletSystemConnectionPoint a rdfs:Class ;
    rdfs:label "bob.core.OutletSystemConnectionPoint" ;
    rdfs:subClassOf bob:SystemConnectionPoint .

bob:SystemConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.SystemConnectionPoint" ;
    rdfs:comment """
    System Connection Point
    """ ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:mapsTo ],
        [ a sh:PropertyShape ;
            sh:path bob:isSystemConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

s223:connectsThrough a rdf:Property .

s223:hasDomain a rdf:Property .

s223:hasMedium a rdf:Property .

s223:hasPhysicalLocation a rdf:Property .

s223:isConnectionPointOf a rdf:Property .

s223:mapsTo a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

