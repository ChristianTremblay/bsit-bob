@prefix ex1: <urn:ex/sample011/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


ex1:TestEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpOut ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpIn ] .

ex1:TestSystem a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestSystem" ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpIn ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpOut ] .

ex1:cpIn a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

ex1:cpOut a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

