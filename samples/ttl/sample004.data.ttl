# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample004
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/sample004/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample004>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample004> ;
  rdfs:label "sample004" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a s223:Zone,
        bob:HVACZone ;
    rdfs:label "Zone" ;
    s223:hasDomain s223:Domain-HVAC ;
    s223:hasDomainSpace ex1:00005 ;
    bob:airInlet ex1:00002 ;
    bob:airOutlet ex1:00003 ;
    bob:hasZoneConnectionPoint ex1:00002,
        ex1:00003 .

ex1:00002 a bob:InletZoneConnectionPoint,
        bob:ZoneConnectionPoint ;
    rdfs:label "Zone.airInlet" ;
    s223:hasMedium p223:Fluid-Air .

ex1:00003 a bob:OutletZoneConnectionPoint,
        bob:ZoneConnectionPoint ;
    rdfs:label "Zone.airOutlet" ;
    s223:hasMedium p223:Fluid-Air .

ex1:00004 a s223:PhysicalSpace ;
    rdfs:label "Room 191" ;
    s223:encloses ex1:00005 .

ex1:00005 a s223:Connectable,
        s223:DomainSpace,
        bob:HVACSpace ;
    rdfs:label "Domain_Space" ;
    s223:cnx ex1:00006,
        ex1:00007,
        ex1:00008,
        ex1:00009,
        ex1:00010,
        ex1:00011,
        ex1:00012 ;
    s223:hasConnectionPoint ex1:00006,
        ex1:00007,
        ex1:00008,
        ex1:00009,
        ex1:00010,
        ex1:00011,
        ex1:00012 ;
    s223:hasDomain s223:Domain-HVAC ;
    bob:airTransfer ex1:00008 ;
    bob:doors ex1:00009 ;
    bob:ductAirInlet ex1:00006 ;
    bob:ductAirOutlet ex1:00007 ;
    bob:radiantCooling ex1:00012 ;
    bob:radiantHeating ex1:00011 ;
    bob:windows ex1:00010 .

ex1:00006 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.ductAirInlet" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00007 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.ductAirOutlet" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00008 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.airTransfer" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00009 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.doors" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00010 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.windows" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00011 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.radiantHeating" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00012 a s223:BidirectionalConnectionPoint,
        s223:ConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "Domain_Space.radiantCooling" ;
    s223:cnx ex1:00005 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00005 .

ex1:00013 a s223:Connectable,
        s223:Equipment,
        s223:SingleDuctTerminal ;
    rdfs:label "VAV1" ;
    s223:cnx ex1:00014,
        ex1:00015 ;
    s223:contains ex1:00016 ;
    s223:hasConnectionPoint ex1:00014,
        ex1:00015 ;
    bob:airInlet ex1:00014 ;
    bob:airOutlet ex1:00015 ;
    rdfs:comment "A VAV Box as a system" .

ex1:00014 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VAV1.airInlet" ;
    s223:cnx ex1:00013 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00013 .

ex1:00015 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "VAV1.airOutlet" ;
    s223:cnx ex1:00013 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00013 .

ex1:00016 a s223:Connectable,
        s223:Damper,
        s223:Equipment ;
    rdfs:label "damper" ;
    s223:cnx ex1:00017,
        ex1:00018 ;
    s223:hasConnectionPoint ex1:00017,
        ex1:00018 ;
    bob:airInlet ex1:00017 ;
    bob:airOutlet ex1:00018 ;
    rdfs:comment "VAV Box Damper including" .

ex1:00017 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "damper.airInlet" ;
    s223:cnx ex1:00016 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00016 ;
    s223:mapsTo ex1:00014 .

ex1:00018 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "damper.airOutlet" ;
    s223:cnx ex1:00016 ;
    s223:hasMedium p223:Fluid-Air ;
    s223:isConnectionPointOf ex1:00016 ;
    s223:mapsTo ex1:00015 .

