                s223:QuantifiableProperty ;
            rdfs:label "GlycolSolution-15Percent.Constituent-Glycol" ;
            s223:hasValue 15 ;
            s223:ofConstituent p223:Constituent-Glycol ;
            qudt:hasQuantityKind quantitykind:VolumeFraction ;
            qudt:hasUnit unit:PERCENT ],
        [ a s223:Property,
                s223:QuantifiableProperty ;
            rdfs:label "GlycolSolution-15Percent.Constituent-H2O" ;
            s223:hasValue 85 ;
            s223:ofConstituent p223:Constituent-H2O ;
