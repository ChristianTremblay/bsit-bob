@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex1: <urn:ex/sample008/> .
@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


bob:AirConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:AirSystemConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirSystemConnectionPoint" ;
    rdfs:subClassOf bob:SystemConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:InletSystemConnectionPoint a rdfs:Class ;
    rdfs:label "bob.connections.air.AirInletSystemConnectionPoint",
        "bob.core.InletSystemConnectionPoint" ;
    rdfs:subClassOf bob:AirSystemConnectionPoint,
        bob:InletSystemConnectionPoint,
        bob:SystemConnectionPoint .

bob:OutletSystemConnectionPoint a rdfs:Class ;
    rdfs:label "bob.connections.air.AirOutletSystemConnectionPoint",
        "bob.core.OutletSystemConnectionPoint" ;
    rdfs:subClassOf bob:AirSystemConnectionPoint,
        bob:OutletSystemConnectionPoint,
        bob:SystemConnectionPoint .

bob:SystemConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.core.SystemConnectionPoint" ;
    rdfs:comment """
    System Connection Point
    """ ;
    sh:property [ a sh:PropertyShape ;
            sh:path bob:mapsTo ],
        [ a sh:PropertyShape ;
            sh:path bob:isSystemConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:hasSystemConnectionPoint a rdf:Property .

bob:isSystemConnectionPointOf a rdf:Property .

bob:mapsTo a rdf:Property .

ex1:TestEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestEquipment" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cp ] .

ex1:TestSystem a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.TestSystem" ;
    rdfs:subClassOf s223:System ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex1:cpO ],
        [ a sh:PropertyShape ;
            sh:path ex1:cpI ] .

ex1:cp a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex1:cpI a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

ex1:cpO a rdf:Property ;
    rdfs:subPropertyOf bob:hasSystemConnectionPoint .

