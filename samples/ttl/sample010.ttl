    s223:mapsTo ex1:00003 .

ex1:00008 a bob:AirSystemConnectionPoint,
        bob:InletSystemConnectionPoint ;
    rdfs:label "s2.cp" ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex1:00004 .

ex1:00009 a s223:Connection ;
    rdfs:label "cnx" ;
    s223:connectsAt ex1:00003,
        ex1:00004 ;
    s223:connectsFrom ex1:00001 ;
    s223:connectsTo ex1:00002 ;
    s223:hasMedium s223:Medium-Air .

ex1:00010 a s223:Equipment ;
    rdfs:label "d3" ;
    s223:connectedThrough ex1:00018 ;
    s223:connectedTo ex1:00011 ;
    s223:hasConnectionPoint ex1:00012 .

ex1:00011 a s223:Equipment ;
    rdfs:label "d4" ;
    s223:connectedFrom ex1:00010 ;
    s223:connectedThrough ex1:00018 ;
    s223:hasConnectionPoint ex1:00013 .

ex1:00012 a s223:OutletConnectionPoint,
