  rdfs:label "sample010" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a s223:Equipment ;
    rdfs:label "d1" ;
    s223:connectedThrough ex1:00009 ;
    s223:connectedTo ex1:00002 ;
    s223:hasConnectionPoint ex1:00003 .

ex1:00002 a s223:Equipment ;
    rdfs:label "d2" ;
