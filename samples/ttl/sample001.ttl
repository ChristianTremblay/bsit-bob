# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample001
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex1: <urn:ex/sample001/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




<http://data.ashrae.org/standard223/1.0/data/sample001>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample001> ;
  rdfs:label "sample001" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex1:00001 a s223:Equipment,
        ex1:SampleEquipment ;
    rdfs:label "Test Equipment 1" ;
    s223:hasProperty ex1:00002 .

ex1:00002 a s223:Property,
        s223:QuantifiableProperty,
        ex1:TemperatureProperty ;
    rdfs:label "temp" ;
    s223:hasValue 75.5 ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:unit unit:DEG_F .

ex1:00003 a s223:Equipment,
        ex1:SampleEquipment ;
    rdfs:label "Test Equipment 2" ;
    s223:hasProperty ex1:00004 .

ex1:00004 a s223:Property,
        s223:QuantifiableProperty,
        ex1:TemperatureProperty ;
    rdfs:label "temp" ;
    s223:hasValue 90.5 ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:unit unit:DEG_F .

ex1:00005 a s223:Equipment,
        ex1:SampleEquipment2 ;
    rdfs:label "Test Equipment 3" ;
    s223:hasProperty ex1:00006 ;
    ex1:hasTemp ex1:00006 .

ex1:00006 a s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    s223:hasValue 100.5 ;
    qudt:unit unit:DEG_F .

