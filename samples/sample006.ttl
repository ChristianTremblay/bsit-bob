# baseURI: http://data.ashrae.org/standard223/1.0/sample/sample006
# imports: http://data.ashrae.org/standard223/1.0/model/all

@prefix ex: <urn:ex/sample006/> .
@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/sample006>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample006> ;
  rdfs:label "sample006" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

ex:00001 a s223:System ;
    rdfs:label "hot_water_coil" ;
    s223:airInlet ex:00002 ;
    s223:airOutlet ex:00003 ;
    s223:hasProperty ex:00016 ;
    s223:hasSystemConnectionPoint ex:00002,
        ex:00003,
        ex:00004,
        ex:00005 ;
    s223:hotWaterReturn ex:00005 ;
    s223:hotWaterSupply ex:00004 ;
    s223:hotWaterValvePosition ex:00016 .

ex:00002 a s223:InletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "hot_water_coil.airInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00007 .

ex:00003 a s223:OutletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "hot_water_coil.airOutlet" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air ;
    s223:mapsTo ex:00008 .

ex:00004 a s223:InletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "hot_water_coil.hotWaterSupply" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Water-HotWater ;
    s223:mapsTo ex:00013 .

ex:00005 a s223:OutletSystemConnectionPoint,
        s223:SystemConnectionPoint ;
    rdfs:label "hot_water_coil.hotWaterReturn" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Water-HotWater ;
    s223:mapsTo ex:00010 .

ex:00006 a s223:Device,
        s223:HotWaterCoil ;
    rdfs:label "hot_water_coil.hw_coil" ;
    s223:airInlet ex:00007 ;
    s223:airOutlet ex:00008 ;
    s223:hasConnectionPoint ex:00007,
        ex:00008,
        ex:00009,
        ex:00010 ;
    s223:hotWaterReturn ex:00010 ;
    s223:hotWaterSupply ex:00009 .

ex:00007 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_coil.airInlet" ;
    s223:connectsThrough ex:00017 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Medium-Air .

ex:00008 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_coil.airOutlet" ;
    s223:connectsThrough ex:00018 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Medium-Air .

ex:00009 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_coil.hotWaterSupply" ;
    s223:connectsThrough ex:00015 ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Water-HotWater .

ex:00010 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_coil.hotWaterReturn" ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Water-HotWater .

ex:00011 a s223:Device,
        s223:Valve ;
    rdfs:label "hot_water_coil.hw_valve" ;
    s223:hasConnectionPoint ex:00013,
        ex:00014 ;
    s223:hasProperty ex:00012 ;
    s223:hotWaterInlet ex:00013 ;
    s223:hotWaterOutlet ex:00014 ;
    s223:position ex:00012 .

ex:00012 a g36:AnalogIn ;
    rdfs:label "hot_water_coil.hw_valve.position" .

ex:00013 a s223:ConnectionPoint,
        s223:InletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_valve.hotWaterInlet" ;
    s223:hasDirection s223:Direction-Inlet ;
    s223:hasMedium s223:Water-HotWater .

ex:00014 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "hot_water_coil.hw_valve.hotWaterOutlet" ;
    s223:connectsThrough ex:00015 ;
    s223:hasDirection s223:Direction-Outlet ;
    s223:hasMedium s223:Water-HotWater .

ex:00015 a s223:Connection ;
    s223:connectsAt ex:00009,
        ex:00014 ;
    s223:hasMedium s223:Water-HotWater .

ex:00016 a g36:AnalogOut ;
    s223:hasValue "<AnalogIn hot_water_coil.hw_valve.position at urn:ex/sample006/00012>" .

ex:00017 a s223:Connection ;
    rdfs:label "Cold Air" ;
    s223:connectsAt ex:00007 ;
    s223:hasMedium s223:Medium-Air .

ex:00018 a s223:Connection ;
    rdfs:label "Hot Air" ;
    s223:connectsAt ex:00008 ;
    s223:hasMedium s223:Medium-Air .

