p223:Guideline36-VAV_TerminalUnit_CoolingOnly a s223:Class,
        sh:NodeShape ;
    rdfs:label "Guideline36-VAV_TerminalUnit_CoolingOnly" ;
    s223:abstract true ;
    rdfs:comment "Guideline36-VAV_TerminalUnit_CoolingOnly | Figure 4.1" ;
    rdfs:subClassOf p223:System-Guideline36 ;
    skos:editorialNote "This class is used as a base for all validations rules for Guideline 36 VAV Terminal Unit Cooling Only. The thing defined as a subClassOf this G36 system, should have at least one property presenting the supply air flow, damper position, zone setpoint, zone temp,  and optional local override, zone CO2 reading, zone window switch and occupancy sensor" ;
    sh:property [ rdfs:comment "A G36 VAV_TerminalUnit_CoolingOnly must have a zone temperature property" ;
            sh:message "s223: A G36 VAV_TerminalUnit_CoolingOnly must have a zone temperature property" ;
            sh:minCount 1 ;
            sh:path s223:hasProperty ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class s223:ObservableProperty ;
                    sh:node [ sh:property [ sh:class qudtqk:Temperature ;
                                    sh:path s223:hasQuantityKind ] ] ] ] .

