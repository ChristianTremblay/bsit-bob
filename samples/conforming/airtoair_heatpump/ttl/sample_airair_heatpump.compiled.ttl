qudtqk:SurfaceTension a qudt:QuantityKind ;
    rdfs:label "توتر سطحي"@ar,
        "povrchové napětí"@cs,
        "Oberflächenspannung"@de,
        "surface tension"@en,
        "tensión superficial"@es,
