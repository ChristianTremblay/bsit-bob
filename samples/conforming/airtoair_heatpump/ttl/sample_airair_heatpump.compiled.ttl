unit:J-PER-KiloGM a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Joule per Kilogram"@en ;
    dcterms:description """\r
  A $\\textit{Joule Per Kilogram}$, ($J/kg$), is a unit in the category of Thermal heat capacity. \r
  It is also known as $\\textit{joules per kilogram}$.  \r
  The unit has a dimension of $L2T^{-2}$ where $L$ is length, and $T$ is time. \r
  This unit is the standard SI unit in this category.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem sou:SI ;
    qudt:derivedCoherentUnitOfSystem sou:SI ;
    qudt:expression "$J/kg$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M0H0T-2D0 ;
    qudt:hasQuantityKind qudtqk:SpecificEnergy ;
    qudt:iec61360Code "0112/2///62720#UAA175" ;
    qudt:symbol "J/kg" ;
    qudt:ucumCode "J.kg-1"^^qudt:UCUMcs,
        "J/kg"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "J2" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

