unit:DIOPTER a qudt:Unit ;
    rdfs:label "Diopter"@en ;
    dcterms:description """\r
  The unit $\\textit{Dioptre}$, or $\\textit{Diopter}$, is a unit of measurement for the optical power of a lens or curved mirror,\r
   which is equal to the reciprocal of the focal length measured in metres (that is, $1/metre$). \r
  For example, a $3 \\; dioptre$ lens brings parallel rays of light to focus at $1/3\\,metre$. \r
  The same unit is also sometimes used for other reciprocals of distance, particularly radii of curvature\r
   and the vergence of optical beams. \r
  Though the diopter is based on the SI-metric system it has not been included in the standard so that there is\r
   no international name or abbreviation for this unit of measurement within the international system of units\r
    this unit for optical power would need to be specified explicitly as the inverse metre.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:CGS ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Dioptre"^^xsd:anyURI ;
    qudt:hasDimensionVector qkdv:A0E0L-1I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:Curvature ;
    qudt:iec61360Code "0112/2///62720#UAB371" ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Dioptre?oldid=492506920"^^xsd:anyURI ;
    qudt:symbol "D" ;
    qudt:ucumCode "[diop]"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "Q25" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

