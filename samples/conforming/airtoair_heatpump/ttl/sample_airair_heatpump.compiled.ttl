unit:W-PER-M2-K a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Watt per Square Metre Kelvin"@en,
        "Watt per Square Meter Kelvin"@en-US ;
    dcterms:description """\r
  The unit $\\textit{Watt Per Square Meter Kelvin }$ ($W m^{-2} K^{-1}$) is a unit in the category of Thermal heat transfer coefficient. \r
  It is also known as $\\textit{watt/square meter-kelvin}$. \r
  This unit is commonly used in the SI unit system. \r
  $\\textit{Watt Per Square Meter Kelvin }$ has a dimension of $MT^{-1}Q^{-1}$ where $M$ is mass, $T$ is time, and $Q$ is temperature. \r
  This unit is the standard SI unit in this category.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem sou:SI ;
    qudt:derivedCoherentUnitOfSystem sou:SI ;
    qudt:expression "$W/(m^{2}-K)$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M1H-1T-3D0 ;
    qudt:hasQuantityKind qudtqk:CoefficientOfHeatTransfer,
        qudtqk:CombinedNonEvaporativeHeatTransferCoefficient,
        qudtqk:SurfaceCoefficientOfHeatTransfer ;
    qudt:iec61360Code "0112/2///62720#UAA311" ;
    qudt:symbol "W/(m²·K)" ;
    qudt:ucumCode "W.m-2.K-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "D55" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

