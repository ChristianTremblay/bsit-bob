    qudt:hasDimensionVector qkdv:A0E0L0I0M1H0T-3D0 ;
    qudt:hasQuantityKind qudtqk:PowerPerArea,
        qudtqk:Radiosity ;
    qudt:symbol "J/(cm²·day)" ;
    qudt:ucumCode "J.cm-2.d-1"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

