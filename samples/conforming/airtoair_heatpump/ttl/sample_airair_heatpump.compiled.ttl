    qudt:iec61360Code "0112/2///62720#UAA639" ;
    qudt:symbol "km²" ;
    qudt:ucumCode "km2"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "KMK" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

