    rdfs:label "Ampere Turn per Inch"@en ;
    dcterms:description """\r
  The $\\textit{Ampere Turn per Inch}$ is a measure of magnetic field intensity and is equal to 12.5664 Oersted.\r
  """^^qudt:LatexString ;
