unit:R_man a qudt:Unit ;
    rdfs:label "roentgen equivalent man"@en ;
    qudt:conversionMultiplier 0.01 ;
    qudt:conversionMultiplierSN 1e-02 ;
    qudt:exactMatch unit:REM ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M0H0T-2D0 ;
    qudt:hasQuantityKind qudtqk:DoseEquivalent ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Roentgen_equivalent_man"^^xsd:anyURI ;
    qudt:plainTextDescription "The roentgen equivalent man (rem) is a CGS unit of equivalent dose, effective dose, and committed dose, which are dose measures used to estimate potential health effects of low levels of ionizing radiation on the human body." ;
    qudt:symbol "rem" ;
    qudt:ucumCode "REM"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:SCF a qudt:Unit ;
    rdfs:label "Standard Cubic Foot"@en ;
    dcterms:description """\r
The $\\textit{standard cubic foot}$ (scf) is a unit representing the amount of gas (such as natural gas) \r
contained in a volume of one cubic foot at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic foot are 60 degrees Fahrenheit and 14.7 pounds per square inch (psi) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 1.1981 ;
    qudt:conversionMultiplierSN 1.1981e+00 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:AmountOfSubstance ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_foot"^^xsd:anyURI ;
    qudt:symbol "scf" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:SCM a qudt:Unit ;
    rdfs:label "Standard Cubic Metre"@en,
        "Standard Cubic Meter"@en-US ;
    dcterms:description """\r
The $\\textit{standard cubic metre}$ (scm) is a unit representing the amount of gas (such as natural gas)\r
contained in a volume of one cubic metre at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic metre are 0 degrees Celsius and 101.325 kilopascals (kPa) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 42.3105 ;
    qudt:conversionMultiplierSN 4.23105e+01 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:AmountOfSubstance ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_foot"^^xsd:anyURI ;
    qudt:symbol "scm" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

