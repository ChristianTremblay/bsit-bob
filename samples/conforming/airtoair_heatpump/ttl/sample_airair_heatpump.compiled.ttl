    qudt:iec61360Code "0112/2///62720#UAA191" ;
    qudt:symbol "K/min" ;
    qudt:ucumCode "K.min-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "F11" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:K-PER-SEC a qudt:Unit ;
    rdfs:label "Kelvin per Second"@en ;
