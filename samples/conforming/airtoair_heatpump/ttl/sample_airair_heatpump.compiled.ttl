unit:NT a qudt:Unit ;
    rdfs:label "Net tonnage"@en ;
    qudt:applicableSystem sou:USCS ;
    qudt:conversionMultiplier 0.0 ;
    qudt:conversionMultiplierSN 0e+00 ;
    qudt:hasDimensionVector qkdv:A0E0L3I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:Volume ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Net_tonnage"^^xsd:anyURI ;
    qudt:plainTextDescription """Net tonnage is used in the United States to determine eligibility for registering boats with \r
 the federal government. It is a nonlinear unit derived from the total volume of a ship's cargo space as well as some \r
 dimensionless factors. Net tonnage is not a measure of the weight of the ship or its cargo, and should not be confused \r
 with terms such as deadweight tonnage or displacement. Net tonnage is also used to determine the amount of money that \r
 can be charged to a ship for using a port's facilities.""" ;
    qudt:symbol "NT" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    rdfs:seeAlso unit:TON_Register .

