unit:SCF-PER-HR a qudt:Unit ;
    rdfs:label "Standard Cubic Foot per Hour"@en ;
    dcterms:description """\r
The $\\textit{standard cubic foot per hour}$ (scfm) is the molar flow rate of a gas (such as natural gas)\r
contained in a volume of one cubic foot at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic foot per minute are 60 degrees Fahrenheit and 14.7 pounds per \r
square inch (psi) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 0.0003328 ;
    qudt:conversionMultiplierSN 3.328e-04 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind qudtqk:MolarFlowRate ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_feet_per_minute"^^xsd:anyURI ;
    qudt:symbol "scfh" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:SCF-PER-MIN a qudt:Unit ;
    rdfs:label "Standard Cubic Foot per Minute"@en ;
    dcterms:description """\r
The $\\textit{standard cubic foot per minute}$ (scfm) is the molar flow rate of a gas (such as natural gas)\r
contained in a volume of one cubic foot at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic foot per minute are 60 degrees Fahrenheit and 14.7 pounds per \r
square inch (psi) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 0.0199683 ;
    qudt:conversionMultiplierSN 1.99683e-02 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind qudtqk:MolarFlowRate ;
