unit:FT3 a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Cubic Foot"@en ;
    dcterms:description """\r
  The cubic foot is an Imperial and US customary unit of volume, used in the United States and the United Kingdom. \r
  It is defined as the volume of a cube with sides of one foot (0.3048 m) in length. \r
  To calculate cubic feet multiply length X width X height.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:IMPERIAL,
        sou:USCS ;
    qudt:conversionMultiplier 0.028316846592 ;
    qudt:conversionMultiplierSN 2.831685e-02 ;
