    qudt:conversionMultiplierSN 1e-03 ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
    qudt:hasQuantityKind qudtqk:LuminousIntensityDistribution ;
    qudt:symbol "cd/klm" ;
    qudt:ucumCode "cd.klm-1"^^qudt:UCUMcs,
