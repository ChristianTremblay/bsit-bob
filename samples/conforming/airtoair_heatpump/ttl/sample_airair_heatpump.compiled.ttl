    qudt:latexDefinition "$\\sigma = \\frac{dF_n}{dA}$, where $dF_n$ is the normal component of force and $dA$ is the area of the surface element."^^qudt:LatexString ;
    qudt:latexSymbol "$\\sigma$"^^qudt:LatexString ;
