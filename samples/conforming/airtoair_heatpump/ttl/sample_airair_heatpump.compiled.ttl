    qudt:hasQuantityKind qudtqk:CatalyticActivityConcentration ;
    qudt:symbol "pkat/L" ;
    qudt:ucumCode "pkat/L"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

