unit:CLO a qudt:Unit ;
    rdfs:label "Clo"@en ;
    dcterms:description "A C.G.S System unit for $\\textit{Thermal Insulance}$ expressed as \"clo\"."^^qudt:LatexString ;
    qudt:applicableSystem sou:CGS ;
