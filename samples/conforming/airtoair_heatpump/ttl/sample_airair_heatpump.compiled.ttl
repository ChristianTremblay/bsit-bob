qudtqk:ActiveEnergy a qudt:QuantityKind ;
    rdfs:label "Active Energy"@en ;
    dcterms:description """\r
  $\\textit{Active Energy}$ is the electrical energy transformable into some other form of energy.\r
  """^^qudt:LatexString ;
