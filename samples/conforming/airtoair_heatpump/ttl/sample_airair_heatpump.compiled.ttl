rdf:Property a sh:NodeShape ;
    sh:property [ rdfs:comment "This Property must have a comment" ;
            sh:path rdfs:comment ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "s223: {$this} must have an rdfs:comment" ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/validation/schema> ;
                    sh:select """\r
SELECT $this\r
WHERE {\r
BIND(REPLACE(STR($this), "^(.*)(/|#)([^#/]*)$", "$1") AS ?prop) .\r
FILTER (?prop = "http://data.ashrae.org/standard223") .\r
FILTER (NOT EXISTS {$this rdfs:comment ?something}) .\r
}\r
""" ] ],
        [ rdfs:comment "This Property must have a label" ;
            sh:path rdfs:label ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "s223: {$this} must have an rdfs:label" ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/validation/schema> ;
                    sh:select """\r
SELECT $this\r
WHERE {\r
BIND(REPLACE(STR($this), "^(.*)(/|#)([^#/]*)$", "$1") AS ?prop) .\r
FILTER (?prop = "http://data.ashrae.org/standard223") .\r
FILTER (NOT EXISTS {$this rdfs:label ?something}) .\r
}\r
""" ] ] .

