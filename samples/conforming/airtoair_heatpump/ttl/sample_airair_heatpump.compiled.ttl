        "k[Btu_IT]/h"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:KiloCAL-PER-MIN a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Kilocalorie per Minute"@en ;
    dcterms:description """\r
  A $\\textit{Kilocalorie per Minute}$ is a unit for $\\textit{Heat Flow Rate}$ and $\\textit{Power}$,\r
   expressed as $kcal/min$.\r
  """^^qudt:LatexString ;
