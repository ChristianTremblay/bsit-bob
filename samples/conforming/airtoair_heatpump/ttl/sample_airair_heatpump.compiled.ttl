unit:DYN a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Dyne"@en ;
    dcterms:description """\r
  In physics, the $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units. \r
  The $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units. \r
  One $dyne$ is equal to $\\SI{10}{\\micro\\newton}$. \r
  Equivalently, the $dyne$ is defined as 'the force required to accelerate a mass of one gram at a rate of one centimetre per square second'. \r
  A $\\textit{dyne per centimetre}$ is the unit traditionally used to measure surface tension.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-GAUSS ;
    qudt:conversionMultiplier 0.00001 ;
