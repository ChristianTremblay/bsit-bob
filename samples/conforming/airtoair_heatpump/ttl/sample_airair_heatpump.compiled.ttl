    s223:abstract true ;
    dcterms:source "https://terminology.ashrae.org/?entry=air-handling%20unit%20(AHU)" ;
    rdfs:comment "Assembly consisting of sections containing a fan or fans and other necessary equipment to perform one or more of the following functions: air circulation, filtration, heating, cooling, heat recovery, humidifying, dehumidifying and mixing of air, and necessary control functions." ;
    rdfs:subClassOf p223:SystemType .

