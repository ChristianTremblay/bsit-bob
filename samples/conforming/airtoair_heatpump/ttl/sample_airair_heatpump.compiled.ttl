        unit:FT-LB_F,
        unit:FT-PDL,
        unit:FemtoJ,
        unit:GigaEV,
        unit:GigaJ,
        unit:GigaW-HR,
        unit:J,
        unit:KiloBTU_IT,
        unit:KiloBTU_TH,
        unit:KiloCAL,
        unit:KiloEV,
        unit:KiloJ,
        unit:KiloV-A-HR,
        unit:KiloV-A_Reactive-HR,
        unit:KiloW-HR,
        unit:MegaEV,
        unit:MegaJ,
        unit:MegaTOE,
        unit:MegaV-A-HR,
        unit:MegaV-A_Reactive-HR,
        unit:MegaW-HR,
        unit:MicroJ,
