    qudt:symbol "kg/(m·d)" ;
    qudt:ucumCode "kg.m-1.d-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "N39" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

