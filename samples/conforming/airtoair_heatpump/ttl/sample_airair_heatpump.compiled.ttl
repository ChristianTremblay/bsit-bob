    rdfs:label "Becquerels per litre"@en ;
    dcterms:description "One radioactive disintegration per second from a one part in 10**3 of the SI unit of volume (cubic metre)."@en ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-EMU,
