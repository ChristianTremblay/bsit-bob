unit:SCM-PER-HR a qudt:Unit ;
    rdfs:label "Standard Cubic Metre per Hour"@en,
        "Standard Cubic Meter per Hour"@en-US ;
    dcterms:description """\r
The $\\textit{standard cubic metre per hour}$ (scmh) is the molar flow rate of a gas (such as natural gas)\r
contained in a volume of one cubic metre at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic metre per minute are 0 degrees Celsius and 101.325 kilopascals (kPa) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 0.01175 ;
    qudt:conversionMultiplierSN 1.175e-02 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind qudtqk:MolarFlowRate ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_feet_per_minute"^^xsd:anyURI ;
    qudt:symbol "scmh" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

unit:SCM-PER-MIN a qudt:Unit ;
    rdfs:label "Standard Cubic Metre per Minute"@en,
        "Standard Cubic Meter per Minute"@en-US ;
    dcterms:description """\r
The $\\textit{standard cubic metre per minute}$ (scmm) is the molar flow rate of a gas (such as natural gas)\r
contained in a volume of one cubic metre at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,\r
not the volume of the gas. The reference conditions for standard cubic metre per minute are 0 degrees Celsius and 101.325 kilopascals (kPa) of pressure.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 0.7051738 ;
    qudt:conversionMultiplierSN 7.051738e-01 ;
    qudt:hasDimensionVector qkdv:A1E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind qudtqk:MolarFlowRate ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_feet_per_minute"^^xsd:anyURI ;
    qudt:symbol "scmm" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

