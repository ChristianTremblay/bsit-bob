    qudt:plainTextDescription "power of the unit inch according to the Anglo-American and the Imperial system of units with the exponent 3 divided by the unit hour" ;
    qudt:symbol "in³/h" ;
    qudt:ucumCode "[cin_i].h-1"^^qudt:UCUMcs ;
