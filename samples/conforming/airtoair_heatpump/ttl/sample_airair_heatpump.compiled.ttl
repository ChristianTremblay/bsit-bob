qudtqk:ModulusOfAdmittance a qudt:QuantityKind ;
    rdfs:label "Modulus Of Admittance"@en ;
    dcterms:description "\"Modulus Of Admittance\" is the absolute value of the quantity \"admittance\"."^^qudt:LatexString ;
