sample_airair_heatpump:00001 a p223:HeatPump-AirToAirHeatPump,
        p223:System-HeatPump,
        s223:System,
        scratch:AirSourceHeatPump,
        ex:SystemFromTemplate ;
    rdfs:label "MyAir2AirHeatPump" ;
    s223:hasBoundaryConnectionPoint sample_airair_heatpump:00004,
        sample_airair_heatpump:00005,
        sample_airair_heatpump:00006,
        sample_airair_heatpump:00007 ;
    s223:hasMember sample_airair_heatpump:00002 ;
    s223:hasRole s223:Role-Cooling,
        s223:Role-Heating ;
    scratch:indoorAirInlet sample_airair_heatpump:00004 ;
    scratch:indoorAirOutlet sample_airair_heatpump:00005 ;
    scratch:outdoorAirInlet sample_airair_heatpump:00006 ;
    scratch:outdoorAirOutlet sample_airair_heatpump:00007 ;
    rdfs:comment "Air to Air Heat Pump" .

bacnet:device-identifier a rdf:Property ;
    rdfs:label "Device Identifier" ;
    rdfs:comment "The Object_Identifier property of the device object within the BACnet device.  See ASHRAE 135-2020 Clause 12.11.1." .

bacnet:device-name a rdf:Property ;
    rdfs:label "Device Name" ;
    rdfs:comment "The name of the BACnet device being referenced, more formally the Object_Name property of the device object within the BACnet device.  See ASHRAE 135-2020 Clause 12.11.2." .

bacnet:object-identifier a rdf:Property ;
    rdfs:label "object-identifier" ;
    rdfs:comment "The Object_Identifier property of the object being referenced.  For example, for the object identifier of an Analog Value Object, see ASHRAE 135-2020 Clause 12.4.1." .

bacnet:object-name a rdf:Property ;
    rdfs:label "Object Name" ;
    rdfs:comment "The Object_Name property of the object being referenced.  For example, for the object name of an Analog Value Object, see ASHRAE 135-2020 Clause 12.4.2." .

bacnet:priority-for-writing a rdf:Property ;
    rdfs:label "Priority for Writing" ;
    rdfs:comment """This parameter shall be an integer in the range 1..16, which indicates the priority assigned to the WriteProperty service. If an attempt\r
is made to write to a commandable property without specifying the bacnet:priority-for-writing, a default priority of 16 (the lowest priority) shall\r
be assumed. If an attempt is made to write to a property that is not commandable with a specified priority, the priority shall be\r
ignored.  See ASHRAE 135-2020 Clause 15.9.1.1.5.""" .

bacnet:property-array-index a rdf:Property ;
    rdfs:label "Property Array Index" ;
    rdfs:comment """If the property identified is of datatype array, this optional property of type Unsigned shall indicate the array index of\r
the element of the property referenced by the ReadProperty service or the Read Access Specification of the ReadPropertyMultiple service. If the bacnet:property-array-index is omitted, this shall mean that the entire\r
array shall be referenced.  See ASHRAE 135-2020 Clause 15.5.1.1.3 and Clause 15.7.1.1.1.""" .

bacnet:property-identifier a rdf:Property ;
    rdfs:label "Property Identifier" ;
    rdfs:comment "The Object_Identifier property of the object being referenced.  For example, for the object identifier of an Analog Value Object, see ASHRAE 135-2020 Clause 12.4.1." .

p223:HeatPump-GroundToAirHeatPump a s223:Class,
