        unit:FT-PER-SEC,
        unit:GigaHZ-M,
        unit:IN-PER-MIN,
        unit:IN-PER-SEC,
        unit:IN-PER-YR,
        unit:KN,
        unit:KiloM-PER-DAY,
        unit:KiloM-PER-HR,
        unit:KiloM-PER-SEC,
        unit:M-PER-HR,
        unit:M-PER-MIN,
        unit:M-PER-SEC,
        unit:M-PER-YR,
        unit:MI-PER-HR,
        unit:MI-PER-MIN,
        unit:MI-PER-SEC,
        unit:MI_N-PER-HR,
        unit:MI_N-PER-MIN,
        unit:MicroM-PER-MIN,
