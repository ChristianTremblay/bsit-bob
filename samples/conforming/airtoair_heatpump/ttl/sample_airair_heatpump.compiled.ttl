    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:broader qudtqk:Equivalent_Mass .

qudtqk:CombinedNonEvaporativeHeatTransferCoefficient a qudt:QuantityKind ;
