    qudt:symbol "0173-1#Z4-BAJ300#002" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> .

qudtqk:PressureBasedElectricCurrent a qudt:QuantityKind ;
