        qudtqk:MagneticFluxDensity ;
    qudt:informativeReference "http://www.diracdelta.co.uk/science/source/g/a/gauss/source.html"^^xsd:anyURI ;
    qudt:symbol "abT" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

