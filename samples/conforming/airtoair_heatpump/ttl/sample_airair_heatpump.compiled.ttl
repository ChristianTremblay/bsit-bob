    qudt:hasQuantityKind qudtqk:MomentumPerAngle ;
    qudt:plainTextDescription "Newton seconds measured per radian" ;
    qudt:symbol "N·s/rad" ;
    qudt:ucumCode "N.s.rad-1"^^qudt:UCUMcs,
        "N.s/rad"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

