unit:AT-PER-M a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Ampere Turn per Metre"@en,
        "Ampere Turn per Meter"@en-US ;
    dcterms:description """\r
  The  $\\textit{Ampere Turn per Metre}$ is the SI unit of magnetic field strength. \r
  One ampere per meter is equal to $\\pi/250$ oersteds (12.566 371 millioersteds) in CGS units. \r
  The ampere per meter is also the SI unit of "magnetization" in the sense of magnetic dipole moment per unit volume;\r
   in this context $1 A/m = 0.001 emu per cubic centimeter$.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem sou:SI ;
    qudt:derivedCoherentUnitOfSystem sou:SI ;
    qudt:expression "$At/m$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E1L-1I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:MagneticFieldStrength_H ;
    qudt:symbol "AT/m" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

