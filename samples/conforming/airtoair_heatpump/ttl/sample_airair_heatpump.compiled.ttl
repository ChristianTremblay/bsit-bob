qudtqk:PRODUCT-OF-INERTIA_X a qudt:QuantityKind ;
    rdfs:label "Product of Inertia in the X axis"@en ;
    dcterms:description """\r
  The quantity kind $\\textit{Product of Inertia in the X axis}$ is a measure of a body's\r
   dynamic (or coupled) imbalance resulting in a precession when rotating about an\r
  axis other than the body's principal axis.\r
  """^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T0D0 ;
    qudt:plainTextDescription "A measure of a body's dynamic (or coupled) imbalance resulting in a precession when rotating about an axis other than the body's principal axis." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:broader qudtqk:PRODUCT-OF-INERTIA .

qudtqk:PRODUCT-OF-INERTIA_Y a qudt:QuantityKind ;
    rdfs:label "Product of Inertia in the Y axis"@en ;
    dcterms:description """\r
  The quantity kind $\\textit{Product of Inertia in the Y axis}$ is a measure of a body's\r
   dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\r
   other than the body's principal axis.\r
  """^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T0D0 ;
    qudt:plainTextDescription """\r
  The quantity kind 'Product of Inertia in the Y axis' is a measure of a body's \r
  dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\r
  other than the body's principal axis.\r
  """ ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:broader qudtqk:PRODUCT-OF-INERTIA .

qudtqk:PRODUCT-OF-INERTIA_Z a qudt:QuantityKind ;
