qudtqk:Acidity a qudt:QuantityKind ;
    rdfs:label "Acidity"@en ;
    dcterms:description """\r
  Chemicals or substances having a pH less than 7 are said to be acidic;\r
   lower pH means higher acidity.\r
  """^^qudt:LatexString ;
    qudt:applicableUnit unit:PH ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
