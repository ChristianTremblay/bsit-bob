unit:IU-PER-L a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "International Unit per Litre"@en,
        "International Unit per Liter"@en-US ;
    dcterms:description """\r
The $\\textit{International Unit per Liter}$ is a unit for 'Serum Or Plasma Level' expressed as $IU/L$.\r
The magnitude of one $IU/L$ depends on the material, so there is no single conversion multiplier.\r
"""^^qudt:LatexString ;
    qudt:expression "$IU/L$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
    qudt:hasQuantityKind qudtqk:SerumOrPlasmaLevel ;
    qudt:symbol "IU/L" ;
    qudt:ucumCode "[IU].L-1"^^qudt:UCUMcs,
        "[IU]/L"^^qudt:UCUMcs,
        "[iU].L-1"^^qudt:UCUMcs,
        "[iU]/L"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    rdfs:seeAlso unit:IU .

