unit:E a qudt:Unit ;
    rdfs:label "Elementary Charge"@en ;
    dcterms:description """$\\textit{Elementary Charge}$, usually denoted as $e$, is the electric charge carried by a single proton, \r
  or equivalently, the negation (opposite) of the electric charge carried by a single electron. \r
  This elementary charge is a fundamental physical constant. \r
  To avoid confusion over its sign, e is sometimes called the elementary positive charge. \r
  This charge has a measured value of approximately $1.602176634 \\times 10^{-19} coulombs$.\r
  In the cgs system, $e$ is $4.80320471257026372 \\times 10^{-10} statcoulombs$.\r
  """^^qudt:LatexString ;
    qudt:conversionMultiplier 0.0000000000000000001602176634 ;
    qudt:conversionMultiplierSN 1.602177e-19 ;
    qudt:exactMatch unit:ElementaryCharge ;
    qudt:hasDimensionVector qkdv:A0E1L0I0M0H0T1D0 ;
    qudt:hasQuantityKind qudtqk:ElectricCharge ;
    qudt:symbol "e" ;
    qudt:ucumCode "[e]"^^qudt:UCUMcs ;
    qudt:udunitsCode "e" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

