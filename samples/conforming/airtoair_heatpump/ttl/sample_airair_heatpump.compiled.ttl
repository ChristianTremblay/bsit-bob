        "metr za sekundu"@cs,
        "Meter je Sekunde"@de,
        "μέτρο ανά δευτερόλεπτο"@el,
        "metre per second"@en,
        "Meter per Second"@en-US,
        "metro por segundo"@es,
        "متر بر ثانیه"@fa,
        "mètre par seconde"@fr,
        "מטרים לשנייה"@he,
        "मीटर प्रति सैकिण्ड"@hi,
        "metro al secondo"@it,
        "メートル毎秒"@ja,
        "metra per secundum"@la,
        "meter per saat"@ms,
