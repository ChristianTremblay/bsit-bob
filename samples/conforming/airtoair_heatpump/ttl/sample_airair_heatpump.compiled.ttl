unit:HZ-PER-K a qudt:Unit ;
    rdfs:label "هرتز لكل كلفن"@ar,
        "hertz na kelvin"@cs,
        "Hertz je Kelvin"@de,
        "hertz per kelvin"@en,
        "hercio por kelvin"@es,
        "هرتز بر کلوین"@fa,
        "hertz par kelvin"@fr,
        "हर्ट्ज प्रति कैल्विन"@hi,
        "hertz al kelvin"@it,
        "ヘルツ毎立方メートル"@ja,
        "hertz per kelvin"@ms,
        "herc na kelwin"@pl,
        "hertz por kelvin"@pt,
        "hertz pe kelvin"@ro,
        "герц на кельвин"@ru,
        "hertz bölü kelvin"@tr ;
    dcterms:description """\r
  $\\textit{Hertz per Kelvin}$ is a unit for 'Inverse Time Temperature' expressed as $Hz K^{-1}$.\r
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
