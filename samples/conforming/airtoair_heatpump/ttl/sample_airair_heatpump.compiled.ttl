        unit:MilliM-PER-MIN,
        unit:MilliM-PER-SEC,
        unit:MilliM-PER-YR,
        unit:YD-PER-HR,
        unit:YD-PER-MIN,
        unit:YD-PER-SEC ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Velocity"^^xsd:anyURI ;
