    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

sample_airair_heatpump:00006 a s223:ConnectionPoint,
        s223:InletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "AirToAirHeatPump.outdoorAirInlet" ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf sample_airair_heatpump:00002 .

sample_airair_heatpump:00007 a s223:ConnectionPoint,
        s223:OutletConnectionPoint,
        bob:AirConnectionPoint ;
    rdfs:label "AirToAirHeatPump.outdoorAirOutlet" ;
