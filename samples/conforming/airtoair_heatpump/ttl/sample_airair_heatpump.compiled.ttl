qudtqk:ElectronDensity a qudt:QuantityKind ;
    rdfs:label "Electron Density"@en ;
    dcterms:description """\r
  $\\textit{Electron Density}$ is the number of electrons per volume in conduction bands. \r
  It is the measure of the probability of an electron being present at a specific location.\r
  """^^qudt:LatexString ;
