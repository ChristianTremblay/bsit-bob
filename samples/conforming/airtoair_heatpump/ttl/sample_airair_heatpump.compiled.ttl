        sou:USCS ;
    qudt:expression "$kBtu/h$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T-3D0 ;
    qudt:hasQuantityKind qudtqk:HeatFlowRate,
        qudtqk:Power ;
    qudt:symbol "kBtu{IT}/h" ;
