        unit:LB,
        unit:LB_M,
        unit:LB_T,
        unit:LunarMass,
        unit:MOMME_Pearl,
        unit:MOMME_Textile,
        unit:MegaGM,
        unit:MegaTON,
        unit:MegaTONNE,
        unit:MicroGM,
        unit:MilliGM,
        unit:NanoGM,
        unit:OZ,
        unit:OZ_M,
        unit:OZ_TROY,
        unit:PFUND,
        unit:Pennyweight,
        unit:PicoGM,
        unit:PlanckMass,
        unit:Quarter_UK,
        unit:SLUG,
        unit:SolarMass,
        unit:Stone_UK,
        unit:TON,
        unit:TONNE,
        unit:TON_Assay,
        unit:TON_LONG,
        unit:TON_Metric,
        unit:TON_SHORT,
        unit:TON_UK,
