<http://data.ashrae.org/standard223/1.0/data/sample_airair_heatpump>
  a owl:Ontology ;
  rdfs:isDefinedBy <http://data.ashrae.org/standard223/1.0/sample/sample_airair_heatpump-schema> ;
  rdfs:label "sample_airair_heatpump-schema" ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> .

[] a s223:Property,
        s223:QuantifiableProperty ;
    rdfs:label "R-22.Constituent-R-22" ;
    s223:ofConstituent p223:Constituent-R-22 ;
    qudt:hasQuantityKind qudtqk:VolumeFraction ;
    qudt:hasUnit unit:PERCENT .

[] a s223:Property,
        s223:QuantifiableProperty ;
    rdfs:label "R-410A.Constituent-R-410A" ;
    s223:ofConstituent p223:Constituent-R-410A ;
    qudt:hasQuantityKind qudtqk:VolumeFraction ;
    qudt:hasUnit unit:PERCENT .

bob:AirConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:AirTemperatureSensor a rdfs:Class ;
    rdfs:label "bob.sensor.temperature.AirTemperatureSensor" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Sensor,
        s223:TemperatureSensor .

bob:Amps a rdfs:Class ;
    rdfs:label "bob.properties.electricity.Amps" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:ElectricPower a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.electricity.ElectricPower" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

bob:ElectricPowerkW a rdfs:Class ;
    rdfs:label "bob.properties.electricity.ElectricPowerkW" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower .

bob:ElectricalConnectionPoint a rdfs:Class ;
    rdfs:label "bob.connections.electricity.ElectricalConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint .

bob:Electricity_240VLL_1Ph_60HzConnectionPoint a rdfs:Class ;
    rdfs:label "bob.connections.electricity.Electricity_240VLL_1Ph_60HzConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint,
        bob:ElectricalConnectionPoint .

bob:Electricity_600VLL_3Ph_60HzConnectionPoint a rdfs:Class ;
    rdfs:label "bob.connections.electricity.Electricity_600VLL_3Ph_60HzConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint,
        bob:ElectricalConnectionPoint .

bob:Flow a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.flow.Flow" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path bob:measuresMedium ],
        [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

bob:HP a rdfs:Class ;
    rdfs:label "bob.properties.force.HP" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:Percent a rdfs:Class ;
