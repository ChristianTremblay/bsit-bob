scratch:AirSourceHeatPump a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.hvac.heatpump.AirToAirHeatPump" ;
    rdfs:subClassOf p223:HeatPump-AirToAirHeatPump,
        p223:System-HeatPump,
        s223:System,
        ex:SystemFromTemplate ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:indoorAirInlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:outdoorAirInlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:indoorAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:outdoorAirOutlet ] .

scratch:AirToAirHeatPump a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.hvac.heatpump._AirToAirHeatPump" ;
    rdfs:comment """
    A heatpump with refrigeration cycle
    Created as an s223:Equipment member of a s223:HeatPump system
    """ ;
    rdfs:subClassOf p223:HeatPump-AirToAirHeatPump,
        p223:System-HeatPump,
        s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:indoorAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:indoorAirInlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:outdoorAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:electricalInlet ],
        [ a sh:PropertyShape ;
            sh:path scratch:outdoorAirInlet ] .

scratch:Fan a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.scratch.hvac.fan.Fan" ;
    rdfs:comment """
    Prototype of a Fan based on the Bob Fan class
    Fan speed is an important property
    The intrinsic property I want to make `actuatedby` a starter or a VFD, I'd like it to be
    a PercentCommand.
    Because RPM, cfm, amps, etc... will all depend of this and I would not want having to make multiple
    `actuatesProperty` relationships between the starter/vfd and the fan.
    I only want 1 property.
    Then if required, it'll be possible to calculate RPM, amps, cfm, etc, based on the `PercentCommand` actuated property

    RPM of the fan, can be different from RPM of motor (ex. belt and pulley)
    So here, speed_ratio != RPM because if a fan can deliver x RPM, the ratio of pulley can be changed and
    giving 100% speed_ratio to a fan, may mean a different speed than RPM of fan.

    A motor starter will give 0% or 100% of speed_ratio depending on being On or Off
    A VFD will modulate this speed ratio from 0% to 100%.
    Depending on the configuration of the drive, this ratio can represent 0-60Hz... or 20-50Hz
    (if freq are configured different than 0-60Hz), etc...

    Using speed_ratio will isolate the model from the real time data by providing an agnostic way
    of actuating the fan.
    """ ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Fan ;
    sh:property [ a sh:PropertyShape ;
            sh:path scratch:onOffCommand ],
        [ a sh:PropertyShape ;
            sh:path scratch:onOffStatus ],
        [ a sh:PropertyShape ;
            sh:path bob:airOutlet ],
        [ a sh:PropertyShape ;
            sh:path bob:airInlet ] .

scratch:electricalInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

scratch:indoorAirInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

scratch:indoorAirOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

scratch:onOffCommand a rdf:Property .

scratch:onOffStatus a rdf:Property .

scratch:outdoorAirInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

scratch:outdoorAirOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasBoundaryConnectionPoint,
        s223:hasConnectionPoint .

