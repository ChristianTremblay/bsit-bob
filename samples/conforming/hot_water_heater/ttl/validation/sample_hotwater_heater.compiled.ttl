    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/InverseLength> ;
    ns1:symbol "/m" ;
    ns1:ucumCode "/m"^^ns1:UCUMcs,
        "{#}.m-1"^^ns1:UCUMcs,
        "{#}/m"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

