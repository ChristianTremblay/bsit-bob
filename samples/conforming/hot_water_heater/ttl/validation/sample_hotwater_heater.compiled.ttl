    ns1:iec61360Code "0112/2///62720#UAA274" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/Pebibyte?oldid=492685015"^^xsd:anyURI ;
    ns1:prefix <http://qudt.org/vocab/prefix/Pebi> ;
