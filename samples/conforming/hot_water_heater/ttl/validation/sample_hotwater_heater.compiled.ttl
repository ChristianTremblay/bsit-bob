        "Prędkość światła"@pl,
        "Velocidade da luz"@pt,
        "Viteza luminii"@ro,
        "Скорость света"@ru,
        "Hitrost svetlobe"@sl,
        "Işık hızı"@tr,
        "光速"@zh ;
    dcterms:description "The quantity kind \\text{Speed of Light} is the speed of electomagnetic waves in a given medium."^^ns1:LatexString ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/BFT>,
        <http://qudt.org/vocab/unit/FT3-PER-MIN-FT2>,
        <http://qudt.org/vocab/unit/GigaHZ-M>,
