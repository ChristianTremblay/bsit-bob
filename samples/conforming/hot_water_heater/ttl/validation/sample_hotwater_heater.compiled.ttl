        "magnetni pretok"@sl,
        "manyetik akı"@tr,
        "磁通量"@zh ;
    dcterms:description "\"Magnetic Flux\" is the product of the average magnetic field times the perpendicular area that it penetrates."^^rdf:HTML ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/KiloLB_F-FT-PER-A>,
        <http://qudt.org/vocab/unit/KiloWB>,
        <http://qudt.org/vocab/unit/MX>,
