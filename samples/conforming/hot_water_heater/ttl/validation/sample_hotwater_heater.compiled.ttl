    ns1:conversionMultiplier 3600.0 ;
    ns1:conversionMultiplierSN 3.6e+03 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0> ;
