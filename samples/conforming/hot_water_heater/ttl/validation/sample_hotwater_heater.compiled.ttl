    ns1:plainTextDescription "A non-SI-conforming unit of pressure, that corresponds with the static pressure generated by a mercury column with the height of 1 centimetre" ;
    ns1:symbol "cmHg" ;
    ns1:ucumCode "cm[Hg]"^^ns1:UCUMcs ;
