<http://qudt.org/vocab/unit/PlanckTemperature> a ns1:Unit ;
    rdfs:label "PlanckTemperature"@en ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/PLANCK> ;
    ns1:conversionMultiplier 141678400000000000000000000000000.0 ;
