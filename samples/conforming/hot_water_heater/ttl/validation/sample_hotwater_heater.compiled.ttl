    ns1:plainTextDescription """\r
  The quantity kind 'Product of Inertia in the Y axis' is a measure of a body's \r
  dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\r
  other than the body's principal axis.\r
  """ ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:broader <http://qudt.org/vocab/quantitykind/PRODUCT-OF-INERTIA> .

