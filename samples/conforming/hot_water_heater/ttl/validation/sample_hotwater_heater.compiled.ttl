<http://qudt.org/vocab/unit/THM_US> a ns1:Unit ;
    rdfs:label "Therm US"@en ;
    dcterms:description """\r
  $\\textit{Therm}$ (symbol $thm$) is a non-SI unit of heat energy. \r
  It was defined in the United States in 1968 as the energy equivalent of burning 100 cubic feet of \r
  natural gas at standard temperature and pressure. \r
  In the US gas industry its SI equivalent is defined as exactly $100,000 BTU59^{\\circ}{F}$ or $105.4804 megajoules$. \r
  Public utilities in the U.S. use the therm unit for measuring customer usage of gas and calculating the monthly bills.\r
  """^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 105480400.0 ;
    ns1:conversionMultiplierSN 1.054804e+08 ;
    ns1:exactMatch <http://qudt.org/vocab/unit/THERM_US> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Energy>,
        <http://qudt.org/vocab/quantitykind/ThermalEnergy> ;
    ns1:informativeReference "http://www.convertunits.com/info/therm%2B%5BU.S.%5D"^^xsd:anyURI ;
    ns1:symbol "thm{US}" ;
    ns1:ucumCode "100000.[Btu_59]"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "N72" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

ns2:Fluid-Water a ns2:Class,
        ns2:Fluid-Water,
        sh:NodeShape ;
    rdfs:label "Fluid-Water" ;
    ns2:composedOf [ a ns2:QuantifiableProperty ;
            rdfs:label "Water conc" ;
            ns2:ofConstituent ns2:Constituent-H2O ;
            ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/VolumeFraction> ;
            ns1:hasUnit <http://qudt.org/vocab/unit/PERCENT> ] ;
    rdfs:comment "This class has enumerated subclasses of water and aqueous solutions in various states." ;
    rdfs:subClassOf ns2:Mix-Fluid .

ns2:QuantifiableProperty a ns2:Class,
        sh:NodeShape ;
    rdfs:label "Quantifiable Property" ;
    rdfs:comment "This class is for quantifiable values that describe an object (System, Equipment, etc.) that are typically static (hasValue). That is, they are neither measured nor specified in the course of operations." ;
    rdfs:subClassOf ns2:Property ;
    sh:property [ rdfs:comment "This QuantifiableProperty cannot have a value without a Unit." ;
            sh:path ns2:hasValue ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty cannot have a value without a Unit." ;
                    sh:message "s223: {$this} referenced by {?subject} has a value of {?v} but does not specify a Unit." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?v ?subject\r
WHERE {\r
$this s223:hasValue ?v .\r
FILTER NOT EXISTS {$this qudt:hasUnit ?u} .\r
?subject ?p $this .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty cannot have a value without a Unit." ;
            sh:path ns2:hasValue ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty cannot have a value without a Unit." ;
                    sh:message "s223: {$this} referenced by {?subject} has a value of {?v} but does not specify a Unit." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?v ?subject\r
WHERE {\r
$this s223:hasValue ?v .\r
FILTER NOT EXISTS {$this qudt:hasUnit ?u} .\r
?subject ?p $this .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty uses hasSetpoint to reference a Property that lacks an Aspect of Aspect-Setpoint." ;
            sh:path ns1:hasAspect ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty uses hasSetpoint to reference a Property that lacks an Aspect of Aspect-Setpoint." ;
                    sh:message "s223: {$this} uses hasSetpoint to reference {?setpoint} that lacks an Aspect of Aspect-Setpoint." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?setpoint\r
WHERE {\r
$this s223:hasSetpoint ?setpoint .\r
FILTER NOT EXISTS {?setpoint s223:hasAspect s223:Aspect-Setpoint} .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty and the Setpoint associated with it have non-commensurate QuantityKinds." ;
            sh:path ns1:hasQuantityKind ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty and the Setpoint associated with it have non-commensurate QuantityKinds." ;
                    sh:message "s223: {$this} uses QuantityKind {?pqk} with DimensionVector {?pdv}, while Setpoint {?setpoint} uses QuantityKind {?sqk} with DimensionVector {?sdv}. These are non-commensurate" ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?setpoint ?pqk ?sqk ?pdv ?sdv\r
WHERE {\r
$this qudt:hasQuantityKind ?pqk .\r
$this s223:hasSetpoint ?setpoint .\r
?setpoint qudt:hasQuantityKind ?sqk .\r
?pqk qudt:hasDimensionVector ?pdv .\r
?sqk qudt:hasDimensionVector ?sdv .\r
FILTER (?pqk != ?sqk) .\r
FILTER (?pdv != ?sdv) .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty with Aspect-Setpoint is not referenced by any Property using hasSetpoint." ;
            sh:path ns1:hasSetpoint ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty with Aspect-Setpoint is not referenced by any Property using hasSetpoint." ;
                    sh:message "s223: {$this} has Aspect-Setpoint but is not referenced by any Property using hasSetpoint." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this \r
WHERE {\r
$this s223:hasAspect s223:Aspect-Setpoint .\r
FILTER NOT EXISTS {?anything s223:hasSetpoint $this} .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty and the associated Setpoint use non-commensurate Units." ;
            sh:path ns1:hasUnit ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty and the associated Setpoint use non-commensurate Units." ;
                    sh:message "s223: {$this} uses Unit {?punit}, while Setpoint {?setpoint} uses Unit {?sunit}. These are non-commensurate." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?setpoint ?punit ?sunit\r
WHERE {\r
$this qudt:hasUnit ?punit .\r
$this s223:hasSetpoint ?setpoint .\r
?setpoint qudt:hasUnit ?sunit .\r
?punit qudt:hasDimensionVector ?pdv .\r
?sunit qudt:hasDimensionVector ?sdv .\r
FILTER (?punit != ?sunit) .\r
FILTER (?pdv != ?sdv) .\r
}\r
""" ] ],
        [ rdfs:comment "This QuantifiableProperty uses a different Unit than the Setpoint associated with it." ;
            sh:path ns1:hasUnit ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "This QuantifiableProperty uses a different Unit than the Setpoint associated with it." ;
                    sh:message "s223: {$this} uses Unit {?punit}, while Setpoint {?setpoint} uses Unit {?sunit}. Be careful." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?setpoint ?punit ?sunit\r
WHERE {\r
$this qudt:hasUnit ?punit .\r
$this s223:hasSetpoint ?setpoint .\r
?setpoint qudt:hasUnit ?sunit .\r
?punit qudt:hasDimensionVector ?pdv .\r
?sunit qudt:hasDimensionVector ?sdv .\r
FILTER (?punit != ?sunit) .\r
FILTER (?pdv = ?sdv) .\r
}\r
""" ] ],
        [ rdfs:comment "A QuantifiableProperty should use s223:hasValue instead of qudt:value." ;
            sh:maxCount 0 ;
            sh:message "s223: A QuantifiableProperty should use s223:hasValue instead of qudt:value." ;
            sh:path ns1:value ],
        [ rdfs:comment "A QuantifiableProperty should use s223:hasValue instead of qudt:value." ;
            sh:maxCount 0 ;
            sh:message "s223: A QuantifiableProperty should use s223:hasValue instead of qudt:value." ;
            sh:path ns1:value ],
        [ rdfs:comment "A QuantifiableProperty must be associated with a QuantityKind using the relation hasQuantityKind." ;
            sh:class ns1:QuantityKind ;
            sh:maxCount 1 ;
            sh:message "s223: A QuantifiableProperty must be associated with a QuantityKind using the relation hasQuantityKind." ;
            sh:minCount 1 ;
            sh:path ns1:hasQuantityKind ],
        [ rdfs:comment "A QuantifiableProperty can be associated with at most one Unit using the relation hasUnit." ;
            sh:class ns1:Unit ;
            sh:maxCount 1 ;
            sh:message "s223: A QuantifiableProperty can be associated with at most one Unit using the relation hasUnit." ;
            sh:path ns1:hasUnit ],
        [ rdfs:comment """A QuantifiableProperty can be associated with an optional Boolean flag using the relation isDeltaQuantity. \r
If the relation isDeltaQuantity has a value of true, the associated value should be interpreted as a difference reading, such as a \r
temperature difference. This is needed to distinguish between a temperature reading and a temperature difference reading, which\r
affects unit conversion calculations.""" ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message """A QuantifiableProperty can be associated with an optional Boolean flag using the relation isDeltaQuantity. \r
If the relation isDeltaQuantity has a value of true, the associated value should be interpreted as a difference reading, such as a \r
temperature difference. This is needed to distinguish between a temperature reading and a temperature difference reading, which\r
affects unit conversion calculations.""" ;
            sh:path ns1:isDeltaQuantity ],
        [ rdfs:comment """Normally, a QuantifiableProperty is associated with a static decimal value using s223:hasValue, along with a single \r
unit and quantity kind. However, in some cases, a QuantifiableProperty may instead be associated with a qudt:QuantityValue using the relation \r
qudt:quantityValue. This allows the qudt:QuantityValue to express multiple equivalent combinations of unit and value.""" ;
            sh:class ns1:QuantityValue ;
            sh:message """Normally, a QuantifiableProperty is associated with a static decimal value using s223:hasValue, along with a single \r
unit and quantity kind. However, in some cases, a QuantifiableProperty may instead be associated with a qudt:QuantityValue using the relation \r
qudt:quantityValue. This allows the qudt:QuantityValue to express multiple equivalent combinations of unit and value.""" ;
            sh:path ns1:quantityValue ] ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:comment "Infer the hasQuantityKind relation if it is unambiguous." ;
            sh:construct """\r
CONSTRUCT {\r
$this qudt:hasQuantityKind ?uniqueqk\r
}\r
WHERE {\r
{\r
SELECT $this (COUNT (DISTINCT (?qk)) AS ?count)\r
WHERE {\r
FILTER (NOT EXISTS {$this qudt:hasQuantityKind ?something}) .\r
$this qudt:hasUnit/qudt:hasQuantityKind ?qk .\r
}\r
GROUP BY $this\r
}\r
FILTER (?count = 1)\r
$this qudt:hasUnit/qudt:hasQuantityKind ?uniqueqk .\r
}\r
""" ;
            sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            rdfs:comment "Checks for consistent dimension vectors for a QuantityKind and the Unit" ;
            sh:message "s223: Inconsistent dimensionalities among the Property's Unit and Property's Quantity Kind" ;
            sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
            sh:select """\r
SELECT $this\r
   WHERE \r
{\r
      $this qudt:hasQuantityKind/qudt:hasDimensionVector ?qkdv1 .\r
      $this qudt:hasUnit/qudt:hasDimensionVector ?qkdv2 .\r
FILTER (?qkdv1 != ?qkdv2) .\r
}\r
""" ] .

