<http://qudt.org/vocab/quantitykind/PayloadRatio> a ns1:QuantityKind ;
    rdfs:label "Payload Ratio"@en ;
    dcterms:description "The payload ratio is defined as the mass of the payload divided by the empty mass of the structure. Because of the extra cost involved in staging rockets, given the choice, it's often more economic to use few stages with a small payload ratio rather than more stages each with a high payload ratio."^^rdf:HTML ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/FRACTION>,
        <http://qudt.org/vocab/unit/GR>,
        <http://qudt.org/vocab/unit/NUM>,
