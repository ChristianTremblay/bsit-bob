<http://qudt.org/vocab/quantitykind/FlightPathAngle> a ns1:QuantityKind ;
    rdfs:label "Flight Path Angle"@en ;
    dcterms:description "Flight path angle is defined in two different ways. To the aerodynamicist, it is the angle between the flight path vector (where the airplane is going) and the local atmosphere. To the flight crew, it is normally known as the angle between the flight path vector and the horizon, also known as the climb (or descent) angle."^^rdf:HTML ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/ARCMIN>,
        <http://qudt.org/vocab/unit/ARCSEC>,
        <http://qudt.org/vocab/unit/DEG>,
