<http://qudt.org/vocab/quantitykind/MagneticFlux> a ns1:QuantityKind ;
    rdfs:label "التدفق المغناطيسي"@ar,
        "Магнитен поток"@bg,
        "Magnetický tok"@cs,
        "magnetischer Flux"@de,
        "magnetic flux"@en,
