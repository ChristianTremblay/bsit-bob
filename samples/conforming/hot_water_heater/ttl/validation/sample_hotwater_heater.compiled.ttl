<http://qudt.org/vocab/unit/KiloCAL-PER-MIN> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "Kilocalorie per Minute"@en ;
    dcterms:description "$\\textit{Kilocalorie per Minute}$ is a unit for \\textit{Heat Flow Rate} and \\textit{Power} expressed as $kcal/min$."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
