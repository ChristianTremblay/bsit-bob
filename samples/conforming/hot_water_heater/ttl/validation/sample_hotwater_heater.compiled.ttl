    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/poundal> ;
    ns1:symbol "pdl" ;
    ns1:ucumCode "[lb_av].[ft_i].s-2"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "M76" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

