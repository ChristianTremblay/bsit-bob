<http://qudt.org/vocab/quantitykind/Slowing-DownArea> a ns1:QuantityKind ;
    rdfs:label "Slowing-Down Area"@en ;
    dcterms:description "\"Slowing-Down Area\" in an infinite homogenous medium, is one-sixth of the mean square distance between the neutron source and the point where a neutron reaches a given energy."^^rdf:HTML ;
