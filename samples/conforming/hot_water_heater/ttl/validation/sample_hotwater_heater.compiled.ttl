    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MolarHeatCapacity> ;
    ns1:symbol "Btu{IT}/(lb-mol·°F)" ;
    ns1:ucumCode "[Btu_IT].[mol_lb]-1.[degF]-1"^^ns1:UCUMcs,
