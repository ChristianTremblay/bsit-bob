    rdfs:label "International Unit"@en ;
    dcterms:description """\r
  The $\\textit{International Unit}$ is a unit for $\\textit{Amount Of Substance}$ expressed as $IU$.\r
  Note that the magnitude depends on the substance, thus there is no fixed conversion multiplier.\r
  """^^ns1:LatexString ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/International_unit"^^xsd:anyURI ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0> ;
