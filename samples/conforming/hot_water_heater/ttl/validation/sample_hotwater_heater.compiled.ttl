    rdfs:label "Reciprocal Metre"@en,
        "Reciprocal Meter"@en-us ;
    dcterms:description "Per Meter Unit is a denominator unit with dimensions $/m$."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
