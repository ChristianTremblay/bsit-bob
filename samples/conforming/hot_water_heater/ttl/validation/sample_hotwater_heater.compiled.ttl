<http://qudt.org/vocab/unit/DYN> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "Dyne"@en ;
    dcterms:description "In physics, the dyne is a unit of force specified in the centimetre-gram-second (CGS) system of units. One dyne is equal to In physics, the dyne is a unit of force specified in the centimetre-gram-second (CGS) system of units. One dyne is equal to \\SI{10}{\\micro\\newton}. Equivalently, the dyne is defined as 'the force required to accelerate a mass of one gram at a rate of one centimetre per square second'. The dyne per centimetre is the unit traditionally used to measure surface tension."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-GAUSS> ;
    ns1:conversionMultiplier 0.00001 ;
    ns1:conversionMultiplierSN 1e-05 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Dyne"^^xsd:anyURI ;
    ns1:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/CGS> ;
    ns1:derivedUnitOfSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-GAUSS> ;
