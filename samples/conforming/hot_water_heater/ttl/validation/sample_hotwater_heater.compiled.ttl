    ns1:symbol "A/g" ;
    ns1:ucumCode "A.g-1"^^ns1:UCUMcs,
        "A/g"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

