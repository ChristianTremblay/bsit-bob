    ns1:informativeReference "http://en.wikipedia.org/wiki/Linear_density"^^xsd:anyURI ;
    ns1:latexSymbol "$\\mu$"^^ns1:LatexString ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> .

