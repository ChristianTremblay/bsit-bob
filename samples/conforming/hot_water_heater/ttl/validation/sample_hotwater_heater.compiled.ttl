    ns1:plainTextDescription "The \"Half-Life\" is the average duration required for the decay of one half of the atoms or nuclei." ;
    ns1:symbol "T_{1/2}" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:altLabel "semivita"@it .

