    ns1:symbol "ph" ;
    ns1:ucumCode "ph"^^ns1:UCUMcs ;
    ns1:udunitsCode "ph" ;
    ns1:uneceCommonCode "P26" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

