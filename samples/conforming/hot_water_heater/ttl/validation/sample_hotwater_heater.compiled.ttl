ns2:Equipment a ns2:Class,
        sh:NodeShape ;
    rdfs:label "Equipment" ;
    rdfs:comment """\r
Equipment is the modeling construct used to represent a device designed to accomplish a specific task, \r
or a complex device that contains component pieces of Equipment. This is distinct from a System, which is a logical grouping or collection of Equipment. \r
Equipment can have ConnectionPoints and participate \r
in the flow of one or more kinds of Medium. Examples of possible equipment include a Pump, Fan, HeatExchanger, Luminaire, \r
TemperatureSensor, or FlowSensor.\r
\r
In common usage terms like equipment and system have a variety of ambituous and possibly conflicting interpretations. A semantic model\r
is an attempt to eliminate such ambiguities and conflicts. If the thing being modeled has a need for ConnectionPoints it must be modeled as Equipment and not a System.\r
Thus, a complex example like a chlled water plant is modeled as Equipment because it has connection points for distributing chilled water. The same chilled water plant \r
may be part of a logical grouping of pumps, valves, filters, and other things modeled as a chilled water System.\r
\r
The graphical depiction of Equipment used in this standard is a rounded cornered rectangle as show in Figure 5-1.\r
\r
![Graphical Depiction of Equipment.](figures/Figure_5-1Graphical_Depiciton_of_Equipment.svg)\r
  """ ;
    rdfs:subClassOf ns2:Connectable ;
    sh:property [ rdfs:comment "Disallow contained equipment from having external incoming connections." ;
            sh:path ns2:connectedFrom ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Disallow contained equipment from having external incoming connections." ;
                    sh:message "s223: {$this} should not have a connection from external equipment {?otherDev} because {?container} contains {$this}." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?container ?otherDev\r
WHERE {\r
$this s223:connectedFrom ?otherDev .\r
$this ^s223:contains ?container .\r
?container a/rdfs:subClassOf* s223:Equipment .\r
FILTER NOT EXISTS {?container s223:contains ?otherDev .}\r
}\r
""" ] ],
        [ rdfs:comment "Disallow contained equipment from having external outgoing connections." ;
            sh:path ns2:connectedTo ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Disallow contained equipment from having external outgoing connections." ;
                    sh:message "s223: {$this} should not have a connection to external equipment {?otherDev} because {?container} contains {$this}." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?container ?otherDev\r
WHERE {\r
$this s223:connectedTo ?otherDev .\r
$this ^s223:contains ?container .\r
?container a/rdfs:subClassOf* s223:Equipment .\r
FILTER NOT EXISTS {?container s223:contains ?otherDev .}\r
}\r
""" ] ],
        [ rdfs:comment "Warning about a subClass of Equipment of type A containing something that is in the same subClass branch." ;
            sh:path ns2:contains ;
            sh:severity sh:Warning ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Warning about a subClass of Equipment of type A containing something that is in the same subClass branch." ;
                    sh:message "s223: {$this}, of type {?type1}, contains {?subEquip} of type {?type2}, that could result in double-counting items in the class hierarchy of {?type1}." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?subEquip ?type1 ?type2\r
WHERE {\r
  FILTER NOT EXISTS {$this a s223:Equipment} .\r
$this s223:contains+ ?subEquip .\r
  FILTER NOT EXISTS {?subEquip a s223:Equipment} .\r
$this a ?type1 .\r
?subEquip a ?type2 .\r
{\r
?type2 rdfs:subClassOf* ?type1 .\r
}\r
UNION\r
{\r
?type1 rdfs:subClassOf* ?type2 .\r
}\r
}\r
""" ] ],
        [ a sh:PropertyShape ;
            rdfs:comment "If the relation contains is present it must associate the Equipment with either Equipment or Junction." ;
            sh:message "s223: If the relation contains is present it must associate the Equipment with either Equipment or Junction." ;
            sh:name "device contains shape" ;
            sh:or ( [ sh:class ns2:Equipment ] [ sh:class ns2:Junction ] ) ;
            sh:path ns2:contains ],
        [ rdfs:comment """If the relation actuatedByProperty is present it must associate the Equipment with a ActuatableProperty.\r
Note that any Equipment may use this relation, not just Actuator.""" ;
            sh:class ns2:ActuatableProperty ;
            sh:message """If the relation actuatedByProperty is present it must associate the Equipment with a ActuatableProperty.\r
Note that any Equipment may use this relation, not just Actuator.""" ;
            sh:path ns2:actuatedByProperty ],
        [ rdfs:comment "If the relation executes is present it must associate the Equipment with a Function." ;
            sh:class ns2:Function ;
            sh:message "s223: If the relation executes is present it must associate the Equipment with a Function." ;
            sh:path ns2:executes ],
        [ rdfs:comment "If the relation hasPhysicalLocation is present it must associate the Equipment with a PhysicalSpace." ;
            sh:class ns2:PhysicalSpace ;
            sh:message "s223: If the relation hasPhysicalLocation is present it must associate the Equipment with a PhysicalSpace." ;
            sh:path ns2:hasPhysicalLocation ],
        [ rdfs:comment "If the relation hasRole is present it must associate the Equipment with a EnumerationKind-Role." ;
            sh:class ns2:EnumerationKind-Role ;
            sh:message "s223: If the relation hasRole is present it must associate the Equipment with a EnumerationKind-Role." ;
            sh:path ns2:hasRole ] ;
    sh:rule [ a sh:SPARQLRule ;
            rdfs:comment "For equipment contained within another piece of equipment use the mapsTo relation to infer a Medium from the containing equipment." ;
            sh:construct """\r
CONSTRUCT {\r
    ?childCp s223:hasMedium ?medium .\r
}\r
WHERE {\r
  $this s223:hasConnectionPoint ?cp .\r
  ?childCp s223:mapsTo ?cp .\r
  ?cp s223:connectsThrough ?connection .\r
  ?cp s223:hasMedium ?medium .\r
  FILTER NOT EXISTS {?childCp s223:hasMedium ?something} .\r
}\r
""" ;
            sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ],
        [ a sh:SPARQLRule ;
            rdfs:comment "For equipment containing another piece of equipment, use the mapsTo relation to infer a Medium from the contained equipment." ;
            sh:construct """\r
CONSTRUCT {\r
    ?parentCp s223:hasMedium ?medium .\r
}\r
WHERE {\r
  $this s223:hasConnectionPoint ?cp .\r
  ?cp s223:mapsTo ?parentCp .\r
  ?cp s223:connectsThrough ?connection .\r
  ?cp s223:hasMedium ?medium .\r
  FILTER NOT EXISTS {?parentCp s223:hasMedium ?something} .\r
}\r
""" ;
            sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ] .

