<http://qudt.org/vocab/unit/BQ> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "بيكريل"@ar,
        "бекерел"@bg,
        "becquerel"@cs,
        "Becquerel"@de,
        "μπεκερέλ"@el,
        "becquerel"@en,
        "becquerel"@es,
        "بکرل"@fa,
        "becquerel"@fr,
        "בקרל"@he,
        "बैक्वेरल"@hi,
        "becquerel"@hu,
        "becquerel"@it,
        "ベクレル"@ja,
        "becquerelium"@la,
        "becquerel"@ms,
        "bekerel"@pl,
        "becquerel"@pt,
        "becquerel"@ro,
        "беккерель"@ru,
        "becquerel"@sl,
        "bekerel"@tr,
        "贝克勒尔"@zh ;
    dcterms:description """\r
  The $\\textit{Becquerel}$ is the SI derived unit of activity, usually meaning radioactivity.\r
  Radioactivity is caused when atoms disintegrate, ejecting energetic particles. \r
  One becquerel is the radiation caused by one disintegration per second; \r
  this is equivalent to about $27.0270 \\text{picocuries (pCi)}$. \r
  The unit is named for a French physicist, Antoine-Henri Becquerel (1852-1908), \r
  the discoverer of radioactivity. \r
  Note: both the becquerel and the hertz are basically defined as one event per second, \r
  yet they measure different things. \r
  The hertz is used to measure the rates of events that happen periodically in a fixed and definite cycle. \r
  The becquerel is used to measure the rates of events that happen sporadically and unpredictably, \r
  not in a definite cycle.\r
  """^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
        <http://qudt.org/vocab/sou/CGS-GAUSS>,
        <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/SI>,
        <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 1.0 ;
    ns1:conversionMultiplierSN 1e+00 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Becquerel"^^xsd:anyURI ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Activity> ;
    ns1:iec61360Code "0112/2///62720#UAA111" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/Becquerel?oldid=493710036"^^xsd:anyURI ;
