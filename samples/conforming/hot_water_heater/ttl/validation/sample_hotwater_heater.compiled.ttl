<http://qudt.org/vocab/quantitykind/RadiantExposure> a ns1:QuantityKind ;
    rdfs:label "Radiant Exposure"@en ;
    dcterms:description "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure."^^rdf:HTML ;
    ns1:abbreviation "J-PER-CM2" ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/BTU_IT-PER-FT2>,
