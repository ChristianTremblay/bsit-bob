    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

<http://qudt.org/vocab/unit/BTU_TH-IN-PER-FT2-SEC-DEG_F> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "BTU (TH) Inch per Square Foot Second Degree Fahrenheit"@en ;
