<http://qudt.org/vocab/quantitykind/Frequency> a ns1:QuantityKind ;
    rdfs:label "التردد لدى نظام الوحدات الدولي"@ar,
        "Честота"@bg,
        "Frekvence"@cs,
        "Frequenz"@de,
        "Συχνότητα"@el,
        "frequency"@en,
        "frecuencia"@es,
        "بسامد"@fa,
        "fréquence"@fr,
        "תדירות"@he,
        "आवृत्ति"@hi,
        "frekvencia"@hu,
        "frequenza"@it,
        "周波数"@ja,
        "frequentia"@la,
        "Frekuensi"@ms,
        "częstotliwość"@pl,
        "frequência"@pt,
        "frecvență"@ro,
        "Частота"@ru,
        "frekvenca"@sl,
        "frekans"@tr,
        "频率"@zh ;
    dcterms:description "\"Frequency\" is the number of occurrences of a repeating event per unit time. The repetition of the events may be periodic (that is. the length of time between event repetitions is fixed) or aperiodic (i.e. the length of time between event repetitions varies). Therefore, we distinguish between periodic and aperiodic frequencies. In the SI system, periodic frequency is measured in hertz (Hz) or multiples of hertz, while aperiodic frequency is measured in becquerel (Bq).  In spectroscopy, \\(\\nu\\) is mostly used. Light passing through different media keeps its frequency, but not its wavelength or wavenumber."^^ns1:LatexString ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/GigaHZ>,
        <http://qudt.org/vocab/unit/HZ>,
        <http://qudt.org/vocab/unit/KiloHZ>,
        <http://qudt.org/vocab/unit/MegaHZ>,
        <http://qudt.org/vocab/unit/MilliHZ>,
        <http://qudt.org/vocab/unit/NUM-PER-HR>,
        <http://qudt.org/vocab/unit/NUM-PER-SEC>,
        <http://qudt.org/vocab/unit/NUM-PER-YR>,
        <http://qudt.org/vocab/unit/PER-DAY>,
        <http://qudt.org/vocab/unit/PER-HR>,
        <http://qudt.org/vocab/unit/PER-MIN>,
        <http://qudt.org/vocab/unit/PER-MO>,
        <http://qudt.org/vocab/unit/PER-MilliSEC>,
        <http://qudt.org/vocab/unit/PER-SEC>,
        <http://qudt.org/vocab/unit/PER-WK>,
        <http://qudt.org/vocab/unit/PER-YR>,
        <http://qudt.org/vocab/unit/PERCENT-PER-DAY>,
        <http://qudt.org/vocab/unit/PERCENT-PER-HR>,
        <http://qudt.org/vocab/unit/PERCENT-PER-MO>,
        <http://qudt.org/vocab/unit/PERCENT-PER-WK>,
        <http://qudt.org/vocab/unit/PERCENT-PER-YR>,
        <http://qudt.org/vocab/unit/PPTH-PER-HR>,
        <http://qudt.org/vocab/unit/PetaHZ>,
        <http://qudt.org/vocab/unit/PlanckFrequency>,
        <http://qudt.org/vocab/unit/SAMPLE-PER-SEC>,
        <http://qudt.org/vocab/unit/TeraHZ>,
        <http://qudt.org/vocab/unit/failures-in-time> ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Frequency"^^xsd:anyURI ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0> ;
    ns1:iec61360Code "0112/2///62720#UAD056" ;
    ns1:latexDefinition """$f = 1/T$, where $T$ is a period.\r
\r
Alternatively,\r
\r
$\\nu = 1/T$"""^^ns1:LatexString ;
    ns1:latexSymbol "$\\nu, f$"^^ns1:LatexString ;
    ns1:siExactMatch <https://si-digital-framework.org/SI/quantities/FREQ> ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/quantitykind> ;
    skos:broader <http://qudt.org/vocab/quantitykind/InverseTime> .

ns2:ConnectionPoint a ns2:Class,
        sh:NodeShape ;
    rdfs:label "ConnectionPoint" ;
    ns2:abstract true ;
    rdfs:comment """\r
A ConnectionPoint is an abstract modeling construct used to represent the fact that one connectable thing can be connected to another connectable thing using a Connection. It is the abstract representation of the flange, wire terminal, or other physical feature where a connection is made. Equipment, DomainSpaces and Junctions can have one or more ConnectionPoints (see `s223:Connectable`).\r
\r
A ConnectionPoint is constrained to relate to a specific medium such as air, water, or electricity which determines what other things can be connected to it. For example, constraining a ConnectionPoint to be for air means it cannot be used for an electrical connection.\r
\r
A ConnectionPoint belongs to exactly one connectable thing (see `s223:Connectable').\r
\r
ConnectionPoints are represented graphically in this standard by a triangle with the point indicating a direction of flow, or a diamond in the case of a bidirectional flow as shown in Figure 6-1. \r
\r
![Graphical Representation of a ConnectionPoint.](figures/Figure_5-2_Graphical_Depiciton_of_Connection_Points.svg)\r
\r
 """ ;
    rdfs:subClassOf ns2:Concept ;
    sh:property [ rdfs:comment "If a ConnectionPoint lacks a connectsThrough and mapsTo relation, and is not associated with a Junction or Equipment that is contained by an Equipment, then suggest that the ConnectionPoint probably needs an association with a Connection." ;
            sh:path ns2:connectsThrough ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "If a ConnectionPoint lacks a connectsThrough and mapsTo relation, and is not associated with a Junction or Equipment that is contained by an Equipment, then suggest that the ConnectionPoint probably needs an association with a Connection." ;
                    sh:message "s223: ConnectionPoint {$this} probably needs an association with a Connection, or use of hasOptionalConnectionPoint or hasBoundaryConnectionPoint qualifiers." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
    SELECT $this \r
    WHERE {\r
        FILTER NOT EXISTS {?sys1 s223:hasBoundaryConnectionPoint $this} .\r
        FILTER NOT EXISTS {?sys2 s223:hasOptionalConnectionPoint $this} .\r
        FILTER NOT EXISTS {$this s223:connectsThrough ?anything1} .\r
        FILTER NOT EXISTS {$this s223:mapsTo ?anything2} .\r
        $this s223:isConnectionPointOf ?equipment .\r
        FILTER NOT EXISTS {?containerEquipment s223:contains ?equipment} .\r
        }\r
        """ ] ],
        [ rdfs:comment "Ensure that the Medium identified by a ConnectionPoint via the s223:hasMedium relation is compatible with the Medium identified by the entity identified by the mapsTo+ relation." ;
            sh:name "Test for compatible declared Medium" ;
            sh:path ns2:hasMedium ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "Ensure that the Medium identified by a ConnectionPoint via the s223:hasMedium relation is compatible with the Medium identified by the entity identified by the mapsTo+ relation." ;
                    sh:message "s223: {$this} declares a Medium of {?a}, but the Medium of {?b} is declared by {?target} pointed to by the mapsTo+ relation." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT DISTINCT $this ?a ?b ?target\r
WHERE {\r
$this s223:hasMedium ?a .\r
$this s223:mapsTo+ ?target .\r
?target s223:hasMedium ?b .\r
?a a/rdfs:subClassOf* s223:EnumerationKind-Medium .\r
?b a/rdfs:subClassOf* s223:EnumerationKind-Medium .\r
FILTER (?a != ?b ) .\r
FILTER (NOT EXISTS {?b a/rdfs:subClassOf* ?a}) .\r
FILTER (NOT EXISTS {?a a/rdfs:subClassOf* ?b}) .\r
}\r
""" ] ],
        [ rdfs:comment "A ConnectionPoint must not have both a mapsTo and a connectsThrough relation." ;
            sh:path ns2:mapsTo ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "A ConnectionPoint must not have both a mapsTo and a connectsThrough relation." ;
                    sh:message "s223: {$this} cannot have both a mapsTo {?uppercp} and a connectsThrough {?connection}." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?uppercp ?connection\r
WHERE {\r
$this s223:mapsTo ?uppercp .\r
$this s223:connectsThrough ?connection .\r
?connection a/rdfs:subClassOf* s223:Connection .\r
}\r
""" ] ],
        [ rdfs:comment "If a ConnectionPoint lacks a connectsThrough and mapsTo relation, but is associated with a Junction or Equipment that is contained by an Equipment, then suggest that the ConnectionPoint might need a mapsTo relation to a ConnectionPoint of the containing Equipment." ;
            sh:path ns2:mapsTo ;
            sh:severity sh:Info ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "If a ConnectionPoint lacks a connectsThrough and mapsTo relation, but is associated with a Junction or Equipment that is contained by an Equipment, then suggest that the ConnectionPoint might need a mapsTo relation to a ConnectionPoint of the containing Equipment." ;
                    sh:message "s223: ConnectionPoint {$this} could be missing a mapsTo relation to a ConnectionPoint of {?containerEquipment} because it is associated with a Junction or Equipment that is contained by {?containerEquipment}." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
    SELECT $this ?containerEquipment\r
    WHERE {\r
        FILTER NOT EXISTS {$this s223:connectsThrough ?anything1} .\r
        FILTER NOT EXISTS {$this s223:mapsTo ?anything2} .\r
        FILTER NOT EXISTS {?anything3 s223:hasBoundaryConnectionPoint $this} .\r
        $this s223:isConnectionPointOf ?equipment .\r
        ?containerEquipment s223:contains ?equipment .\r
        }\r
        """ ] ],
        [ rdfs:comment "If a ConnectionPoint mapsTo another ConnectionPoint, the respective Equipment should have a contains relation." ;
            sh:path ns2:mapsTo ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    rdfs:comment "If a ConnectionPoint mapsTo another ConnectionPoint, the respective Equipment should have a contains relation." ;
                    sh:message "s223: {?otherEquipment} should contain {?equipment} because ConnectionPoint {$this} has a mapsTo relation." ;
                    sh:prefixes <http://data.ashrae.org/standard223/1.0/inference/data-rules> ;
                    sh:select """\r
SELECT $this ?equipment ?otherEquipment\r
WHERE {\r
$this s223:mapsTo ?otherCP .\r
?equipment s223:hasConnectionPoint $this .\r
?otherEquipment s223:hasConnectionPoint ?otherCP .\r
FILTER NOT EXISTS {?otherEquipment s223:contains ?equipment}\r
}\r
""" ] ],
        [ rdfs:comment "A ConnectionPoint must be associated with at most one Connectable using the cnx relation." ;
            sh:message "s223: A ConnectionPoint must be associated with at most one Connectable using the cnx relation." ;
            sh:path ns2:cnx ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns2:Connectable ] ;
            sh:qualifiedValueShapesDisjoint true ],
        [ rdfs:comment "A ConnectionPoint must be associated with at most one Connection using the cnx relation" ;
            sh:message "s223: A ConnectionPoint must be associated with at most one Connection using the cnx relation" ;
            sh:path ns2:cnx ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns2:Connection ] ;
            sh:qualifiedValueShapesDisjoint true ],
        [ rdfs:comment "A ConnectionPoint must be associated with at most one Connection using the relation connectsThrough." ;
            sh:class ns2:Connection ;
            sh:maxCount 1 ;
            sh:message "s223: This ConnectionPoint must be associated with at most one Connection." ;
            sh:name "ConnectionPointToConnectionShape" ;
            sh:path ns2:connectsThrough ;
            sh:severity sh:Info ],
        [ rdfs:comment "If the relation hasElectricalPhase is present it must associate the ConnectionPoint with an ElectricalPhaseIdentifier or ElectricalVoltagePhases." ;
            sh:message "s223: If the relation hasElectricalPhase is present it must associate the ConnectionPoint with an ElectricalPhaseIdentifier or ElectricalVoltagePhases." ;
            sh:or ( [ sh:class ns2:Aspect-ElectricalPhaseIdentifier ] [ sh:class ns2:Aspect-ElectricalVoltagePhases ] ) ;
            sh:path ns2:hasElectricalPhase ],
        [ rdfs:comment "A ConnectionPoint must be associated with exactly one Substance-Medium using the relation hasMedium." ;
            sh:class ns2:Substance-Medium ;
            sh:maxCount 1 ;
            sh:message "s223: A ConnectionPoint must be associated with exactly one Substance-Medium using the relation hasMedium." ;
            sh:minCount 1 ;
            sh:name "ConnectionPoint medium" ;
            sh:path ns2:hasMedium ],
        [ rdfs:comment "If the relation hasRole is present it must associate the ConnectionPoint with an EnumerationKind-Role." ;
            sh:class ns2:EnumerationKind-Role ;
            sh:message "s223: If the relation hasRole is present it must associate the ConnectionPoint with an EnumerationKind-Role." ;
            sh:path ns2:hasRole ],
        [ rdfs:comment "A ConnectionPoint must be associated with exactly one Connectable using the relation isConnectionPointOf." ;
            sh:class ns2:Connectable ;
            sh:maxCount 1 ;
            sh:message "s223: A ConnectionPoint must be associated with exactly one Connectable using the relation isConnectionPointOf." ;
            sh:minCount 1 ;
            sh:name "ConnectionPointToEquipmentShape" ;
            sh:path ns2:isConnectionPointOf ],
        [ rdfs:comment "A ConnectionPoint can be associated with at most one other ConnectionPoint using the relation mapsTo" ;
            sh:class ns2:ConnectionPoint ;
            sh:maxCount 1 ;
            sh:message "s223: A ConnectionPoint can be associated with at most one other ConnectionPoint using the relation mapsTo" ;
            sh:path ns2:mapsTo ],
        [ rdfs:comment "A ConnectionPoint can be associated with at most one other ConnectionPoint using the inverse of relation mapsTo" ;
            sh:class ns2:ConnectionPoint ;
            sh:maxCount 1 ;
            sh:message "s223: A ConnectionPoint can be associated with at most one other ConnectionPoint using the inverse of relation mapsTo" ;
            sh:path [ sh:inversePath ns2:mapsTo ] ] .

ns2:hasBoundaryConnectionPoint a rdf:Property ;
    rdfs:label "has Boundary Connection Point" ;
    rdfs:comment "The hasBoundaryConnectionPoint relation means the ConnectionPoint represents the boundary of a s223:System (`see s223:System`) defined by the modeler, such as a model fragment provided by the vendor of a collection of equipment intended for integration with another model. The presence of this relation is used to indicate that such a \"dangling ConnectionPoint\" should not generate a validation error in a non-integrated context but should generate an error in a integrated context." .

<http://qudt.org/vocab/unit/BTU_IT> a ns1:Unit ;
    rdfs:label "British Thermal Unit (International Definition)"@en ;
    dcterms:description """$\\textit{British Thermal Unit}$ (BTU or Btu) is a traditional unit of energy equal to about $1.0550558526 \\textit{ kilojoule}$. \r
  It is approximately the amount of energy needed to heat 1 pound (0.454 kg) of water from $39^{\\circ}{F}$ to $40^{\\circ}{F}$ . \r
  The unit is most often used in the power, steam generation, heating and air conditioning industries. \r
  In scientific contexts the BTU has largely been replaced by the SI unit of energy, the $joule$, though it may be used as a measure of agricultural energy production (BTU/kg). \r
  It is still used unofficially in metric English-speaking countries (such as Canada), and remains the standard unit of classification for air conditioning units manufactured and sold in many non-English-speaking metric countries.\r
  """^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 1055.05585262 ;
    ns1:conversionMultiplierSN 1.055056e+03 ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/IMPERIAL> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Energy>,
        <http://qudt.org/vocab/quantitykind/ThermalEnergy> ;
    ns1:iec61360Code "0112/2///62720#UAA114" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/British_thermal_unit"^^xsd:anyURI,
        "http://physics.nist.gov/Pubs/SP811/appenB9.html"^^xsd:anyURI,
        "http://www.iso.org/iso/home/store/catalogue_ics/catalogue_detail_ics.htm?csnumber=31890"^^xsd:anyURI,
        "http://www.knowledgedoor.com/2/units_and_constants_handbook/british-thermal-unit_group.html"^^xsd:anyURI ;
    ns1:symbol "Btu{IT}" ;
    ns1:ucumCode "[Btu_IT]"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "BTU" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

<http://qudt.org/vocab/unit/BTU_TH> a ns1:Unit ;
    rdfs:label "British Thermal Unit (Thermochemical Definition)"@en ;
    dcterms:description """\r
  The $\\textit{British Thermal Unit (thermochemical definition)}$ ($BTU_{th}$), is a traditional unit of energy equal to about $1.0543502645 kilojoule$. \r
  It is approximately the amount of energy needed to heat 1 pound (0.454 kg) of water from $39^{\\circ}\\text{F}$ ($3.9^{\\circ}\\text{C}$) to $40^{\\circ}\\text{F}$ ($4.4^{\\circ}\\text{C}$). \r
  The unit is most often used in the power, steam generation, heating and air conditioning industries. \r
  In scientific contexts the BTU has largely been replaced by the SI unit of energy, the $joule$.\r
  """^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 1054.3502645 ;
    ns1:conversionMultiplierSN 1.05435e+03 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Energy>,
        <http://qudt.org/vocab/quantitykind/ThermalEnergy> ;
    ns1:iec61360Code "0112/2///62720#UAA122" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/British_thermal_unit"^^xsd:anyURI,
        "http://physics.nist.gov/Pubs/SP811/appenB9.html"^^xsd:anyURI,
        "http://www.iso.org/iso/home/store/catalogue_ics/catalogue_detail_ics.htm?csnumber=31890"^^xsd:anyURI,
        "http://www.knowledgedoor.com/2/units_and_constants_handbook/british-thermal-unit_group.html"^^xsd:anyURI ;
    ns1:symbol "Btu{th}" ;
    ns1:ucumCode "[Btu_th]"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .

<http://qudt.org/vocab/unit/CAL_IT> a ns1:Unit ;
    rdfs:label "International Table calorie"@en ;
    dcterms:description "International Table calorie."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
