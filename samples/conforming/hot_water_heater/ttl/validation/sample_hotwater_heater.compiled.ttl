    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/InternationalUnit> ;
    ns1:symbol "IU" ;
    ns1:ucumCode "[IU]"^^ns1:UCUMcs,
        "[iU]"^^ns1:UCUMcs ;
