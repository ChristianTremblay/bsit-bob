    rdfs:label "Rod"@en ;
    dcterms:description "A unit of distance equal to 5.5 yards (16 feet 6 inches)."^^rdf:HTML ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
