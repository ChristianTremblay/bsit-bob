        "yarılanma süresi"@tr,
        "半衰期"@zh ;
    dcterms:description "The \"Half-Life\" is the average duration required for the decay of one half of the atoms or nuclei."^^rdf:HTML ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0> ;
