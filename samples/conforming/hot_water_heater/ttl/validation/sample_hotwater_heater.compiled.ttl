    ns2:hasRole <http://data.ashrae.org/proposal-to-standard223#Role-Storage> ;
    ns4:containedFluid <urn:ex:sample_hotwater_heater/00012> ;
    ns4:enteringFluid <urn:ex:sample_hotwater_heater/00011> ;
