ex:00009 a s223:ConnectionPoint,
        s223:OutletConnectionPoint ;
    rdfs:label "F.airOutlet" ;
    s223:connectsThrough ex:00010 ;
    s223:hasDirection s223:Outlet ;
    s223:hasSubstance s223:Air ;
    s223:isConnectionPointOf ex:00007 .

ex:00010 a s223:Connection ;
    s223:connectsAt ex:00003,
        ex:00009 ;
    s223:connectsFrom ex:00007 ;
    s223:connectsTo ex:00002 ;
    s223:hasSubstance s223:Air .

ex:00011 a s223:Device,
        s223:Zone ;
    rdfs:label "Zone-1" ;
    s223:connectedThrough ex:00014 ;
    s223:hasConnectionPoint ex:00012,
