@prefix ex: <urn:ex/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4syst: <https://saref.etsi.org/> .

ex:00003 a ex:AirOutlet ;
    rdfs:label "Zone.ra" ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectionPointOf ex:00001 .

ex:00004 a s4syst:System,
        ex:VAV1 ;
    rdfs:label "Zone.VAV" ;
    s4syst:hasSubSystem ex:00005,
        ex:00009 .

ex:00006 a ex:AirInlet ;
    rdfs:label "Zone.VAV.air_flow_station.ain" ;
    s4syst:connectionPointOf ex:00005 ;
    ex:connectionPointOf ex:00005 .

ex:00008 a ex:AnalogOut ;
    rdfs:label "Zone.VAV.air_flow_station.flow" ;
    s4syst:connectionPointOf ex:00005 ;
    ex:connectionPointOf ex:00005 .

ex:00012 a ex:AnalogIn ;
    rdfs:label "Zone.VAV.damper.pos" ;
    s4syst:connectionPointOf ex:00009 ;
    ex:connectionPointOf ex:00009 .

ex:00002 a ex:AirInlet ;
    rdfs:label "Zone.sa" ;
    s4syst:connectedThrough ex:00014 ;
    s4syst:connectionPointOf ex:00001 ;
    ex:connectedThrough ex:00014 ;
    ex:connectionPointOf ex:00001 .

ex:00007 a ex:AirOutlet ;
    rdfs:label "Zone.VAV.air_flow_station.aout" ;
    s4syst:connectedThrough ex:00013 ;
    s4syst:connectionPointOf ex:00005 ;
    ex:connectedThrough ex:00013 ;
    ex:connectionPointOf ex:00005 .

ex:00010 a ex:AirInlet ;
    rdfs:label "Zone.VAV.damper.ain" ;
    s4syst:connectedThrough ex:00013 ;
    s4syst:connectionPointOf ex:00009 ;
    ex:connectedThrough ex:00013 ;
    ex:connectionPointOf ex:00009 .

ex:00011 a ex:AirOutlet ;
    rdfs:label "Zone.VAV.damper.aout" ;
    s4syst:connectedThrough ex:00014 ;
    s4syst:connectionPointOf ex:00009 ;
    ex:connectedThrough ex:00014 ;
    ex:connectionPointOf ex:00009 .

ex:00001 a s4syst:System,
        ex:Zone ;
    rdfs:label "Zone" ;
    s4syst:connectsAt ex:00002,
        ex:00003 ;
    ex:ra ex:00003 ;
    ex:sa ex:00002 .

ex:00013 a ex:AirConnection ;
    s4syst:connectsSystemAt ex:00007,
        ex:00010 .

ex:00014 a ex:AirConnection ;
    s4syst:connectsSystemAt ex:00002,
        ex:00011 .

ex:00005 a s4syst:System,
        ex:AirFlowStation ;
    rdfs:label "Zone.VAV.air_flow_station" ;
    s4syst:connectsAt ex:00006,
        ex:00007,
        ex:00008 ;
    s4syst:subSystemOf ex:00004 ;
    ex:ain ex:00006 ;
    ex:aout ex:00007 ;
    ex:flow ex:00008 .

ex:00009 a s4syst:System,
        ex:Damper ;
    rdfs:label "Zone.VAV.damper" ;
    s4syst:connectsAt ex:00010,
        ex:00011,
        ex:00012 ;
    s4syst:subSystemOf ex:00004 ;
    ex:ain ex:00010 ;
    ex:aout ex:00011 ;
    ex:pos ex:00012 .

