@prefix brick: <https://brickschema.org/schema/1.1.0/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4syst: <https://saref.etsi.org/> .

<urn:ex:00003> a s4syst:ConnectionPoint,
        <urn:ex:AirOut> ;
    rdfs:label "Zone.ra" ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00006> a s4syst:ConnectionPoint,
        <urn:ex:AirIn> ;
    rdfs:label "Zone.VAV.air_flow_station.ain" ;
    s4syst:connectionPointOf <urn:ex:00005> .

<urn:ex:00008> a s4syst:ConnectionPoint,
        <urn:ex:AnalogOut> ;
    rdfs:label "Zone.VAV.air_flow_station.flow" ;
    s4syst:connectionPointOf <urn:ex:00005> .

<urn:ex:00012> a s4syst:ConnectionPoint,
        <urn:ex:AnalogIn> ;
    rdfs:label "Zone.VAV.damper.pos" ;
    s4syst:connectionPointOf <urn:ex:00009> .

<urn:ex:00002> a s4syst:ConnectionPoint,
        <urn:ex:AirIn> ;
    rdfs:label "Zone.sa" ;
    s4syst:connectedThrough <urn:ex:00014> ;
    s4syst:connectionPointOf <urn:ex:00001> .

<urn:ex:00007> a s4syst:ConnectionPoint,
        <urn:ex:AirOut> ;
    rdfs:label "Zone.VAV.air_flow_station.aout" ;
    s4syst:connectedThrough <urn:ex:00013> ;
    s4syst:connectionPointOf <urn:ex:00005> .

<urn:ex:00010> a s4syst:ConnectionPoint,
        <urn:ex:AirIn> ;
    rdfs:label "Zone.VAV.damper.ain" ;
    s4syst:connectedThrough <urn:ex:00013> ;
    s4syst:connectionPointOf <urn:ex:00009> .

<urn:ex:00011> a s4syst:ConnectionPoint,
        <urn:ex:AirOut> ;
    rdfs:label "Zone.VAV.damper.aout" ;
    s4syst:connectedThrough <urn:ex:00014> ;
    s4syst:connectionPointOf <urn:ex:00009> .

<urn:ex:00013> a s4syst:Connection,
        <urn:ex:AirConnection> ;
    s4syst:connectsSystemAt <urn:ex:00007>,
        <urn:ex:00010> .

<urn:ex:00014> a s4syst:Connection,
        <urn:ex:AirConnection> ;
    s4syst:connectsSystemAt <urn:ex:00002>,
        <urn:ex:00011> .

<urn:ex:00001> a brick:HVAC_Zone,
        s4syst:System,
        <urn:ex:Zone> ;
    rdfs:label "Zone" ;
    s4syst:connectsAt <urn:ex:00002>,
        <urn:ex:00003> .

<urn:ex:00004> a brick:VAV,
        s4syst:System,
        <urn:ex:VAV1> ;
    rdfs:label "Zone.VAV" ;
    brick:feeds <urn:ex:00001> ;
    brick:hasPart <urn:ex:00005>,
        <urn:ex:00009> ;
    s4syst:hasSubSystem <urn:ex:00005>,
        <urn:ex:00009> .

<urn:ex:00005> a s4syst:System,
        <urn:ex:AirFlowStation> ;
    rdfs:label "Zone.VAV.air_flow_station" ;
    brick:isPartOf <urn:ex:00004> ;
    s4syst:connectsAt <urn:ex:00006>,
        <urn:ex:00007>,
        <urn:ex:00008> ;
    s4syst:subSystemOf <urn:ex:00004> .

<urn:ex:00009> a brick:Damper,
        s4syst:System,
        <urn:ex:Damper> ;
    rdfs:label "Zone.VAV.damper" ;
    brick:isPartOf <urn:ex:00004> ;
    s4syst:connectsAt <urn:ex:00010>,
        <urn:ex:00011>,
        <urn:ex:00012> ;
    s4syst:subSystemOf <urn:ex:00004> .

