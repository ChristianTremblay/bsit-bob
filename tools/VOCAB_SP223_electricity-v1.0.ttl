s223:Dimensioned-Voltage a s223:Class,
        s223:Dimensioned-Voltage,
        sh:NodeShape ;
    rdfs:label "Dimensioned Voltage" ;
    rdfs:subClassOf s223:Context-Dimensioned ;
    sh:property [ rdfs:comment "A Dimensioned-Voltage must have a unit" ;
            sh:class qudt:Unit ;
            sh:minCount 1 ;
            sh:path s223:hasUnit ],
        [ rdfs:comment "A Dimensioned-Voltage must have a value" ;
            sh:class rdf:value ;
            sh:minCount 1 ;
            sh:path s223:hasValue ],
        [ rdfs:comment "A Dimensioned-Voltage  must have a Quantity Kind" ;
            sh:class qudt:hasQuantityKind ;
            sh:minCount 1 ;
            sh:path qudt:hasQuantityKind ] .

