@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix psm: <http://data.ashrae.org/standard223/1.0/data/pd-sr-mp-pritoni#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/pd-sr-mp-pritoni> a owl:Ontology ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
    owl:versionInfo "Created with TopBraid Composer" .

psm:BathroomExhaustFan a s223:Fan ;
    rdfs:label "Bathroom exhaust fan" ;
    s223:hasConnectionPoint psm:FanInletConnectionPoint,
        psm:FanOutletConnectionPoint ;
    s223:hasProperty psm:ExhaustFanStatus ;
    s223:hasRole s223:Role-Exhaust .

psm:BreakerPanel1 a s223:ElectricPanel ;
    rdfs:label "Breaker panel1" ;
    s223:contains psm:ElectricBreaker1,
        psm:ElectricBreaker2,
        psm:ElectricBreaker3,
        psm:ElectricBreaker4,
        psm:ElectricBreaker5 ;
    s223:hasSystemConnectionPoint psm:BreakerPanelInletSystemConnectionPoint .

psm:DaylightSensor1 a s223:LightSensor ;
    rdfs:label "DaylightSensor1" ;
    s223:hasMeasurementLocation psm:LightingSpace1 ;
    s223:hasMedium s223:Light-Visible ;
    s223:hasPhysicalLocation psm:OpenOffice .

psm:Floor1 a s223:PhysicalSpace ;
    rdfs:label "Floor1" ;
    s223:contains psm:Bathroom,
        psm:Corridor,
        psm:Kitchenette,
        psm:OpenOffice,
        psm:PrivateOffice .

psm:FlowSensor1 a s223:FlowSensor ;
    rdfs:label "Return air flow sensor" ;
    s223:hasMeasurementLocation psm:i00052 ;
    s223:observesProperty psm:ReturnAirFlowRate .

psm:HVACZone1Thermostat a s223:TemperatureSensor ;
    rdfs:label "HVAC Zone1 thermostat" ;
    s223:hasMeasurementLocation psm:HVACSpace1 ;
    s223:hasPhysicalLocation psm:OpenOffice ;
    s223:observesProperty psm:HVACZone1Temperature .

psm:HVACZone2Thermostat a s223:TemperatureSensor ;
    rdfs:label "HVACZone2Thermostat" ;
    s223:hasMeasurementLocation psm:HVACSpace5 ;
    s223:hasPhysicalLocation psm:Corridor ;
    s223:observesProperty psm:HVACZone2Temperature .

psm:KitchenetteLightingSystem a s223:System ;
    rdfs:label "Kitchenette lighting system" ;
    s223:contains psm:Luminaire11,
        psm:Luminaire12,
        psm:OccSensor5 ;
    s223:servesZone psm:LightingZone6 .

psm:LightingZone1 a s223:Zone ;
    rdfs:label "LightingZone1" ;
    s223:contains psm:LightingSpace1 ;
    s223:hasDomain s223:Domain-Lighting .

psm:LightingZone2 a s223:Zone ;
    rdfs:label "LightingZone2" ;
    s223:contains psm:LightingSpace2 ;
    s223:hasDomain s223:Domain-Lighting .

psm:LightingZone3 a s223:Zone ;
    rdfs:label "LightingZone3" ;
    s223:contains psm:LightingSpace3 ;
    s223:hasDomain s223:Domain-Lighting .

psm:LightingZone4 a s223:Zone ;
    rdfs:label "LightingZone4" ;
    s223:contains psm:LightingSpace4 ;
    s223:hasDomain s223:Domain-Lighting .

psm:LightingZone5 a s223:Zone ;
    rdfs:label "LightingZone5" ;
    s223:contains psm:LightingSpace5 ;
    s223:hasDomain s223:Domain-Lighting .

psm:Luminaire1 a s223:Luminaire ;
    rdfs:label "Luminaire1" ;
    s223:hasConnectionPoint psm:Luminaire1Inlet,
        psm:Luminaire1Outlet ;
    s223:hasProperty psm:Luminaire1DimmerStatus,
        psm:Luminaire1OnOffStatus .

psm:Luminaire10 a s223:Luminaire ;
    rdfs:label "Luminaire10" ;
    s223:hasConnectionPoint psm:Luminaire10Inlet,
        psm:Luminaire10Outlet ;
    s223:hasProperty psm:Luminaire10OnOffStatus .

psm:Luminaire2 a s223:Luminaire ;
    rdfs:label "Luminaire2" ;
    s223:hasConnectionPoint psm:Luminaire2Inlet,
        psm:Luminaire2Outlet ;
    s223:hasProperty psm:Luminaire2OnOffStatus .

psm:Luminaire3 a s223:Luminaire ;
    rdfs:label "Luminaire3" ;
    s223:hasConnectionPoint psm:Luminaire3Inlet,
        psm:Luminaire3Outlet ;
    s223:hasProperty psm:Luminaire3OnOffStatus .

psm:Luminaire4 a s223:Luminaire ;
    rdfs:label "Luminaire4" ;
    s223:hasConnectionPoint psm:Luminaire4Inlet,
        psm:Luminaire4Outlet ;
    s223:hasProperty psm:Luminaire4OnOffStatus .

psm:Luminaire5 a s223:Luminaire ;
    rdfs:label "Luminaire5" ;
    s223:hasConnectionPoint psm:Luminaire5Inlet,
        psm:Luminaire5Outlet ;
    s223:hasProperty psm:Luminaire5OnOffStatus .

psm:Luminaire6 a s223:Luminaire ;
    rdfs:label "Luminaire6" ;
    s223:hasConnectionPoint psm:Luminaire6Inlet,
        psm:Luminaire6Outlet ;
    s223:hasProperty psm:Luminaire6OnOffStatus .

psm:Luminaire7 a s223:Luminaire ;
    rdfs:label "Luminaire7" ;
    s223:hasConnectionPoint psm:Luminaire7Inlet,
        psm:Luminaire7Outlet ;
    s223:hasProperty psm:Luminaire7OnOffStatus .

psm:Luminaire8 a s223:Luminaire ;
    rdfs:label "Luminaire8" ;
    s223:hasConnectionPoint psm:Luminaire8Inlet,
        psm:Luminaire8Outlet ;
    s223:hasProperty psm:Luminaire8OnOffStatus .

psm:Luminaire9 a s223:Luminaire ;
    rdfs:label "Luminaire9" ;
    s223:hasConnectionPoint psm:Luminaire9Inlet,
        psm:Luminaire9Outlet ;
    s223:hasProperty psm:Luminaire9OnOffStatus .

psm:OccSensor1 a s223:OccupancySensor ;
    rdfs:label "OccSensor1" ;
    s223:hasMeasurementLocation psm:OccupancySpace1 ;
    s223:hasPhysicalLocation psm:OpenOffice ;
    s223:observesProperty psm:OccupancyProp1 .

psm:OccSensor2 a s223:OccupancySensor ;
    rdfs:label "OccSensor2" ;
    s223:hasMeasurementLocation psm:OccupancySpace2 ;
    s223:hasPhysicalLocation psm:Bathroom ;
    s223:observesProperty psm:OccupancyProp2 .

psm:OccSensor3 a s223:OccupancySensor ;
    rdfs:label "OccSensor3" ;
    s223:hasMeasurementLocation psm:OccupancySpace3 ;
    s223:observesProperty psm:OccupancyProp3 .

psm:OccSensor4 a s223:OccupancySensor ;
    rdfs:label "OccSensor4" ;
    s223:hasMeasurementLocation psm:OccupancySpace4 ;
    s223:observesProperty psm:OccupancyProp4 .

psm:OpeningCB a s223:Connection ;
    rdfs:label "Opening CB" ;
    s223:cnx psm:BathroomInletConnectionPoint,
        psm:CorridorOutletConnectionPointB ;
    s223:hasMedium s223:Medium-Air .

psm:OpeningCOO a s223:Connection ;
    rdfs:label "Opening COO" ;
    s223:cnx psm:CorridorOutletConnectionPointOO,
        psm:OpenOfficeInletConnectionPoint ;
    s223:hasMedium s223:Medium-Air .

psm:OpeningKC a s223:Connection ;
    rdfs:label "Opening KC" ;
    s223:cnx psm:CorridorInletConnectionPointK,
        psm:KitchenetteOutletConnectionPoint ;
    s223:hasMedium s223:Medium-Air .

psm:OpeningPOC a s223:Connection ;
    rdfs:label "Opening POC" ;
    s223:cnx psm:CorridorInletConnectionPointPO,
        psm:PrivateOfficeOutletConnectionPoint ;
    s223:hasMedium s223:Medium-Air .

psm:PipeFromBoiler a s223:Pipe ;
    rdfs:label "Pipe from boiler" ;
    s223:cnx psm:i00032 ;
    s223:hasMedium s223:Water-HotWater .

psm:TempSensor_1 a s223:TemperatureSensor ;
    rdfs:label "Temp sensor 1" ;
    s223:hasMeasurementLocation psm:i00050 .

psm:TempSensor_2 a s223:TemperatureSensor ;
    rdfs:label "Temp sensor 2" ;
    s223:hasMeasurementLocation psm:i00046 .

psm:VAV1InternalConnection a s223:Connection ;
    rdfs:label "VAV1Internal connection" ;
    s223:cnx psm:VAV1DamperOutletCP,
        psm:VAV1InletReheatCoilCP ;
    s223:hasMedium s223:Medium-Air .

psm:VAV2InternalConnection a s223:Connection ;
    rdfs:label "VAV2Internal connection" ;
    s223:cnx psm:VAV2DamperOutletCP,
        psm:VAV2InletReheatCoilCP ;
    s223:hasMedium s223:Medium-Air .

psm:VAV2OutletTemperature a s223:QuantifiableObservableProperty ;
    rdfs:label "VAV2 Outlet Temperature" ;
    s223:hasValue 71.2 ;
    qudt:hasQuantityKind qudtqk:Temperature ;
    qudt:unit unit:DEG_F .

psm:VAVBox1System a s223:VAV ;
    rdfs:label "VAVBox1System" ;
    s223:contains psm:VAVBox1HeatingCoil,
        psm:VAVBox1InletTemperatureSensor,
        psm:VAVBox1MotorizedDamper,
        psm:VAVBox1OutletFlowSensor,
        psm:VAVBox1OutletTemperatureSensor ;
    s223:servesZone psm:HVACZone1 .

psm:VAVBox2System a s223:VAV ;
    rdfs:label "VAVBox2System" ;
    s223:contains psm:VAVBox2HeatingCoil,
        psm:VAVBox2InletTemperatureSensor,
        psm:VAVBox2MotorizedDamper,
        psm:VAVBox2OutletFlowSensor,
        psm:VAVBox2OutletTemperatureSensor ;
    s223:servesZone psm:HVACZone2 .

psm:i00001 a s223:AHU ;
    rdfs:label "A-9" ;
    s223:contains psm:ReturnSystem,
        psm:SupplySystem .

psm:i00070 a s223:Duct ;
    rdfs:label "Supply Air Duct" ;
    s223:hasMedium s223:Medium-Air ;
    s223:hasProperty psm:satmp .

psm:masen a s223:Sensor ;
    rdfs:label "Mixed Air Sensor" ;
    s223:observesProperty psm:mxtmp .

psm:oasen a s223:TemperatureSensor ;
    rdfs:label "Outside Air Sensor" ;
    s223:hasMeasurementLocation psm:i00013 ;
    s223:observesProperty psm:oatmp .

psm:rasen a s223:TemperatureSensor ;
    rdfs:label "Return Air Sensor" ;
    s223:hasMeasurementLocation psm:i00052 ;
    s223:observesProperty psm:ratmp .

psm:sasen a s223:TemperatureSensor ;
    rdfs:label "Supply Air Sensor" ;
    s223:hasMeasurementLocation psm:i00049 ;
    s223:observesProperty psm:satmp .

