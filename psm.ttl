        psm:BR5OutletConnectionPoint .

psm:ExhaustFanStatus a s223:EnumeratedActuatableProperty ;
    rdfs:label "Exhaust fan status" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:hasValue s223:OnOff-On .

psm:FanInletConnectionPoint a s223:InletConnectionPoint ;
    rdfs:label "Fan inlet connection point" ;
    s223:cnx psm:BathroomExhaustDuct ;
    s223:hasMedium s223:Medium-Air .

psm:FanOutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "Fan outlet connection point" ;
    s223:cnx psm:OutsideAir ;
    s223:hasMedium s223:Medium-Air .

psm:HVAC4-5Connection a s223:Connection ;
    rdfs:label "HVAC4-5Connection" ;
    s223:cnx psm:InletIntraCorridor4CP ;
    s223:hasMedium s223:Medium-Air .

psm:HVACZone1 a s223:Zone ;
    rdfs:label "HVACZone1" ;
    s223:contains psm:HVACSpace1,
        psm:HVACSpace2,
        psm:HVACSpace3,
        psm:HVACSpace4 ;
    s223:hasDomain s223:Domain-HVAC .

psm:HVACZone1Temperature a s223:QuantifiableObservableProperty ;
    rdfs:label "HVACZone1Temperature" ;
    s223:hasValue 69.7 ;
    qudt:hasQuantityKind qudtqk:Temperature ;
    qudt:unit unit:DEG_F .

psm:HVACZone2 a s223:Zone ;
    rdfs:label "HVACZone2" ;
    s223:contains psm:HVACSpace5,
        psm:HVACSpace6 ;
    s223:hasDomain s223:Domain-HVAC .

psm:HVACZone2Temperature a s223:QuantifiableObservableProperty ;
    rdfs:label "HVACZone2Temperature" ;
    s223:hasValue 73.2 ;
    qudt:unit unit:DEG_F .

psm:InletIntraCorridor4CP a s223:InletConnectionPoint ;
    rdfs:label "Inlet intra corridor4CP" ;
    s223:hasMedium s223:Medium-Air ;
    s223:isConnectionPointOf psm:HVACSpace4 .

psm:KitchenetteLight1 a s223:Connection ;
    rdfs:label "Kitchenette light1" ;
    s223:cnx psm:KitchenetteLightInletCP,
        psm:Luminaire11Outlet ;
    s223:hasMedium s223:Light-Visible .

psm:LIghtingSpace1DLInlet a s223:InletConnectionPoint ;
    rdfs:label "Lighting Space1 DL Inlet" ;
    s223:cnx psm:DLightPath1 ;
    s223:hasMedium s223:Light-Visible .

psm:LightingZone6 a s223:Zone ;
    rdfs:label "LightingZone6" ;
    s223:contains psm:LightingSpace6 ;
    s223:hasDomain s223:Domain-Lighting .

psm:Luminaire10Inlet a s223:InletConnectionPoint ;
    rdfs:label "Luminaire10Inlet" ;
    s223:cnx psm:ElectricCircuit2 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:Luminaire10OnOffStatus a s223:EnumerableProperty ;
    rdfs:label "Luminaire10On off status" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:hasValue s223:OnOff-Off .

psm:Luminaire10Outlet a s223:OutletConnectionPoint ;
    rdfs:label "Luminaire10Outlet" ;
    s223:cnx psm:CorridorLight1 ;
    s223:hasMedium s223:Light-Visible .

psm:Luminaire11 a s223:Luminaire ;
    rdfs:label "Luminaire11" ;
    s223:hasConnectionPoint psm:Luminaire11Inlet,
        psm:Luminaire11Outlet ;
    s223:hasPhysicalLocation psm:Kitchenette ;
    s223:hasProperty psm:Luminaire11OnOffStatus .

psm:Luminaire11Inlet a s223:InletConnectionPoint ;
    rdfs:label "Luminaire11Inlet" ;
    s223:cnx psm:ElectricCircuit2 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:Luminaire11OnOffStatus a s223:EnumerableProperty ;
    rdfs:label "Luminaire11On off status" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:hasValue s223:OnOff-Off .

psm:Luminaire12 a s223:Luminaire ;
    rdfs:label "Luminaire12" ;
    s223:hasConnectionPoint psm:Luminaire12Inlet,
        psm:Luminaire12Outlet ;
    s223:hasPhysicalLocation psm:Kitchenette ;
    s223:hasProperty psm:Luminaire12OnOffStatus .

psm:Luminaire12Inlet a s223:InletConnectionPoint ;
    rdfs:label "Luminaire12Inlet" ;
    s223:cnx psm:ElectricCircuit2 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:Luminaire12OnOffStatus a s223:EnumerableProperty ;
    rdfs:label "Luminaire12On off status" ;
    s223:hasEnumerationKind s223:EnumerationKind-OnOff ;
    s223:hasValue s223:OnOff-Off .

psm:Luminaire12Outlet a s223:OutletConnectionPoint ;
    rdfs:label "Luminaire12Outlet" ;
    s223:cnx psm:KitchenetteLight1 ;
    s223:hasMedium s223:Light-Visible .

psm:Luminaire1DimmerStatus a s223:QuantifiableProperty ;
