psm:Luminaire1Inlet a s223:InletConnectionPoint ;
    rdfs:label "Luminaire1Inlet" ;
    s223:cnx psm:ElectricCircuit1 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:Luminaire1OnOffStatus a s223:EnumerableProperty ;
