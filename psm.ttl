psm:Luminaire1Outlet a s223:OutletConnectionPoint ;
    rdfs:label "Luminaire1Outlet" ;
    s223:cnx psm:ELightPath1 ;
    s223:hasMedium s223:Light-Visible .

psm:Luminaire2Inlet a s223:InletConnectionPoint ;
    rdfs:label "Luminaire2Inlet" ;
    s223:cnx psm:ElectricCircuit1 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:Luminaire2OnOffStatus a s223:EnumerableProperty ;
