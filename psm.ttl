psm:BPInletSegment1 a s223:Segment ;
    rdfs:label "BPInlet segment1" ;
    s223:lnx psm:BR1InletConnectionPoint .

psm:BPInletSegment2 a s223:Segment ;
    rdfs:label "BPInlet segment2" ;
    s223:lnx psm:BR2InletConnectionPoint .

psm:BPInletSegment3 a s223:Segment ;
    rdfs:label "BPInlet segment3" ;
    s223:lnx psm:BR3InletConnectionPoint .

psm:BPInletSegment4 a s223:Segment ;
    rdfs:label "BPInlet segment4" ;
    s223:lnx psm:BR4InletConnectionPoint .

psm:BPInletSegment5 a s223:Segment ;
    rdfs:label "BPInlet segment5" ;
    s223:lnx psm:BR5InletConnectionPoint .

psm:BPJunction1 a s223:Junction ;
    rdfs:label "BPJunction1" ;
    s223:lnx psm:BPInletSegment1,
        psm:BPInletSegment2,
        psm:BPInletSegment3,
        psm:BPInletSegment4,
        psm:BPInletSegment5 .

psm:BR1OutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "BR1Outlet connection point" ;
    s223:cnx psm:ElectricCircuit1 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:BR2OutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "BR2Outlet connection point" ;
    s223:cnx psm:ElectricCircuit2 ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:BR3OutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "BR3Outlet connection point" ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:BR4OutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "BR4Outlet connection point" ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:BR5OutletConnectionPoint a s223:OutletConnectionPoint ;
    rdfs:label "BR5Outlet connection point" ;
    s223:hasMedium s223:Electricity-120V-60Hz .

psm:BathroomExhaustDuct a s223:Duct ;
    rdfs:label "Bathroom exhaust duct" ;
    s223:cnx psm:BathroomOutletConnectionPoint ;
    s223:hasMedium s223:Medium-Air .

psm:BreakerPanelInletSystemConnectionPoint a s223:InletSystemConnectionPoint ;
    rdfs:label "Breaker panel inlet system connection point" ;
    s223:mapsTo psm:BPJunction1 .

psm:CorridorLightInletCP a s223:InletConnectionPoint ;
    rdfs:label "Corridor light inlet CP" ;
    s223:cnx psm:CorridorLight1 ;
    s223:hasMedium s223:Light-Visible .

psm:DLightPath1 a s223:Connection ;
    rdfs:label "DLight Path1" ;
    s223:hasMedium s223:Light-Visible .

psm:ElectricBreaker1 a s223:ElectricBreaker ;
    rdfs:label "Electric breaker1" ;
    s223:hasConnectionPoint psm:BR1InletConnectionPoint,
        psm:BR1OutletConnectionPoint .

psm:ElectricBreaker2 a s223:ElectricBreaker ;
    rdfs:label "Electric breaker2" ;
    s223:hasConnectionPoint psm:BR2InletConnectionPoint,
        psm:BR2OutletConnectionPoint .

psm:ElectricBreaker3 a s223:ElectricBreaker ;
    rdfs:label "Electric breaker3" ;
    s223:hasConnectionPoint psm:BR3InletConnectionPoint,
        psm:BR3OutletConnectionPoint .

psm:ElectricBreaker4 a s223:ElectricBreaker ;
